<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             x:Class="AmneziaGeo.Ui.Controls.CardTags"
             x:CompileBindings="True"
             ClipToBounds="True">
  <!-- Плашки режимов карточки: включённый режим носит цвет действия, выключенный уходит в серое. Ряд
       выкладывается по порядку, хвост за краем отсекается. -->
  <ItemsControl x:Name="Strip" ItemsSource="{Binding $parent[controls:CardTags].Tags}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <controls:TagStrip Spacing="6" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:CardTag">
        <Button Classes="cardtagbtn" Command="{Binding Command}" IsHitTestVisible="{Binding Interactive}"
                ToolTip.Tip="{Binding Hint}">
          <Border Classes="cardchip cardtag" Classes.off="{Binding !On}" Classes.bad="{Binding Bad}"
                  Classes.busy="{Binding Busy}">
            <TextBlock Text="{Binding Text}" FontSize="11.5" FontWeight="SemiBold" />
          </Border>
        </Button>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
