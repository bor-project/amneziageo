<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             x:Class="AmneziaGeo.Ui.Views.ConnectionsView"
             x:CompileBindings="True"
             x:DataType="vm:ConnectionsViewModel">
  <UserControl.Resources>
     <StreamGeometry x:Key="AgCopyGeometry">M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z</StreamGeometry>
     <StreamGeometry x:Key="AgEyeGeometry">M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z</StreamGeometry>
     <StreamGeometry x:Key="AgEyeOffGeometry">M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z</StreamGeometry>
     <StreamGeometry x:Key="AgCloseGeometry">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
  </UserControl.Resources>

  <StackPanel Spacing="14">
    <TextBlock Classes="section" Text="{l:Tr General_ProxySection}" />

    <!-- One frame around the whole block; below the card width it goes and the hairlines carry the boundaries. -->
    <Border Classes="sect">
      <StackPanel Spacing="12">

        <!-- One tab per subject: the tunnel itself, then each way out of this machine. A tab whose
             caption is empty is not offered on this platform. -->
        <controls:SegmentedSelector IsVisible="{Binding HasConnectionTabs}"
            Command="{Binding SelectShareTabCommand}"
            IsCompact="{Binding IsCompact}"
            Item1Text="{Binding TunnelTabText}" Item1Param="tunnel" Item1Active="{Binding IsTunnelTab}"
            Item2Text="{l:Tr General_ShareTabProxy}" Item2Param="proxy" Item2Active="{Binding IsProxyTab}"
            Item3Text="{l:Tr General_ShareTabWifi}" Item3Param="wifi" Item3Active="{Binding IsWifiTab}" />

        <!-- Tunnel: what the agent does with the connection itself (#196, #199). -->
        <StackPanel Spacing="12" IsVisible="{Binding IsTunnelTab}">
          <controls:SettingSwitchRow Label="{l:Tr General_ShowNotifications}"
                                     Description="{l:Tr General_ShowNotificationsHint}"
                                     IsChecked="{Binding ShowNotifications, Mode=TwoWay}" />

          <controls:SettingSwitchRow Label="{l:Tr General_SurviveReboot}"
                                     Description="{l:Tr General_SurviveRebootHint}"
                                     IsChecked="{Binding SurviveReboot, Mode=TwoWay}" />

          <controls:SettingSwitchRow Label="{l:Tr General_PeriodicReconnect}"
                                     Description="{l:Tr General_PeriodicReconnectHint}"
                                     IsChecked="{Binding PeriodicReconnect, Mode=TwoWay}" />

          <!-- The interval keeps its own line under the label: the number alone does not say what repeats. -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"
                IsEnabled="{Binding PeriodicReconnectIntervalEnabled}">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{l:Tr General_ReconnectInterval}" FontSize="13.5" TextWrapping="Wrap" />
              <TextBlock Text="{l:Tr General_ReconnectIntervalHint}" Classes="muted" FontSize="11.5"
                         TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBox Classes="field" Width="92" VerticalAlignment="Center"
                       controls:NumericInput.Minimum="1" controls:NumericInput.Maximum="86400"
                       Text="{Binding ReconnectIntervalSeconds, Mode=TwoWay}" />
              <TextBlock Text="{l:Tr General_Seconds}" Classes="muted" FontSize="12.5" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- Proxy: the address a device on the network this machine is already in is pointed at. -->
        <StackPanel Spacing="12" IsVisible="{Binding IsProxyTab}">
          <StackPanel Spacing="4">
            <controls:SettingSwitchRow Label="{l:Tr General_ProxyEnabled}" Description="{l:Tr General_ProxyEnabledHint}"
                                       IsChecked="{Binding ProxyEnabled, Mode=TwoWay}" />
            <TextBlock Text="{l:Tr General_ProxyTunnelHint}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"
                       IsVisible="{Binding ProxyNeedsTunnel}" />
          </StackPanel>

          <TextBlock Text="{Binding ProxyErrorText}" Classes="mono" FontSize="12.5" TextWrapping="Wrap"
                     Foreground="{DynamicResource AgWarnBrush}"
                     IsVisible="{Binding ProxyErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <StackPanel Spacing="12" IsVisible="{Binding ProxyEnabled}">
            <!-- Every address a client can be pointed at, each one copyable; the tunnel's own address is not
                 among them - a neighbour told to use it reaches nobody. -->
            <ItemsControl ItemsSource="{Binding ProxyEndpoints}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProxyEndpointRow">
                  <Grid ColumnDefinitions="62,*,Auto" Margin="0,1">
                    <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="muted" FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="12.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Classes="icon" VerticalAlignment="Center"
                            Click="OnCopyProxyEndpoint" ToolTip.Tip="{l:Tr General_ProxyCopyTooltip}">
                      <PathIcon Data="{StaticResource AgCopyGeometry}" Width="13" Height="13" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Each port box stands under its label, left-aligned. -->
            <StackPanel Spacing="6">
              <TextBlock Text="{l:Tr General_ProxySocksPort}" FontSize="13.5" />
              <TextBox Classes="field" Width="110" HorizontalAlignment="Left"
                       Text="{Binding ProxySocksPort, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="{l:Tr General_ProxyHttpPort}" FontSize="13.5" />
              <TextBox Classes="field" Width="110" HorizontalAlignment="Left"
                       Text="{Binding ProxyHttpPort, Mode=TwoWay}" />
            </StackPanel>

            <!-- Clients: the count first, and who holds them under the arrow. -->
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="Auto,Auto,*">
                <TextBlock Grid.Column="0" Text="{l:Tr General_ProxyClients}" FontSize="13.5" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{DynamicResource AgInsetBrush}" CornerRadius="20"
                        Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ProxyClientCount}" FontSize="11" Classes="muted" FontWeight="SemiBold" />
                </Border>
                <Button Grid.Column="2" Classes="icon" HorizontalAlignment="Left" Margin="2,0,0,0"
                        VerticalAlignment="Center" IsVisible="{Binding HasProxyClients}"
                        Command="{Binding ToggleProxyClientsCommand}" ToolTip.Tip="{l:Tr General_ProxyClientsTooltip}">
                  <TextBlock Text="{Binding ProxyClientsGlyph}" RenderTransform="scale(1.5)" />
                </Button>
              </Grid>
              <TextBlock Text="{l:Tr General_ProxyNoClients}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding !HasProxyClients}" />
              <Border IsVisible="{Binding IsProxyClientsExpanded}" Padding="10,7"
                      Background="{DynamicResource AgInsetBrush}" BorderBrush="{DynamicResource AgBorderBrush}"
                      BorderThickness="1" CornerRadius="8">
                <ItemsControl ItemsSource="{Binding ProxyClients}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProxyClientRow">
                      <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                        <TextBlock Grid.Column="0" Text="{Binding Address}" Classes="mono" FontSize="12.5"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Detail}" Classes="muted" FontSize="12"
                                   Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>

            <!-- Who is let in: the accounts below, and on top of them a client without one where it is allowed. -->
            <controls:SettingSwitchRow Label="{l:Tr General_ProxyAnonymous}"
                                       Description="{l:Tr General_ProxyAnonymousHint}"
                                       IsChecked="{Binding ProxyAnonymous, Mode=TwoWay}" />

            <TextBlock Text="{l:Tr General_ProxyOpenWarning}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource AgWarnBrush}" IsVisible="{Binding ProxyAnonymous}" />
            <TextBlock Text="{l:Tr General_ProxyNoAccountWarning}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource AgWarnBrush}" IsVisible="{Binding ProxyAdmitsNobody}" />

            <!-- Accounts: a client sends one of these pairs, and the password shows only when it is asked for. -->
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{l:Tr General_ProxyAccounts}" FontSize="13.5" />
                  <TextBlock Text="{l:Tr General_ProxyAuthHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="softbtn" VerticalAlignment="Center"
                        Command="{Binding AddProxyAccountCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="+" />
                    <TextBlock Text="{l:Tr Main_AddButton}" />
                  </StackPanel>
                </Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding ProxyAccounts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProxyAccountViewModel">
                    <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="6" Margin="0,2">
                      <TextBox Grid.Column="0" Classes="field" Text="{Binding User, Mode=TwoWay}"
                               Watermark="{l:Tr General_ProxyUser}" />
                      <TextBox Grid.Column="1" Classes="field" Text="{Binding Password, Mode=TwoWay}"
                               PasswordChar="●" RevealPassword="{Binding IsRevealed}"
                               Watermark="{l:Tr General_ProxyPassword}" />
                      <Button Grid.Column="2" Classes="icon" VerticalAlignment="Center"
                              Command="{Binding ToggleRevealCommand}" ToolTip.Tip="{l:Tr General_ProxyRevealTooltip}">
                        <Panel>
                          <PathIcon Data="{StaticResource AgEyeGeometry}" Width="14" Height="14"
                                    IsVisible="{Binding !IsRevealed}" />
                          <PathIcon Data="{StaticResource AgEyeOffGeometry}" Width="14" Height="14"
                                    IsVisible="{Binding IsRevealed}" />
                        </Panel>
                      </Button>
                      <Button Grid.Column="3" Classes="icon" VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:ConnectionsViewModel)DataContext).RemoveProxyAccountCommand}"
                              CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource AgCloseGeometry}" Width="14" Height="14" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Own access point: the network a device joins without being set up at all. -->
        <StackPanel Spacing="12" IsVisible="{Binding IsWifiTab}">
          <controls:SettingSwitchRow Label="{l:Tr General_HotspotEnabled}"
                                     Description="{l:Tr General_HotspotEnabledHint}"
                                     IsChecked="{Binding HotspotEnabled, Mode=TwoWay}"
                                     IsEnabled="{Binding HotspotSupported}" />

          <TextBlock Text="{Binding HotspotBlockedText}" FontSize="12.5" TextWrapping="Wrap"
                     Foreground="{DynamicResource AgWarnBrush}" IsVisible="{Binding HotspotBlocked}" />

          <StackPanel Spacing="12" IsVisible="{Binding HotspotEnabled}" IsEnabled="{Binding HotspotSupported}">
            <StackPanel Spacing="6">
              <TextBlock Text="{l:Tr General_HotspotSsid}" FontSize="13.5" />
              <TextBox Classes="field" MaxLength="32" Text="{Binding HotspotSsid, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="{l:Tr General_HotspotPassword}" FontSize="13.5" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" Classes="field" MaxLength="63" PasswordChar="●"
                         RevealPassword="{Binding IsHotspotPasswordRevealed}"
                         Text="{Binding HotspotPassword, Mode=TwoWay}" />
                <Button Grid.Column="1" Classes="icon" VerticalAlignment="Center"
                        Command="{Binding ToggleHotspotRevealCommand}" ToolTip.Tip="{l:Tr General_HotspotRevealTooltip}">
                  <Panel>
                    <PathIcon Data="{StaticResource AgEyeGeometry}" Width="14" Height="14"
                              IsVisible="{Binding !IsHotspotPasswordRevealed}" />
                    <PathIcon Data="{StaticResource AgEyeOffGeometry}" Width="14" Height="14"
                              IsVisible="{Binding IsHotspotPasswordRevealed}" />
                  </Panel>
                </Button>
              </Grid>
            </StackPanel>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Grid.Column="0" Text="{l:Tr General_HotspotBand}" FontSize="13.5" VerticalAlignment="Center" />
              <controls:AdaptiveComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        ItemsSource="{Binding BandOptions}"
                        SelectedIndex="{Binding SelectedBandIndex, Mode=TwoWay}" />
            </Grid>

            <TextBlock Text="{Binding HotspotHintText}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding HotspotHintText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock Text="{Binding HotspotErrorText}" Classes="mono" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource AgWarnBrush}"
                       IsVisible="{Binding HotspotErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Grid ColumnDefinitions="Auto,Auto,*" IsVisible="{Binding HotspotRunning}">
              <TextBlock Grid.Column="0" Text="{l:Tr General_HotspotClients}" FontSize="13.5" VerticalAlignment="Center" />
              <Border Grid.Column="1" Background="{DynamicResource AgInsetBrush}" CornerRadius="20"
                      Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding HotspotClientsText}" FontSize="11" Classes="muted" FontWeight="SemiBold" />
              </Border>
            </Grid>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
