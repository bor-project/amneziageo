<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:views="clr-namespace:AmneziaGeo.Ui.Views"
             xmlns:svc="clr-namespace:AmneziaGeo.Ui.Services"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             xmlns:sys="using:System"
             x:Class="AmneziaGeo.Ui.Views.RoutingView"
             x:CompileBindings="True"
             x:DataType="vm:RoutingViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="AgPlusGeometry">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
    <StreamGeometry x:Key="AgCopyGeometry">M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z</StreamGeometry>
    <StreamGeometry x:Key="AgDownloadGeometry">M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z</StreamGeometry>
    <StreamGeometry x:Key="AgMethodPresetGeometry">M3,5H9V11H3V5M5,7V9H7V7H5M11,7H21V9H11V7M11,15H21V17H11V15M5,20L1.5,16.5L2.91,15.09L5,17.17L9.59,12.59L11,14L5,20Z</StreamGeometry>
    <StreamGeometry x:Key="AgMethodManualGeometry">M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z</StreamGeometry>
    <StreamGeometry x:Key="AgShareGeometry">M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.34C15.11,18.55 15.08,18.77 15.08,19C15.08,20.61 16.39,21.91 18,21.91C19.61,21.91 20.92,20.61 20.92,19A2.92,2.92 0 0,0 18,16.08Z</StreamGeometry>
  </UserControl.Resources>
  <!-- Cards stretch the full pane width. -->
  <!-- Брошенный на раздел файл добавляется в каталог: берутся только списки маршрутизации. -->
  <Grid RowDefinitions="Auto,Auto,*" Background="Transparent"
        controls:FileDropBehavior.Command="{Binding DropFilesCommand}">

    <!-- Заголовок раздела: стоит и над каталогом, и над экранами открытого списка. -->
    <TextBlock Grid.Row="0" Classes="section" Text="{l:Tr Main_RoutingSection}" />

    <!-- Шапка каталога: добавление списка маршрутизации. Способ выбирается плитками на экране ниже. -->
    <StackPanel x:Name="CatalogueHeader" Grid.Row="1" Margin="0,14,0,0" Spacing="8"
                IsVisible="{Binding IsSectionCatalogue}">
      <Button x:Name="AddButton" Classes="methodpick" MinHeight="34" Padding="12,6"
              Command="{Binding BeginAddListCommand}"
              HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}"
              MinWidth="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=minW130}">
        <StackPanel Orientation="Horizontal" Spacing="6"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource AgPlusGeometry}" Width="14" Height="14" VerticalAlignment="Center" />
          <TextBlock Text="{l:Tr Main_AddButton}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- Каталог пуст: списков ещё нет, добавление - единственный шаг. -->
      <TextBlock IsVisible="{Binding ShowNoListsHint}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                 Margin="0,4,0,0" Text="{l:Tr Main_NoRoutingListsHint}" />
    </StackPanel>

    <!-- Content: one section shown at a time. Up from its top row returns to the header, not to the window one. -->
    <Panel x:Name="Body" Grid.Row="2" Margin="0,14,0,0" KeyDown="OnBodyKeyDown">

      <!-- Каталог карточек: кнопка на карточке открывает настройки своего списка, драг
           переставляет карточки. -->
      <Panel IsVisible="{Binding IsSectionCatalogue}">
        <!-- Карточки стоят одной колонкой во всю ширину пана. -->
        <ScrollViewer IsVisible="{Binding ShowCardStack}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="CardStack" ItemsSource="{Binding RoutingLists}" controls:ListMotion.Enabled="True">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RoutingListSummaryViewModel">
                <controls:RoutingCard Margin="0,0,0,8"
                        OpenCommand="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).OpenCardCommand}"
                        SelectCommand="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).SelectCardCommand}"
                        DropCommand="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).ApplyOrderCommand}"
                        PickCommand="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).PickCardCommand}"
                        Sheet="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).Sheet}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </Panel>

      <!-- Catalogue loader: the agent has not reported its routing lists yet (#134). -->
      <StackPanel IsVisible="{Binding ShowCatalogueLoader}" HorizontalAlignment="Center" Spacing="12" Margin="0,24">
        <ProgressBar IsIndeterminate="{Binding ShowCatalogueLoader}" Width="150" HorizontalAlignment="Center" />
        <TextBlock Text="{l:Tr Main_RoutingLoading}" Classes="muted" FontSize="13" HorizontalAlignment="Center" />
      </StackPanel>

      <!-- Section loader until an opened list's rules + traffic settings finish (#193). -->
      <StackPanel IsVisible="{Binding ShowSettingsLoader}" HorizontalAlignment="Center" Spacing="12" Margin="0,24">
        <ProgressBar IsIndeterminate="{Binding ShowSettingsLoader}" Width="150" HorizontalAlignment="Center" />
        <TextBlock Text="{l:Tr Main_RoutingLoading}" Classes="muted" FontSize="13" HorizontalAlignment="Center" />
      </StackPanel>

      <!-- Settings section: the picked-list switch + the shared editor + delete. -->
      <StackPanel x:Name="SettingsSection" IsVisible="{Binding ShowSettingsEditor}">
        <!-- One frame around the whole settings block; below the card width it goes and the hairlines carry the boundaries. -->
        <Border Classes="sect">
          <StackPanel Spacing="14">
            <!-- Действует ли список: тумблер. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBlock Grid.Column="0" Text="{l:Tr Main_InUseToggle}" FontWeight="SemiBold" FontSize="15"
                         TextWrapping="Wrap" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                            IsChecked="{Binding UseOpenList, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hairline" />

            <views:RoutingEditorView />

            <Border Classes="hairline" />

            <!-- Остальное списка уходит на свой экран. -->
            <Button Classes="softbtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Padding="12,10" Command="{Binding SelectRoutingSectionCommand}" CommandParameter="advanced">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="{l:Tr Main_AdvancedTitle}" FontWeight="SemiBold" FontSize="15"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{l:Tr Main_AdvancedSubtitle}" Classes="muted" FontSize="11.5"
                             TextWrapping="Wrap" />
                </StackPanel>
                <PathIcon Grid.Column="1" Data="{DynamicResource AgChevronGeometry}" Width="12" Height="12"
                          VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Дополнительно: трафик списка, экспорт и удаление. Возвращает стрелка «назад» в шапке окна. -->
      <StackPanel x:Name="AdvancedSection" IsVisible="{Binding ShowAdvancedEditor}" Spacing="12">
        <TextBlock Text="{l:Tr Main_AdvancedTitle}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />

        <Border Classes="sect">
          <StackPanel Spacing="14">
            <StackPanel Spacing="14"
                        IsVisible="{Binding RoutingSettings, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="14" DataContext="{Binding RoutingSettings}"
                          x:DataType="vm:RoutingSettingsViewModel">
                <controls:SettingSwitchRow Heading="True" Label="{l:Tr Main_AllUdpTitle}"
                                           Description="{l:Tr Main_AllUdpHint}"
                                           IsChecked="{Binding AllUdp, Mode=TwoWay}" HorizontalAlignment="Stretch" />

                <Border Classes="hairline" />

                <!-- Общая настройка агента: время жизни держит кеш всех списков. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="40">
                  <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{l:Tr Main_RouteTtlTitle}" FontWeight="SemiBold" FontSize="15"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{l:Tr Main_RouteTtlHint}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBox Grid.Column="1" Classes="field" Classes.invalid="{Binding RouteTtlInvalid}" Width="112"
                           controls:NumericInput.Minimum="0" controls:NumericInput.Maximum="86400"
                           VerticalAlignment="Center" Text="{Binding RouteTtl, Mode=TwoWay}">
                    <TextBox.InnerRightContent>
                      <TextBlock Text="{l:Tr General_Seconds}" Classes="muted" Margin="6,0,10,0"
                                 VerticalAlignment="Center" IsHitTestVisible="False" />
                    </TextBox.InnerRightContent>
                  </TextBox>
                </Grid>

                <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>

              <Border Classes="hairline" />
            </StackPanel>

            <!-- Экспорт: способ - экран QR, текст списка в буфер или файл - выпадает списком у кнопки, а на
                 телефоне приходит шторкой снизу. -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10"
                  IsVisible="{Binding CanExportOpenList}">
              <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{l:Tr Main_ExportListTitle}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                <TextBlock Text="{l:Tr Main_TransferSubtitle}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Row="1" Grid.Column="0" Classes="methodpick" VerticalAlignment="Center"
                      Click="OnExportOptions"
                      Width="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w180}"
                      HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
                <StackPanel Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource AgShareGeometry}" Width="14" Height="14" VerticalAlignment="Center" />
                  <TextBlock Text="{l:Tr Main_ExportTab}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>

            <Border Classes="hairline" IsVisible="{Binding CanExportOpenList}" />

            <!-- Delete: description left, delete trigger right. When armed, the trigger is replaced in place by
                 the Confirm/Cancel pair sharing its footprint - one per column, each stretched (#4). -->
            <StackPanel Spacing="10" IsVisible="{Binding ShowDeleteCard}">
              <!-- The trigger stands under the description. -->
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{l:Tr Main_DeleteListTitle}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding DeleteListPrompt}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <Grid Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                      Width="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w180}"
                      HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}"
                      ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Grid.ColumnSpan="2" Classes="danger" HorizontalAlignment="Stretch"
                          Content="{l:Tr Main_DeleteListButton}"
                          IsVisible="{Binding !RoutingDeletePending}"
                          Command="{Binding RequestDeleteSectionRoutingListCommand}" />
                  <Button Grid.Column="0" Classes="danger" HorizontalAlignment="Stretch"
                          Content="{l:Tr Main_ConfirmDeleteButton}"
                          IsVisible="{Binding RoutingDeletePending}"
                          Command="{Binding ConfirmDeleteSectionRoutingListCommand}" />
                  <Button Grid.Column="1" Classes="softbtn" HorizontalAlignment="Stretch"
                          Content="{l:Tr Main_CancelButton}"
                          IsVisible="{Binding RoutingDeletePending}"
                          Command="{Binding CancelDeleteRoutingCommand}" />
                </Grid>
              </Grid>
              <TextBlock Text="{Binding RoutingDeleteStatus}" Classes="fieldwarn" FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding RoutingDeleteStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Export section: QR / raw payload of the list, with copy / save. -->
      <StackPanel x:Name="ExportSection" IsVisible="{Binding IsSectionExport}" Spacing="12">
        <!-- Экран экспорта занимает пану целиком; возвращает с него стрелка «назад» в шапке окна. -->
        <TextBlock Text="{l:Tr Main_ExportListTitle}" FontWeight="SemiBold" FontSize="15"
                   TextWrapping="Wrap" VerticalAlignment="Center" />

        <Border Classes="sect">
          <StackPanel Spacing="12" DataContext="{Binding RoutingEditor}" x:DataType="vm:RoutingListEditorViewModel">
            <TextBlock Text="{l:Tr Main_TransferSubtitle}" Classes="muted" FontSize="12" TextWrapping="Wrap" />

            <!-- Segmented [QR | Конфиг]. -->
            <Border Background="{DynamicResource AgInsetBrush}"
                    BorderBrush="{DynamicResource AgBorderBrush}" BorderThickness="1"
                    CornerRadius="9" Padding="3" MaxWidth="420" HorizontalAlignment="Center">
              <UniformGrid Columns="2">
                <Button Classes="seg" Classes.active="{Binding IsTransferQr}" Command="{Binding ShowTransferQrCommand}"
                        Content="{l:Tr Main_TransferQrTab}" HorizontalAlignment="Stretch" Padding="20,6" />
                <Button Classes="seg" Classes.active="{Binding IsTransferText}" Command="{Binding ShowTransferTextCommand}"
                        Content="{l:Tr Main_TransferTextTab}" HorizontalAlignment="Stretch" Padding="20,6" />
              </UniformGrid>
            </Border>

            <!-- QR tab: fixed 240x240 stage so the image (or notice) appearing never reflows the card. -->
            <Panel Height="240" IsVisible="{Binding IsTransferQr}">
              <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="8" Padding="10"
                      IsVisible="{Binding RoutingQrImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Image Source="{Binding RoutingQrImage}" Width="220" Height="220" />
              </Border>
              <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource AgInsetBrush}"
                      BorderBrush="{DynamicResource AgBorderBrush}" BorderThickness="1"
                      CornerRadius="8" Padding="16" Width="240" IsVisible="{Binding QrUnavailable}">
                <TextBlock Text="{l:Tr Main_QrUnavailableHint}" Classes="muted" FontSize="12"
                           TextAlignment="Center" TextWrapping="Wrap" />
              </Border>
            </Panel>

            <!-- Config tab: the raw transfer payload, read-only and selectable. -->
            <TextBox Classes="field" Text="{Binding TransferText}" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="NoWrap" IsVisible="{Binding IsTransferText}"
                     VerticalContentAlignment="Top" Height="200"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="IBM Plex Mono, Cascadia Mono, Consolas, monospace" FontSize="12" />

            <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Export actions: copy, save and send all take the open form - the QR as a picture, the config
                 as text. Sending shows up where the platform carries it. -->
            <WrapPanel HorizontalAlignment="Center">
              <Button Classes="methodpick" Margin="4" Padding="14,6" Click="OnRoutingExportCopy"
                      IsEnabled="{Binding TransferReady}"
                      ToolTip.Tip="{l:Tr Main_RoutingCopyTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource AgCopyGeometry}" Width="14" Height="14" />
                  <TextBlock Text="{l:Tr Main_CopyButton}" />
                </StackPanel>
              </Button>
              <Button Classes="accent" Margin="4" Padding="14,6" Click="OnRoutingExportSave"
                      IsEnabled="{Binding TransferReady}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource AgDownloadGeometry}" Width="14" Height="14" />
                  <TextBlock Text="{l:Tr Main_SaveToFileButton}" />
                </StackPanel>
              </Button>
              <Button Classes="methodpick" Margin="4" Padding="14,6" Click="OnRoutingExportSend"
                      IsVisible="{Binding CanSendExport}" IsEnabled="{Binding TransferReady}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource AgShareGeometry}" Width="14" Height="14" />
                  <TextBlock Text="{l:Tr Main_SendToAppButton}" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Способ добавления: готовый набор, свои правила или импорт со стороны. -->
      <Border Classes="sect" IsVisible="{Binding ShowImportPicker}">
        <StackPanel Spacing="8">
          <Button Classes="presetcard on" Command="{Binding BeginPresetImportCommand}">
            <StackPanel Spacing="3">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource AgMethodPresetGeometry}" Width="15" Height="15"
                          Foreground="{DynamicResource AgAccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{l:Tr Main_MethodPresetTitle}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{l:Tr Main_MethodPresetHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Button>

          <Button Classes="presetcard" Command="{Binding BeginManualImportCommand}">
            <StackPanel Spacing="3">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource AgMethodManualGeometry}" Width="15" Height="15"
                          Foreground="{DynamicResource AgMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{l:Tr Main_MethodManualTitle}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{l:Tr Main_MethodManualHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Button>

          <Button x:Name="ImportTile" Classes="presetcard" Click="OnImportOptions">
            <StackPanel Spacing="3">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <PathIcon Grid.Column="0" Data="{StaticResource AgDownloadGeometry}" Width="15" Height="15"
                          Foreground="{DynamicResource AgMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{l:Tr Main_MethodImportTitle}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <PathIcon Grid.Column="2" Data="{DynamicResource AgChevronGeometry}" Width="11" Height="11"
                          Foreground="{DynamicResource AgMuted2Brush}" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{l:Tr Main_MethodImportHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Готовые наборы: нажатие ставит список и сразу применяет его. -->
      <Border Classes="sect" IsVisible="{Binding ShowImportPresets}">
        <StackPanel Spacing="10">
          <TextBlock Text="{l:Tr Preset_SectionTitle}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />

          <!-- Регион набора: его адреса идут напрямую, выбор стоит на своём экране. -->
          <Button Classes="softbtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Padding="12,10" Command="{Binding OpenRegionsCommand}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{l:Tr Preset_RegionTitle}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PresetRegionsLabel}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
              <PathIcon Grid.Column="1" Data="{DynamicResource AgChevronGeometry}" Width="12" Height="12"
                        VerticalAlignment="Center" />
            </Grid>
          </Button>

          <ItemsControl ItemsSource="{Binding PresetCards}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RoutingPresetItemViewModel">
                <Button Classes="presetcard" Margin="0,0,0,6"
                        Command="{Binding $parent[ItemsControl].((vm:RoutingViewModel)DataContext).ApplyPresetCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Hint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Chips}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sys:String">
                          <Border Classes="presetchip" Margin="0,3,4,0">
                            <TextBlock Text="{Binding}" FontSize="10.5" Classes="muted" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Добавка к любому набору: реклама уходит в корзину «Блок». -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{l:Tr Preset_AdsTitle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{l:Tr Preset_AdsHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding PresetAds, Mode=TwoWay}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Выбор региона: коды geoip из гео-баз, поиск и отметки. -->
      <Border Classes="sect" IsVisible="{Binding ShowImportRegions}">
        <StackPanel Spacing="10">
          <TextBlock Text="{l:Tr Preset_RegionsTitle}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
          <TextBlock Text="{l:Tr Preset_RegionsHint}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />

          <TextBox Classes="field" Text="{Binding RegionSearch, Mode=TwoWay}"
                   Watermark="{l:Tr Preset_RegionSearch}" />

          <StackPanel IsVisible="{Binding RegionsLoading}" HorizontalAlignment="Center" Spacing="12" Margin="0,24">
            <ProgressBar IsIndeterminate="{Binding RegionsLoading}" Width="150" HorizontalAlignment="Center" />
            <TextBlock Text="{l:Tr Main_RoutingLoading}" Classes="muted" FontSize="13" HorizontalAlignment="Center" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding RegionCards}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RegionItemViewModel">
                <CheckBox HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,2"
                          IsChecked="{Binding IsPicked, Mode=TwoWay}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Badge}" Classes="muted" FontSize="11"
                               VerticalAlignment="Center" />
                  </Grid>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{Binding RegionsTrimmed}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                     IsVisible="{Binding RegionsTrimmed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <!-- Набор применяется: список создаётся и встаёт активным. -->
      <StackPanel IsVisible="{Binding ShowPresetLoader}" HorizontalAlignment="Center" Spacing="12" Margin="0,24">
        <ProgressBar IsIndeterminate="{Binding ShowPresetLoader}" Width="150" HorizontalAlignment="Center" />
        <TextBlock Text="{l:Tr Preset_Applying}" Classes="muted" FontSize="13" HorizontalAlignment="Center" />
      </StackPanel>

      <!-- Черновик нового списка: имя списка называет сам редактор, отсюда ведут «Сохранить» и «Отмена» в
           футере. -->
      <Border x:Name="ImportEditor" Classes="sect" IsVisible="{Binding ShowImportEditor}">
        <views:RoutingEditorView />
      </Border>

      <!-- Import section - live QR scanner. -->
      <Panel IsVisible="{Binding ShowImportCamera}" MinHeight="220">
        <views:ScanView DataContext="{Binding SectionScan}" />
      </Panel>

    </Panel>
  </Grid>
</UserControl>
