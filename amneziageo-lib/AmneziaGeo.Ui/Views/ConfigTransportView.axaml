<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             xmlns:svc="clr-namespace:AmneziaGeo.Ui.Services"
             xmlns:decl="clr-namespace:AmneziaGeo.Decl;assembly=AmneziaGeo.Decl"
             x:Class="AmneziaGeo.Ui.Views.ConfigTransportView"
             x:CompileBindings="True"
             x:DataType="vm:ConfigTransportViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.available"><Setter Property="Foreground" Value="{DynamicResource AgUpBrush}" /></Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <StreamGeometry x:Key="AgEyeGeometry">M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9M12,4.5C17,4.5 21.27,7.61 23,12C21.27,16.39 17,19.5 12,19.5C7,19.5 2.73,16.39 1,12C2.73,7.61 7,4.5 12,4.5M3.18,12C4.83,15.36 8.24,17.5 12,17.5C15.76,17.5 19.17,15.36 20.82,12C19.17,8.64 15.76,6.5 12,6.5C8.24,6.5 4.83,8.64 3.18,12Z</StreamGeometry>
  </UserControl.Resources>
  <!-- WebSocket, MTU and the switches of a config. Fields stay left, capped so they do not stretch across a wide card. -->
  <StackPanel Spacing="14">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" MinHeight="40">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Tr Proxies_Title}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
      <controls:AdaptiveComboBox x:Name="ProxySelector" Classes="field" ItemsSource="{Binding ProxyChoices}"
          SelectedItem="{Binding SelectedProxyChoice, Mode=TwoWay}"
          MaxWidth="620" HorizontalAlignment="Stretch"
          Grid.Row="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=row}"
          Grid.Column="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=col}"
          Grid.ColumnSpan="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=span2}"
          Margin="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=gapTop14}">
        <ComboBox.Styles>
          <Style Selector="ComboBoxItem" x:DataType="vm:TransportProxyChoice">
            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
          </Style>
        </ComboBox.Styles>
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TransportProxyChoice">
            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxWidth="{Binding #ProxySelector.Bounds.Width}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </controls:AdaptiveComboBox>
    </Grid>

    <Border Classes="sect" IsVisible="{Binding HasSelectedProxy}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding SelectedProxyDetails}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <TextBlock Text="{Binding SelectedProxyAvailability}" Classes="muted" Classes.available="{Binding SelectedProxyAvailable}" />
          <TextBlock Grid.Column="1" Text="{Binding SelectedProxyScope}" Classes="muted" TextWrapping="Wrap" />
        </Grid>
        <TextBlock Text="{Binding SelectedProxyTargets}" Classes="muted" TextWrapping="Wrap"
                   IsVisible="{Binding SelectedProxyTargets, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding SelectedProxyFault}" Classes="fieldwarn" TextWrapping="Wrap"
                   IsVisible="{Binding SelectedProxyFault, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button x:Name="ViewSelectedProxy" Classes="linkbtn" Content="{l:Tr Proxies_View}" Command="{Binding ViewSelectedProxyCommand}"
                IsVisible="{Binding CanViewSelectedProxy}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
    <Border Classes="sect" IsVisible="{Binding ShowRunningProxy}">
      <StackPanel Spacing="8">
        <TextBlock Text="{l:Tr Proxies_ActuallyUsed}" Classes="label" />
        <TextBlock Text="{Binding RunningProxyDetails}" TextWrapping="Wrap" />
        <Button x:Name="ViewRunningProxy" Classes="linkbtn" Content="{l:Tr Proxies_View}" Command="{Binding ViewRunningProxyCommand}"
                IsVisible="{Binding CanViewRunningProxy}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>

    <!-- Narrow screen: a hairline carries the section boundary the frame used to. -->
    <Border Height="1" Background="{DynamicResource AgBorderBrush}" IsVisible="{Binding IsCompact}" />

    <!-- The box stands beside its heading, where a switch stands in the rows around it. A narrow card has no
         width for both, so the pair drops under the heading. -->
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" MinHeight="40" HorizontalAlignment="Stretch">
      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{l:Tr Main_TunnelMtuLabel}" FontWeight="SemiBold" FontSize="15" />
        <TextBlock Classes="muted" FontSize="11.5" TextWrapping="Wrap" Text="{l:Tr Main_MtuHint}" />
      </StackPanel>
      <!-- Узкому телефону список тянется, поле числа остаётся своей ширины. -->
      <Grid Grid.Row="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=row}"
            Grid.Column="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=col}"
            Grid.ColumnSpan="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=span2}"
            Margin="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=gapTop14}"
            ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center"
            HorizontalAlignment="{Binding IsSlim, Source={x:Static svc:UiLayout.Instance}, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
        <controls:AdaptiveComboBox Grid.Column="0" Classes="field" HorizontalAlignment="Stretch"
                                   Width="{Binding IsSlim, Source={x:Static svc:UiLayout.Instance}, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w132}"
                                   SelectedIndex="{Binding MtuMode, Mode=TwoWay}">
          <ComboBoxItem Content="{l:Tr Main_MtuModeAuto}" />
          <ComboBoxItem Content="{l:Tr Main_MtuModeConfig}" />
          <ComboBoxItem Content="{l:Tr Main_MtuModeCustom}" />
        </controls:AdaptiveComboBox>
        <TextBox Grid.Column="1" Classes="field" Width="90" IsEnabled="{Binding !IsMtuReadOnly}"
                 controls:NumericInput.Minimum="{x:Static decl:MtuModes.MinMtu}" controls:NumericInput.Maximum="{x:Static decl:MtuModes.MaxMtu}" Text="{Binding Mtu}" />
      </Grid>
    </Grid>

    <Border Height="1" Background="{DynamicResource AgBorderBrush}" IsVisible="{Binding IsCompact}" />

    <!-- DNS для имён через VPN: выбор и его серверы. -->
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" MinHeight="40" HorizontalAlignment="Stretch">
      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{l:Tr Main_VpnDnsTitle}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
          <controls:ServerMark Text="{l:Tr Main_ServerMarkDns}" State="{Binding DnsMarkState}" />
        </StackPanel>
        <TextBlock Classes="muted" FontSize="11.5" TextWrapping="Wrap" Text="{l:Tr Main_VpnDnsHint}" />
      </StackPanel>
      <Grid Grid.Row="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=row}"
            Grid.Column="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=col}"
            Grid.ColumnSpan="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=span2}"
            Margin="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=gapTop14}"
            ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center"
            HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
        <controls:AdaptiveComboBox Grid.Column="0" Classes="field" HorizontalAlignment="Stretch"
                                   Width="{Binding IsSlim, Source={x:Static svc:UiLayout.Instance}, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w160}"
                                   SelectedIndex="{Binding VpnDnsMode, Mode=TwoWay}">
          <ComboBoxItem Content="{l:Tr Main_VpnDnsDefault}" />
          <ComboBoxItem Content="{l:Tr Main_VpnDnsNetwork}" />
          <ComboBoxItem Content="{l:Tr Main_VpnDnsServer}" IsEnabled="{Binding ServerDnsAvailable}"
                        ToolTip.Tip="{Binding ServerDnsTip}" ToolTip.ShowOnDisabled="True" />
          <ComboBoxItem Content="{l:Tr Main_VpnDnsOwn}" />
        </controls:AdaptiveComboBox>
        <TextBox Grid.Column="1" Classes="field" IsEnabled="{Binding !IsVpnDnsReadOnly}"
                 MinWidth="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=minW220}"
                 Text="{Binding VpnDnsText}" PlaceholderText="{Binding VpnDnsWatermark}" />
      </Grid>
    </Grid>

    <Border Height="1" Background="{DynamicResource AgBorderBrush}" IsVisible="{Binding IsCompact}" />

    <controls:SettingSwitchRow Heading="True" Label="{l:Tr Main_UseIpv6Title}" Description="{l:Tr Main_UseIpv6Hint}"
                               IsChecked="{Binding UseIpv6, Mode=TwoWay}" HorizontalAlignment="Stretch" />

    <Border Height="1" Background="{DynamicResource AgBorderBrush}" IsVisible="{Binding IsCompact}" />

    <controls:SettingSwitchRow Heading="True" Label="{l:Tr Main_UseRoutingTitle}" Description="{l:Tr Main_UseRoutingHint}"
                               IsChecked="{Binding RoutingSwitch, Mode=TwoWay}"
                               SwitchEnabled="{Binding !ServerListsOnly}" SwitchTip="{Binding RoutingSwitchTip}"
                               HorizontalAlignment="Stretch">
      <controls:SettingSwitchRow.Mark>
        <controls:ServerMark Text="{l:Tr Main_ServerMarkRouting}" IsVisible="{Binding ServerListsOnly}" />
      </controls:SettingSwitchRow.Mark>
    </controls:SettingSwitchRow>

    <Border Height="1" Background="{DynamicResource AgBorderBrush}" IsVisible="{Binding IsCompact}" />

    <controls:SettingSwitchRow Heading="True" Label="{l:Tr Main_HoldTrafficTitle}" Description="{l:Tr Main_HoldTrafficHint}"
                               IsChecked="{Binding HoldTraffic, Mode=TwoWay}" HorizontalAlignment="Stretch" />

    <!-- Приём входящих по адресу этой машины в туннеле. -->
    <StackPanel Spacing="14" IsVisible="{Binding InboundAvailable}">
      <Border Height="1" Background="{DynamicResource AgBorderBrush}" IsVisible="{Binding IsCompact}" />

      <controls:SettingSwitchRow Heading="True" Label="{l:Tr Main_InboundTitle}" Description="{l:Tr Main_InboundHint}"
                                 IsChecked="{Binding AllowInbound, Mode=TwoWay}" HorizontalAlignment="Stretch" />

      <!-- Адрес этой машины в туннеле: встаёт под описанием приёма. -->
      <SelectableTextBlock Text="{Binding TunnelAddress}" FontSize="12.5" TextWrapping="Wrap"
                           Margin="0,-11,0,0" MaxWidth="430" HorizontalAlignment="Left"
                           IsVisible="{Binding ShowInboundAddress}" />
    </StackPanel>

    <!-- Сигнал сервера на отключение: тумблер доступен, пока сервер оставляет выбор устройству. -->
    <StackPanel Spacing="14">
      <Border Height="1" Background="{DynamicResource AgBorderBrush}" IsVisible="{Binding IsCompact}" />

      <controls:SettingSwitchRow Heading="True" Label="{l:Tr Main_SignalTitle}" Description="{l:Tr Main_SignalHint}"
                                 IsChecked="{Binding SignalSwitch, Mode=TwoWay}" SwitchEnabled="{Binding SignalOffered}"
                                 HorizontalAlignment="Stretch">
        <controls:SettingSwitchRow.Mark>
          <controls:ServerMark Text="{l:Tr Main_ServerMarkSignal}" State="{Binding SignalMarkState}" />
        </controls:SettingSwitchRow.Mark>
      </controls:SettingSwitchRow>
    </StackPanel>

    <!-- The router decides destinations while the session runs and costs a second pass through userspace;
         turning it off leaves the route table alone with the rules. -->
    <controls:SettingSwitchRow Heading="True" Label="{l:Tr Main_RouterTitle}" Description="{l:Tr Main_RouterHint}"
                               IsVisible="{Binding RouterAvailable}"
                               IsChecked="{Binding UseRouter, Mode=TwoWay}" HorizontalAlignment="Stretch" />

    <TextBlock Text="{Binding StatusMessage}" Classes="fieldwarn" FontSize="12" TextWrapping="Wrap"
               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>
