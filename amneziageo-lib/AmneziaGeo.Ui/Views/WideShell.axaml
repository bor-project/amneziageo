<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:views="clr-namespace:AmneziaGeo.Ui.Views"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             x:Class="AmneziaGeo.Ui.Views.WideShell"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="AgWidePlusGeometry">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Разделы стоят вкладками в шапке: список каталога занимает левую колонку, второй вертикальной навигации
         рядом с ним быть не должно. -->
    <Style Selector="Button.wtab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AgMutedBrush}" />
    </Style>
    <Style Selector="Button.wtab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AgPanel2Brush}" />
    </Style>
    <Style Selector="Button.wtab.active">
      <Setter Property="Foreground" Value="{DynamicResource AgFgBrush}" />
    </Style>
    <Style Selector="Button.wtab.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AgPanel2Brush}" />
    </Style>

    <!-- Метка политики в шапке карточки списка. -->
    <Style Selector="Border.listbadge">
      <Setter Property="Background" Value="{DynamicResource AgAccentSoftBrush}" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.listbadge > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AgAccentBrush}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="12,3,12,3">

    <!-- Шапка: имя, разделы вкладками и состояние туннеля справа. -->
    <Border Grid.Row="0" Classes="card" Height="52" Padding="12,0">
      <Grid x:Name="HeaderBar" ColumnDefinitions="Auto,*,Auto" SizeChanged="OnHeaderSizeChanged">
        <!-- Главный экран с большой кнопкой остаётся одноколоночным: сюда за ним и возвращаются. -->
        <Button x:Name="HomeBack" Grid.Column="0" Classes="icon" Padding="6,4" VerticalAlignment="Center"
                Command="{Binding NavHomeCommand}" ToolTip.Tip="{l:Tr Main_BackTooltip}">
          <PathIcon Data="{DynamicResource AgBackGeometry}" Width="18" Height="18"
                    Foreground="{DynamicResource AgMutedBrush}" />
        </Button>

        <StackPanel x:Name="Tabs" Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="20,0"
                    VerticalAlignment="Center">
          <Button Classes="wtab" Classes.active="{Binding IsSettingsConfig}"
                  Content="{l:Tr Main_HomeTabServers}"
                  Command="{Binding SelectSettingsCommand}" CommandParameter="config" />
          <Button Classes="wtab" Classes.active="{Binding IsSettingsRouting}"
                  Content="{l:Tr Main_RoutingSection}"
                  Command="{Binding SelectSettingsCommand}" CommandParameter="routing" />
          <Button Classes="wtab" Classes.active="{Binding IsSettingsLogs}"
                  Content="{l:Tr Main_DiagnosticsSection}"
                  Command="{Binding SelectSettingsCommand}" CommandParameter="logs" />
          <Button Classes="wtab" Classes.active="{Binding IsSettingsGeneral}"
                  Content="{l:Tr General_Section}"
                  Command="{Binding SelectSettingsCommand}" CommandParameter="general" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <!-- Счётчик уступает место вкладкам и кнопке: те же числа стоят на карточке конфигурации.
               Ширину ему разрешает шапка, показ - живой туннель, поэтому условия стоят на разных контролах. -->
          <Panel x:Name="LinkFit" VerticalAlignment="Center">
            <TextBlock x:Name="LinkSpeed" Text="{Binding Home.LinkSpeedText}" Classes="muted" FontSize="12"
                       VerticalAlignment="Center" IsVisible="{Binding Home.ShowLink}" />
          </Panel>
          <controls:ConnectPill x:Name="ConnectPart" DataContext="{Binding Home}" />
        </StackPanel>
      </Grid>
    </Border>

    <Panel Grid.Row="1" Margin="0,6,0,0">

      <!-- СЕРВЕРЫ: каталог карточками слева, настройки открытой конфигурации справа. -->
      <Grid IsVisible="{Binding IsSettingsConfig}">
        <Grid.ColumnDefinitions>
          <!-- Ширину каталога тянет сепаратор между колонками: ниже 260 карточка режется, выше 560 настройкам
               не остаётся места в узком окне. -->
          <ColumnDefinition Width="340" MinWidth="260" MaxWidth="560" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Classes="card" Padding="0">
          <DockPanel LastChildFill="True">
            <!-- Шапка колонки: сколько конфигураций в каталоге, замер всех разом и добавление новой. -->
            <Grid DockPanel.Dock="Top" Margin="12,12,12,8" ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                  ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="{l:Tr Main_HomeTabServers}" FontWeight="SemiBold" FontSize="14"
                         VerticalAlignment="Center" />
              <Border Grid.Column="1" Background="{DynamicResource AgPanel2Brush}" CornerRadius="8"
                      Padding="7,1" VerticalAlignment="Center" IsVisible="{Binding HasConfigs}">
                <TextBlock Text="{Binding Config.Configs.Count}" Classes="muted" FontSize="11.5" />
              </Border>
              <Button Grid.Column="3" Classes="methodpick" MinWidth="38" MinHeight="34" Padding="0"
                      IsVisible="{Binding HasConfigs}" ToolTip.Tip="{l:Tr Main_ProbeTooltip}"
                      Command="{Binding Home.ProbeAllCommand}" IsEnabled="{Binding !Home.ProbeRunning}">
                <PathIcon Classes.spin="{Binding Home.ProbeRunning}" Data="{DynamicResource AgRefreshGeometry}"
                          Width="16" Height="16" Foreground="{DynamicResource AgMutedBrush}" />
              </Button>
              <Button Grid.Column="4" Classes="accent" MinWidth="38" MinHeight="34" Padding="0"
                      Click="OnAddServer" ToolTip.Tip="{l:Tr Main_AddConfigButton}">
                <PathIcon Data="{StaticResource AgWidePlusGeometry}" Width="14" Height="14" />
              </Button>
            </Grid>

            <!-- Что делает замер, сказано под списком: кнопка над ним несёт один значок. -->
            <TextBlock DockPanel.Dock="Bottom" Margin="12,4,12,12" Classes="muted" FontSize="11"
                       TextWrapping="Wrap" Text="{l:Tr Main_ProbeAllHint}" IsVisible="{Binding HasConfigs}" />

            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Config.Configs}" Margin="12,0,12,12">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConfigItemViewModel">
                    <!-- Карточка та же, что на телефоне: нажатие открывает её настройки справа, кнопка на лице
                         поднимает туннель. Меню карточка здесь не несёт - и правка, и удаление стоят
                         открытыми справа. -->
                    <controls:ServerCard Margin="0,0,0,8" HorizontalAlignment="Stretch" HasMenu="False"
                            SelectHint="{l:Tr Main_ServerRowOpen}"
                            IsOpen="{Binding SwipeOpen, Mode=TwoWay}"
                            SelectCommand="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenServerCardCommand}"
                            ConnectCommand="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Home.ConnectConfigCommand}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Границу колонок двигают мышью. Фокус сепаратор не берёт: пульт застревал бы на полоске в 10 px. -->
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                      Focusable="False" IsTabStop="False" />

        <Border Grid.Column="2" Classes="card" Padding="0"
                controls:FileDropBehavior.Command="{Binding ImportDroppedFilesCommand}">
          <Grid RowDefinitions="*,Auto">
            <!-- Прокрутку держит сам раздел: его шапка с именем и тумблером стоит над ней и при листании
                 остаётся на месте. -->
            <ContentControl Grid.Row="0" Margin="18,4" Content="{Binding Config}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:ConfigViewModel">
                  <views:ConfigView />
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- Правки держатся до «Сохранить»: футер той же панели, в которой их сделали. -->
            <Border Grid.Row="1" IsVisible="{Binding Config.ShowSaveBar}"
                    Background="{DynamicResource AgPanelBrush}" BorderBrush="{DynamicResource AgBorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,13,13" MinHeight="52" Padding="18,7">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Ellipse Width="8" Height="8" Fill="{DynamicResource AgWarnBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{l:Tr Main_UnsavedChanges}" Classes="muted" FontSize="12"
                             VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="methodpick" Content="{l:Tr Main_CancelButton}" Width="120"
                          Command="{Binding Config.CancelSectionCommand}" />
                  <Button Classes="accent" Content="{l:Tr Main_SaveButton}" Width="120" Padding="6"
                          Command="{Binding Config.SaveSectionCommand}"
                          IsVisible="{Binding Config.ShowSaveButton}"
                          IsEnabled="{Binding Config.CanSave}" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <!-- МАРШРУТИЗАЦИЯ: списки слева, правила и настройки открытого списка справа. -->
      <Grid IsVisible="{Binding IsSettingsRouting}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="340" MinWidth="260" MaxWidth="560" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Classes="card" Padding="0">
          <DockPanel LastChildFill="True">
            <!-- Шапка колонки та же, что у конфигураций: сколько списков в каталоге и добавление нового. -->
            <Grid DockPanel.Dock="Top" Margin="12,12,12,8" ColumnDefinitions="Auto,Auto,*,Auto"
                  ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="{l:Tr Main_RoutingPickerLabel}" FontWeight="SemiBold" FontSize="14"
                         VerticalAlignment="Center" />
              <Border Grid.Column="1" Background="{DynamicResource AgPanel2Brush}" CornerRadius="8"
                      Padding="7,1" VerticalAlignment="Center" IsVisible="{Binding Routing.HasRoutingLists}">
                <TextBlock Text="{Binding Routing.RoutingLists.Count}" Classes="muted" FontSize="11.5" />
              </Border>
              <Button Grid.Column="3" Classes="accent" MinWidth="38" MinHeight="34" Padding="0"
                      Click="OnAddRoutingList" ToolTip.Tip="{l:Tr Main_AddListTitle}">
                <PathIcon Data="{StaticResource AgWidePlusGeometry}" Width="14" Height="14" />
              </Button>
            </Grid>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Routing.RoutingLists}" Margin="12,0,12,12">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RoutingListSummaryViewModel">
                    <!-- Рамка как у карточки сервера: применённый список носит синюю, просто открытый - серую.
                         Имя и метки политики стоят в верхней строке, счёт по корзинам - под ними. -->
                    <Button Classes="rowselect" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenRoutingListCommand}"
                            CommandParameter="{Binding}">
                      <Panel>
                        <!-- Заливка под списком, который держит приложение: рамку глаз теряет среди соседних. -->
                        <Border CornerRadius="12" IsHitTestVisible="False"
                                Background="{DynamicResource AgAccentSoftBrush}" IsVisible="{Binding IsApplied}" />

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="8,9"
                              ColumnSpacing="7" RowSpacing="5">
                          <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />

                          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                      VerticalAlignment="Center">
                            <Border Classes="listbadge" IsVisible="{Binding UseGlobalProxy}">
                              <TextBlock Text="{l:Tr RoutingSummary_GlobalBadge}" />
                            </Border>
                            <Border Classes="listbadge" IsVisible="{Binding AllUdp}">
                              <TextBlock Text="{l:Tr RoutingSummary_UdpBadge}" />
                            </Border>
                          </StackPanel>

                          <!-- Правила по корзинам: пустая корзина в строке не стоит. -->
                          <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,10,0"
                                        IsVisible="{Binding ShowProxy}">
                              <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                       Fill="{DynamicResource AgAccentBrush}" />
                              <TextBlock Text="{Binding ProxyText}" FontSize="11" Classes="muted" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,10,0"
                                        IsVisible="{Binding ShowDirect}">
                              <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                       Fill="{DynamicResource AgMutedBrush}" />
                              <TextBlock Text="{Binding DirectText}" FontSize="11" Classes="muted" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5"
                                        IsVisible="{Binding ShowBlock}">
                              <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                       Fill="{DynamicResource AgDownBrush}" />
                              <TextBlock Text="{Binding BlockText}" FontSize="11" Classes="muted" />
                            </StackPanel>
                          </WrapPanel>
                        </Grid>
                        <Border BorderThickness="1" CornerRadius="12" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource AgAccentBrush}" IsVisible="{Binding IsApplied}" />
                        <Border BorderThickness="1" CornerRadius="12" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource AgMutedBrush}" IsVisible="{Binding ShowOpenFrame}" />
                      </Panel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                      Focusable="False" IsTabStop="False" />

        <Border Grid.Column="2" Classes="card" Padding="0"
                controls:FileDropBehavior.Command="{Binding ImportDroppedFilesCommand}">
          <Grid RowDefinitions="*,Auto">
            <ContentControl Grid.Row="0" Margin="18,4" Content="{Binding Routing}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:RoutingViewModel">
                  <views:RoutingView />
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>

            <Border Grid.Row="1" IsVisible="{Binding Routing.ShowSaveBar}"
                    Background="{DynamicResource AgPanelBrush}" BorderBrush="{DynamicResource AgBorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,13,13" MinHeight="52" Padding="18,7">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding Routing.RouteBudgetWarning}"
                           IsVisible="{Binding Routing.ShowRouteBudgetWarning}"
                           Foreground="{DynamicResource AgWarnBrush}" FontSize="12" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AgWarnBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{l:Tr Main_UnsavedChanges}" Classes="muted" FontSize="12"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="methodpick" Content="{l:Tr Main_CancelButton}" Width="120"
                            Command="{Binding Routing.CancelSectionCommand}" />
                    <Button Classes="accent" Content="{l:Tr Main_SaveButton}" Width="120" Padding="6"
                            Command="{Binding Routing.SaveSectionCommand}"
                            IsVisible="{Binding Routing.ShowSaveButton}"
                            IsEnabled="{Binding Routing.CanSave}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <!-- ИСТОЧНИКИ ГЕО: своей вкладки нет, открываются ссылкой из маршрутизации. -->
      <Border Classes="card" Padding="0" IsVisible="{Binding IsSettingsSources}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ContentControl Margin="18,4" Content="{Binding Sources}"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:SourcesViewModel">
                <views:SourcesView />
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </ScrollViewer>
      </Border>

      <!-- ДИАГНОСТИКА: как была, во всю ширину. Журнал сам занимает высоту панели. -->
      <Border x:Name="DiagnosticsPane" Classes="card" Padding="0" IsVisible="{Binding IsSettingsLogs}">
        <ContentControl Margin="18,10" Content="{Binding Diagnostics}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:DiagnosticsViewModel">
              <views:DiagnosticsView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Border>

      <!-- ОБЩИЕ: как были, во всю ширину. -->
      <Border Classes="card" Padding="0" IsVisible="{Binding IsSettingsGeneral}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ContentControl Margin="18,4" Content="{Binding General}"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:GeneralViewModel">
                <views:GeneralView />
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </ScrollViewer>
      </Border>

    </Panel>
  </Grid>
</UserControl>
