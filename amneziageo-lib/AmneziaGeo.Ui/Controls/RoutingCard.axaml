<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             x:Class="AmneziaGeo.Ui.Controls.RoutingCard"
             x:CompileBindings="True"
             x:DataType="vm:RoutingListSummaryViewModel"
             Design.DataContext="{x:Static vm:DesignData.RoutingCard}"
             Design.Width="340">
  <!-- Применение и настройки стоят на кнопках правого столбца. На телевизоре тело служит входом,
       дальше пульт ходит по этим же контролам. -->
  <Button x:Name="FacePart" Classes="serverrow noclick" Classes.off="{Binding !IsSelected}">
    <Panel>
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Margin="12,10" Spacing="8" VerticalAlignment="Center">
          <!-- Имя списка и плашка применённого. -->
          <StackPanel Classes="cardhead" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Border Classes="cardbadge" IsVisible="{Binding IsSelected}">
              <TextBlock Text="{l:Tr Main_CardActiveBadge}" FontSize="10.5" FontWeight="SemiBold" />
            </Border>
          </StackPanel>

          <!-- Состав списка: сколько правил уводит в туннель, сколько пускает мимо и сколько глушит. -->
          <StackPanel Classes="cardinfo" Orientation="Horizontal" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                       Fill="{DynamicResource AgAccentBrush}" />
              <TextBlock Text="{Binding ProxyRulesText}" FontSize="12" Classes="muted"
                         VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                       Fill="{DynamicResource AgMutedBrush}" />
              <TextBlock Text="{Binding DirectRulesText}" FontSize="12" Classes="muted"
                         VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                       Fill="{DynamicResource AgDownBrush}" />
              <TextBlock Text="{Binding BlockRulesText}" FontSize="12" Classes="muted"
                         VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>

          <!-- Метки режимов списка. -->
          <controls:CardTags x:Name="TagsPart" Tags="{Binding Tags}" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Правый столбец: применение списка и его настройки. -->
        <Border Grid.Column="1" Classes="cardside">
          <StackPanel Spacing="8" VerticalAlignment="Center">
            <Button x:Name="ActivePart" Classes="cardtoggle" HorizontalAlignment="Center"
                    ToolTip.Tip="{l:Tr Main_CardActiveFlag}"
                    Command="{Binding $parent[controls:RoutingCard].SelectCommand}"
                    CommandParameter="{Binding}">
              <Border Classes="togglering" Classes.on="{Binding IsSelected}">
                <Ellipse Width="13" Height="13" Fill="White" IsVisible="{Binding IsSelected}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Button>
            <Button x:Name="SettingsPart" Classes="cardtune" HorizontalAlignment="Center"
                    ToolTip.Tip="{l:Tr Main_CardSettingsLink}"
                    Command="{Binding $parent[controls:RoutingCard].OpenCommand}" CommandParameter="{Binding}">
              <PathIcon Data="{DynamicResource AgGearGeometry}" Width="15" Height="15" />
            </Button>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Светлая рамка у всякой карточки; поверх неё рамка выбранного в каталоге - цветом его подключения.
           Рисуется поверх содержимого и компоновки не меняет. -->
      <Border BorderThickness="1" CornerRadius="12" IsHitTestVisible="False"
              BorderBrush="{DynamicResource AgBorder2Brush}" />
      <Border BorderThickness="1.5" CornerRadius="12" IsHitTestVisible="False"
              BorderBrush="{DynamicResource AgAccentBrush}" BoxShadow="0 0 14 0 #552A6FDB"
              IsVisible="{Binding IsSelected}" />
      <Border BorderThickness="1" CornerRadius="12" IsHitTestVisible="False"
              BorderBrush="{Binding CardFrameBrush}" IsVisible="{Binding ShowCardFrame}" />
    </Panel>
  </Button>
</UserControl>
