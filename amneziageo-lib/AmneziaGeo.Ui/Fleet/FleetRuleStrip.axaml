<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fleet="clr-namespace:AmneziaGeo.Ui.Fleet"
             x:Class="AmneziaGeo.Ui.Fleet.FleetRuleStrip"
             x:CompileBindings="True"
             x:DataType="fleet:FleetRoutingRuleItemViewModel">
  <UserControl.Styles>
    <Style Selector="ComboBox.target">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>

  <!-- Куда правило едет и куда уходит, пока названный сервер не поднят. -->
  <Grid ColumnDefinitions="Auto,*,Auto,*" Margin="14,0,0,6" ColumnSpacing="6">
    <TextBlock Grid.Column="0" Text="{Binding RouteLabel}" Classes="muted" FontSize="11.5"
               VerticalAlignment="Center" />
    <ComboBox Grid.Column="1" Classes="target" ItemsSource="{Binding RouteChoices}"
              SelectedItem="{Binding Route}">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="fleet:RuleTargetChoice">
          <TextBlock Text="{Binding Text}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Grid.Column="2" Text="{Binding FallbackLabel}" Classes="muted" FontSize="11.5"
               VerticalAlignment="Center" />
    <ComboBox Grid.Column="3" Classes="target" ItemsSource="{Binding FallbackChoices}"
              SelectedItem="{Binding Fallback}">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="fleet:RuleTargetChoice">
          <TextBlock Text="{Binding Text}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
  </Grid>
</UserControl>
