+package pipe
+
+import (
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+)
+
+func pressureBuffer(size int32) *buf.Buffer {
+	b := buf.New()
+	b.Extend(size)
+	return b
+}
+
+func TestDiscardReporterRunsOutsidePipeLock(t *testing.T) {
+	var reader *Reader
+	calls := make(chan [2]int32, 1)
+	var writer *Writer
+	reader, writer = New(DiscardOverflow(), WithSizeLimit(0), WithDiscardReporter(func(packets, bytes int32) {
+		queued, err := reader.ReadMultiBufferTimeout(time.Second)
+		if err != nil {
+			t.Error(err)
+		}
+		buf.ReleaseMulti(queued)
+		calls <- [2]int32{packets, bytes}
+	}))
+	if err := writer.WriteMultiBuffer(buf.MultiBuffer{pressureBuffer(1)}); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() { done <- writer.WriteMultiBuffer(buf.MultiBuffer{pressureBuffer(3)}) }()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("discard callback retained pipe lock")
+	}
+	if got := <-calls; got != [2]int32{1, 3} {
+		t.Fatalf("discard = %v", got)
+	}
+	writer.Close()
+	reader.Interrupt()
+}
+
+func TestNilDiscardReporterPreservesDiscardResult(t *testing.T) {
+	reader, writer := New(DiscardOverflow(), WithSizeLimit(0))
+	defer reader.Interrupt()
+	if err := writer.WriteMultiBuffer(buf.MultiBuffer{pressureBuffer(1)}); err != nil {
+		t.Fatal(err)
+	}
+	if err := writer.WriteMultiBuffer(buf.MultiBuffer{pressureBuffer(3)}); err != nil {
+		t.Fatalf("legacy discard result: %v", err)
+	}
+	queued, err := reader.ReadMultiBufferTimeout(time.Second)
+	defer buf.ReleaseMulti(queued)
+	if err != nil || queued.Len() != 1 {
+		t.Fatalf("queued=%d err=%v", queued.Len(), err)
+	}
+}
+
+func TestEmptyAndClosedWritesDoNotReportOverflow(t *testing.T) {
+	calls := 0
+	_, writer := New(DiscardOverflow(), WithSizeLimit(0), WithDiscardReporter(func(int32, int32) { calls++ }))
+	writer.WriteMultiBuffer(nil)
+	writer.Close()
+	if err := writer.WriteMultiBuffer(buf.MultiBuffer{pressureBuffer(3)}); err == nil {
+		t.Fatal("closed write succeeded")
+	}
+	if calls != 0 {
+		t.Fatal("non-overflow counted")
+	}
+}
+
+func TestDiscardReporterPanicReleasesDatagramAndPropagates(t *testing.T) {
+	marker := &struct{}{}
+	reader, writer := New(DiscardOverflow(), WithSizeLimit(0), WithDiscardReporter(func(int32, int32) { panic(marker) }))
+	defer reader.Interrupt()
+	writer.WriteMultiBuffer(buf.MultiBuffer{pressureBuffer(1)})
+	dropped := pressureBuffer(3)
+	var caught interface{}
+	func() {
+		defer func() { caught = recover() }()
+		writer.WriteMultiBuffer(buf.MultiBuffer{dropped})
+	}()
+	if caught != marker {
+		t.Fatal("callback panic contract changed")
+	}
+	if dropped.Len() != 0 {
+		t.Fatal("panicking callback retained discarded buffer")
+	}
+}
