<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:svc="clr-namespace:AmneziaGeo.Ui.Services"
             x:Class="AmneziaGeo.Ui.Views.LegalView"
             x:CompileBindings="True"
             x:DataType="vm:LegalViewModel">
  <!-- Разделы, абзацы и пункты текста без заголовка и строки версии. -->
  <ItemsControl ItemsSource="{Binding Body}">
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="svc:LegalBlock">
        <Panel>
          <TextBlock IsVisible="{Binding IsHeading}" Text="{Binding Text}" FontSize="14" FontWeight="SemiBold"
                     TextWrapping="Wrap" Margin="0,10,0,6" />
          <TextBlock IsVisible="{Binding IsParagraph}" Text="{Binding Text}" FontSize="13" LineHeight="19"
                     TextWrapping="Wrap" Margin="0,0,0,8" />
          <Grid IsVisible="{Binding IsBullet}" ColumnDefinitions="16,*" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="•" FontSize="13" LineHeight="19" />
            <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13" LineHeight="19" TextWrapping="Wrap" />
          </Grid>
        </Panel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
