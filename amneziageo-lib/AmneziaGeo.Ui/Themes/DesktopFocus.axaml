<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Keyboard focus rings for a monitor: the ones SharedTheme draws for a television, a pixel thinner.
       Included after SharedTheme, so these setters win. -->
  <Style Selector="Button:focus-visible, ComboBox:focus-visible, ToggleSwitch:focus-visible, CheckBox:focus-visible, TextBox:focus-visible, AutoCompleteBox:focus-visible">
    <Setter Property="FocusAdorner">
      <Template>
        <Border BorderBrush="{DynamicResource AgAccentBrush}" BorderThickness="2" CornerRadius="9" />
      </Template>
    </Setter>
  </Style>
  <Style Selector="Button.rowselect:focus-visible">
    <Setter Property="FocusAdorner">
      <Template>
        <Border BorderBrush="{DynamicResource AgAccentBrush}" BorderThickness="2" CornerRadius="12" />
      </Template>
    </Setter>
  </Style>
  <Style Selector="Button.accent:focus-visible">
    <Setter Property="FocusAdorner">
      <Template>
        <Border BorderBrush="White" BorderThickness="2" CornerRadius="9" />
      </Template>
    </Setter>
  </Style>
  <Style Selector="ToggleSwitch:focus-visible">
    <Setter Property="FocusAdorner">
      <Template>
        <Border BorderBrush="{DynamicResource AgAccentBrush}" BorderThickness="2" CornerRadius="10"
                Margin="0,1,12,1" />
      </Template>
    </Setter>
  </Style>
  <Style Selector="Button.serverrow:focus-visible">
    <Setter Property="FocusAdorner">
      <Template>
        <Border BorderBrush="{DynamicResource AgAccentBrush}" BorderThickness="2" CornerRadius="12" />
      </Template>
    </Setter>
  </Style>
  <Style Selector="Button.rowact:focus-visible">
    <Setter Property="FocusAdorner">
      <Template>
        <Border BorderBrush="{DynamicResource AgAccentBrush}" BorderThickness="2" CornerRadius="10"
                Margin="2,0" />
      </Template>
    </Setter>
  </Style>

</Styles>
