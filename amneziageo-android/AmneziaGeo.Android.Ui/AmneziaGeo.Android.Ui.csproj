<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationId>org.amneziageo.android</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.0.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Ships the ABIs the native engine is built for; the Debug default leaves out 32-bit ARM. -->
    <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    <!-- Narrows the built ABIs to the ones the build script passes. -->
    <RuntimeIdentifiers Condition="'$(AndroidRuntimeIdentifiers)' != ''">$(AndroidRuntimeIdentifiers)</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Update URL baked at build time (build-apk.ps1 and build-apk.sh pass -p:UpdateUrl). AndroidBuild reads it
       back as the manifest the check reads; absent => the update section stays hidden. -->
  <ItemGroup Condition="'$(UpdateUrl)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>AmneziaGeo.UpdateUrl</_Parameter1>
      <_Parameter2>$(UpdateUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Prerelease channel baked from the tag (the build scripts pass -p:AllowPrerelease). "1" => the check also
       offers prereleases. -->
  <ItemGroup Condition="'$(AllowPrerelease)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>AmneziaGeo.AllowPrerelease</_Parameter1>
      <_Parameter2>$(AllowPrerelease)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Compiles every assembly ahead of time: the stock profile covers none of the Avalonia startup path, and
       a TV box spends about twenty seconds jitting it. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidStripILAfterAOT>true</AndroidStripILAfterAOT>
    <TrimMode>full</TrimMode>
    <!-- Keeps the reflection path of the serializer: full trimming turns it off. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- Keeps whole every assembly of this application: XAML binds through reflection, resources resolve by key
       and the serializer builds records from constructor parameter names. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <TrimmerRootAssembly Include="AmneziaGeo.Android.Ui" RootMode="All" />
    <TrimmerRootAssembly Include="AmneziaGeo.Android.Engine" RootMode="All" />
    <TrimmerRootAssembly Include="AmneziaGeo.Ui" RootMode="All" />
    <TrimmerRootAssembly Include="AmneziaGeo.Decl" RootMode="All" />
    <TrimmerRootAssembly Include="AmneziaGeo.Dal" RootMode="All" />
    <TrimmerRootAssembly Include="AmneziaGeo.Geo" RootMode="All" />
    <TrimmerRootAssembly Include="AmneziaGeo.Routing" RootMode="All" />
    <TrimmerRootAssembly Include="AmneziaGeo.Cli" RootMode="All" />
    <TrimmerRootAssembly Include="AmneziaGeo.Ipc" RootMode="All" />
    <TrimmerRootAssembly Include="AmneziaGeo.Localization" RootMode="All" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.17" />
    <PackageReference Include="Avalonia.Android" Version="11.3.17" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.17" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Android" Version="3.119.4" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Core" Version="1.6.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.1.1" />
    <!-- Align core-ktx with androidx.core (CameraX pulls an older core-ktx that duplicates classes merged
         into core >= 1.15, breaking dex). -->
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmneziaGeo.Android.Engine\AmneziaGeo.Android.Engine.csproj" />
    <ProjectReference Include="..\..\amneziageo-lib\AmneziaGeo.Cli\AmneziaGeo.Cli.csproj" />
    <ProjectReference Include="..\..\amneziageo-lib\AmneziaGeo.Ui\AmneziaGeo.Ui.csproj" />
    <ProjectReference Include="..\..\amneziageo-lib\AmneziaGeo.Geo\AmneziaGeo.Geo.csproj" />
    <ProjectReference Include="..\..\amneziageo-lib\AmneziaGeo.Dal\AmneziaGeo.Dal.csproj" />
    <ProjectReference Include="..\..\amneziageo-lib\AmneziaGeo.Ipc\AmneziaGeo.Ipc.csproj" />
    <ProjectReference Include="..\..\amneziageo-lib\AmneziaGeo.Localization\AmneziaGeo.Localization.csproj" />
  </ItemGroup>

</Project>
