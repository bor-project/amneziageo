<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AmneziaGeo.Android.Ui.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <StyleInclude Source="avares://AmneziaGeo.Ui/Themes/SharedTheme.axaml" />
    <!-- No tooltips under a finger. -->
    <Style Selector=":is(Control)">
      <Setter Property="ToolTip.ServiceEnabled" Value="False" />
    </Style>
  </Application.Styles>
</Application>
