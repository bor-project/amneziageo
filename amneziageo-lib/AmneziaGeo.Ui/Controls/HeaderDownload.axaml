<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             x:Class="AmneziaGeo.Ui.Controls.HeaderDownload"
             x:CompileBindings="True"
             x:DataType="vm:GeneralViewModel">
  <!-- Running update download in place of the header name: the bar with its percent and the cancel link
       under it. -->
  <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="1" Margin="0,16,0,0">
    <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
      <ProgressBar Minimum="0" Maximum="100" Width="100" Height="4"
                   MinWidth="0" MinHeight="0" VerticalAlignment="Center"
                   Value="{Binding UpdateDownloadPercent, Mode=OneWay}" />
      <TextBlock Text="{Binding UpdateDownloadPercent, StringFormat='{}{0}%'}"
                 FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                 Foreground="{DynamicResource AgMutedBrush}" />
    </StackPanel>
    <Button Classes="linkbtn" Padding="7,1" HorizontalAlignment="Center"
            Content="{l:Tr Main_CancelButton}"
            Command="{Binding CancelDownloadCommand}" />
  </StackPanel>
</UserControl>
