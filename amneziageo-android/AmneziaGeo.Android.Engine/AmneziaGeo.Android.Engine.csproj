<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\amneziageo-lib\AmneziaGeo.Geo\AmneziaGeo.Geo.csproj" />
    <ProjectReference Include="..\..\amneziageo-lib\AmneziaGeo.Routing\AmneziaGeo.Routing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AndroidNativeLibrary Include="native\arm64-v8a\libamneziawg-go.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
    <!-- Android TV boxes still ship 32-bit only. -->
    <AndroidNativeLibrary Include="native\armeabi-v7a\libamneziawg-go.so">
      <Abi>armeabi-v7a</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="native\x86_64\libamneziawg-go.so">
      <Abi>x86_64</Abi>
    </AndroidNativeLibrary>
  </ItemGroup>

  <!-- Stops with build steps when the gitignored native Go engine is absent. -->
  <Target Name="CheckNativeEngine" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('%(AndroidNativeLibrary.Identity)')"
           Text="Native engine '%(AndroidNativeLibrary.Identity)' is missing (gitignored artifact). Build it first:%0A  git submodule update --init --recursive%0A  powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\tools\build-engine-android.ps1&quot;" />
  </Target>

</Project>
