<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fleet="clr-namespace:AmneziaGeo.Ui.Fleet"
             x:Class="AmneziaGeo.Ui.Fleet.FleetCardStrip"
             x:CompileBindings="True"
             x:DataType="fleet:FleetConfigItemViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="AgRoleCaretGeometry">M7,10L12,15L17,10Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Бейдж повторяет плашки карточки: у несущего машину цвет действия, у прочих мест серый. -->
    <Style Selector="Button.rolebadge">
      <Setter Property="Background" Value="{DynamicResource AgInsetBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AgMutedBrush}" />
    </Style>
    <Style Selector="Button.rolebadge.primary">
      <Setter Property="Foreground" Value="{DynamicResource AgAccentBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- Место туннеля: подпись и бейдж под ней, список мест падает из бейджа. -->
  <StackPanel Spacing="3" HorizontalAlignment="Left">
    <TextBlock Text="{Binding SlotLabel}" Classes="muted" FontSize="11.5" />
    <Button Classes="rolebadge" Classes.primary="{Binding IsPrimary}" IsEnabled="{Binding RolesFree}"
            HorizontalAlignment="Left" Click="OnPickSlot">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Text="{Binding SlotText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
        <PathIcon Data="{StaticResource AgRoleCaretGeometry}" Width="9" Height="9" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
  </StackPanel>
</UserControl>
