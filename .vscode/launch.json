{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Windows",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build Windows",
      "program": "${workspaceFolder}/amneziageo-windows/tools/AmneziaGeo.Windows.Launcher/bin/Debug/net10.0/AmneziaGeo.dll",
      "cwd": "${workspaceFolder}/amneziageo-windows/tools/AmneziaGeo.Windows.Launcher/bin/Debug/net10.0",
      "console": "internalConsole",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Attach Windows",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "Debug Android",
      "type": "mono",
      "request": "attach",
      "preLaunchTask": "Build Android",
      "address": "localhost",
      "port": 10000
    },
    {
      "name": "Attach Android",
      "type": "mono",
      "request": "attach",
      "address": "localhost",
      "port": 10000
    },
    {
      // Component, its command line and elevation come from .vscode/debug.linux.jsonc.
      // The task builds the tree and holds the component until this attaches.
      "name": "Debug Linux",
      "type": "coreclr",
      "request": "attach",
      "preLaunchTask": "Run Linux",
      "processName": "amneziageo-dbg",
      "pipeTransport": {
        "pipeCwd": "${workspaceFolder}",
        "pipeProgram": "${workspaceFolder}/.vscode/vsdbg-pipe.sh",
        "pipeArgs": [],
        "debuggerPath": "vsdbg",
        "quoteArgs": false
      }
    },
    {
      // Any component already running: the agent, the UI or the console client.
      "name": "Attach Linux",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeCwd": "${workspaceFolder}",
        "pipeProgram": "${workspaceFolder}/.vscode/vsdbg-pipe.sh",
        "pipeArgs": [],
        "debuggerPath": "vsdbg",
        "quoteArgs": false
      }
    }
  ]
}
