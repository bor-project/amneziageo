<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             x:Class="AmneziaGeo.Ui.Controls.ServerRow"
             x:CompileBindings="True"
             x:DataType="vm:ConfigItemViewModel"
             ClipToBounds="True">
  <UserControl.Resources>
    <StreamGeometry x:Key="AgRowEditGeometry">M20.71 7.04c.39-.39.39-1.04 0-1.41l-2.34-2.34c-.37-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83zM3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z</StreamGeometry>
    <StreamGeometry x:Key="AgRowDeleteGeometry">M9 3v1H4v2h1v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V6h1V4h-5V3H9zm0 5h2v9H9V8zm4 0h2v9h-2V8z</StreamGeometry>
    <StreamGeometry x:Key="AgRowConfirmGeometry">M21 7L9 19l-5.5-5.5 1.41-1.41L9 16.17 19.59 5.59 21 7z</StreamGeometry>
    <StreamGeometry x:Key="AgRowCancelGeometry">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
  </UserControl.Resources>

  <Panel>
    <!-- Connect under the row, pinned left and uncovered by the swipe to the right: a bare glyph like the pair
         on the other side, in the drop colour on the configuration the tunnel already carries. It takes focus
         only while the row is out of its way. -->
    <Grid x:Name="ConnectPart" HorizontalAlignment="Left" Margin="2,0,0,0">
      <Button Classes="rowact" Classes.drop="{Binding ShowStatusFrame}" Width="60"
              Focusable="{Binding ConnectOpen}" ToolTip.Tip="{Binding RowActionText}"
              Command="{Binding $parent[controls:ServerRow].ConnectCommand}" CommandParameter="{Binding}">
        <Border Classes="rowactcard">
          <PathIcon Data="{DynamicResource AgPowerGeometry}" Width="19" Height="19"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Foreground="{Binding $parent[Button].Foreground}" />
        </Border>
      </Button>
    </Grid>

    <!-- Actions under the row, pinned right and uncovered by the swipe: bare glyphs whose colour, not a fill,
         carries the meaning. Both pairs hold the same footprint, so arming the delete does not move the row;
         they take focus only while the row is open. The buttons tile the strip edge to edge and carry their card
         inside, so a finger landing beside a glyph still presses it. -->
    <Grid x:Name="ActionsPart" HorizontalAlignment="Right" ColumnDefinitions="Auto,Auto"
          Margin="0,0,2,0">
      <Button Grid.Column="0" Classes="rowact" Width="60" Focusable="{Binding SwipeOpen}"
              IsVisible="{Binding !DeletePending}" ToolTip.Tip="{l:Tr Main_EditButton}"
              Command="{Binding $parent[controls:ServerRow].EditCommand}" CommandParameter="{Binding}">
        <Border Classes="rowactcard">
          <PathIcon Data="{StaticResource AgRowEditGeometry}" Width="19" Height="19"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Foreground="{Binding $parent[Button].Foreground}" />
        </Border>
      </Button>
      <Button Grid.Column="1" Classes="rowact drop" Width="60" Focusable="{Binding SwipeOpen}"
              IsVisible="{Binding !DeletePending}" ToolTip.Tip="{l:Tr Main_ConfirmDeleteButton}"
              Command="{Binding RequestDeleteCommand}">
        <Border Classes="rowactcard">
          <PathIcon Data="{StaticResource AgRowDeleteGeometry}" Width="19" Height="19"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Foreground="{Binding $parent[Button].Foreground}" />
        </Border>
      </Button>
      <Button Grid.Column="0" Classes="rowact drop" Width="60" Focusable="{Binding SwipeOpen}"
              IsVisible="{Binding DeletePending}" ToolTip.Tip="{l:Tr Main_ConfirmButton}"
              Command="{Binding $parent[controls:ServerRow].DeleteCommand}" CommandParameter="{Binding}">
        <Border Classes="rowactcard">
          <PathIcon Data="{StaticResource AgRowConfirmGeometry}" Width="20" Height="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Foreground="{Binding $parent[Button].Foreground}" />
        </Border>
      </Button>
      <Button Grid.Column="1" Classes="rowact" Width="60" Focusable="{Binding SwipeOpen}"
              IsVisible="{Binding DeletePending}" ToolTip.Tip="{l:Tr Main_CancelButton}"
              Command="{Binding CancelDeleteCommand}">
        <Border Classes="rowactcard">
          <PathIcon Data="{StaticResource AgRowCancelGeometry}" Width="19" Height="19"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Foreground="{Binding $parent[Button].Foreground}" />
        </Border>
      </Button>
    </Grid>

    <!-- The row itself: picks the configuration and measures it, leaving the tunnel to the connect button. -->
    <Button x:Name="FacePart" Classes="serverrow"
            Command="{Binding $parent[controls:ServerRow].SelectCommand}" CommandParameter="{Binding}"
            ToolTip.Tip="{l:Tr Main_ServerRowSelect}">
      <Panel>
        <Grid ColumnDefinitions="*,Auto" Margin="11,7">
          <StackPanel x:Name="TextPart" Grid.Column="0" VerticalAlignment="Center">
            <TextBlock x:Name="NamePart" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="EndpointPart" Text="{Binding Endpoint}" FontSize="11" Classes="muted mono"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding ProbeText}" Foreground="{Binding ProbeBrush}"
                     FontSize="11.5" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>
        <!-- Frame in the connection colour on the configuration the tunnel is bound to, grey on the one the
             user picked. -->
        <Border BorderThickness="1" CornerRadius="12" IsHitTestVisible="False"
                BorderBrush="{Binding StatusBrush}" IsVisible="{Binding ShowStatusFrame}" />
        <Border BorderThickness="1" CornerRadius="12" IsHitTestVisible="False"
                BorderBrush="{DynamicResource AgMutedBrush}" IsVisible="{Binding ShowOpenFrame}" />
      </Panel>
    </Button>
  </Panel>
</UserControl>
