<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             x:Class="AmneziaGeo.Ui.Views.ProbeSettingsView"
             x:CompileBindings="True"
             x:DataType="vm:ProbeSettingsViewModel">
  <!-- What a probe measures the speed against. A screen of its own: the journal head carries the run, not the
       settings behind it. With no section heading above it, the card carries the top inset itself. -->
  <StackPanel Spacing="14" Margin="0,8,0,0">
    <Border Classes="sect">
      <StackPanel Spacing="8">
        <TextBlock Text="{l:Tr Probe_UploadServiceTitle}" FontWeight="SemiBold" FontSize="15"
                   TextWrapping="Wrap" />
        <TextBlock Text="{l:Tr Probe_UploadServiceHint}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
        <TextBox Classes="field" Text="{Binding UploadUrl, Mode=TwoWay}"
                 Watermark="{Binding UploadDefault}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
