<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:views="clr-namespace:AmneziaGeo.Ui.Views"
             xmlns:svc="clr-namespace:AmneziaGeo.Ui.Services"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             x:Class="AmneziaGeo.Ui.Views.GeneralView"
             x:CompileBindings="True"
             x:DataType="vm:GeneralViewModel">
   <UserControl.Resources>
     <StreamGeometry x:Key="AgBackGeometry">M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20z</StreamGeometry>
     <StreamGeometry x:Key="AgDownloadGeometry">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</StreamGeometry>
     <StreamGeometry x:Key="AgUploadGeometry">M9 16h6v-6h4l-7-7-7 7h4v6zm-4 2h14v2H5v-2z</StreamGeometry>
   </UserControl.Resources>
   <Panel>

     <!-- MAIN general page. -->
     <StackPanel IsVisible="{Binding IsGeneralMain}" Spacing="14">
       <TextBlock Classes="section" Text="{l:Tr General_Section}" />

       <!-- One frame around the whole settings block; below the card width it goes and the hairlines carry the boundaries. -->
       <Border Classes="sect">
         <StackPanel Spacing="14">

           <!-- Appearance: theme + language (live switch). -->
           <StackPanel Spacing="12">
             <TextBlock Text="{l:Tr Main_AppearanceTitle}" FontWeight="SemiBold" FontSize="15" />

             <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="12">
               <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Tr General_Theme}" FontSize="13.5" VerticalAlignment="Center" />
               <controls:AdaptiveComboBox Grid.Row="0" Grid.Column="1" Classes="field" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                         ItemsSource="{Binding Themes}"
                         SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}" />
               <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Tr General_Language}" FontSize="13.5" VerticalAlignment="Center" />
               <controls:AdaptiveComboBox Grid.Row="1" Grid.Column="1" Classes="field" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                         ItemsSource="{Binding Languages}"
                         SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}" />
             </Grid>
           </StackPanel>

           <!-- About: versions + app self-update. -->
           <StackPanel Spacing="12">
             <!-- Narrow screen: a hairline carries the boundary the card frame used to. -->
             <Border Classes="hairline" />
             <TextBlock Text="{l:Tr About_Section}" FontWeight="SemiBold" FontSize="15" />

             <!-- Each value stands under its label, left-aligned. -->
             <StackPanel Spacing="2">
               <TextBlock Text="{l:Tr About_Version}" FontSize="13.5" />
               <TextBlock Text="{Binding AppVersion}" Classes="muted mono" FontSize="12.5"
                          HorizontalAlignment="Left" TextWrapping="Wrap" />
             </StackPanel>

             <StackPanel Spacing="2">
               <TextBlock Text="{l:Tr Main_AmneziaEngineVersion}" FontSize="13.5" />
               <TextBlock Text="{Binding AmneziaVersion}" Classes="muted mono" FontSize="12.5"
                          HorizontalAlignment="Left" TextWrapping="Wrap" />
             </StackPanel>

             <StackPanel Spacing="2" IsVisible="{Binding HasBuildType}">
               <TextBlock Text="{l:Tr About_BuildType}" FontSize="13.5" />
               <TextBlock Text="{Binding BuildType}" Classes="muted mono" FontSize="12.5"
                          HorizontalAlignment="Left" TextWrapping="Wrap" />
             </StackPanel>

             <StackPanel Spacing="2">
               <TextBlock Text="{l:Tr About_Source}" FontSize="13.5" />
               <!-- The link keeps the padding that carries the focus ring, and a margin of the same size puts
                    its text under the label. -->
               <Button Classes="linkbtn" FontSize="12.5" HorizontalAlignment="Left" Margin="-7,0,0,0"
                       Click="OnOpenProjectPage">
                 <TextBlock Text="{Binding ProjectUrl}" TextWrapping="Wrap" />
               </Button>
             </StackPanel>

             <!-- Update sub-block: found -> downloading -> downloaded; installing is an explicit second click (#154). -->
             <StackPanel Spacing="9" IsVisible="{Binding HasUpdateUrl}">
               <Border BorderBrush="{DynamicResource AgBorderBrush}" BorderThickness="0,1,0,0" Margin="0,2,0,0" />
               <TextBlock Text="{l:Tr Main_UpdateSection}" FontWeight="SemiBold" FontSize="13.5" />
               <!-- Тумблер стоит в строке подписи: отдельная строка под ней стоила экрана на телефоне. -->
               <controls:SettingSwitchRow Label="{l:Tr General_AllowPrerelease}"
                                          Description="{l:Tr General_AllowPrereleaseHint}"
                                          IsChecked="{Binding AllowPrerelease, Mode=TwoWay}" />
               <TextBlock Text="{Binding UpdateVersionBadgeText}" FontSize="13" FontWeight="SemiBold"
                          IsVisible="{Binding UpdateAvailable}" />
               <!-- The buttons stand under the status line. -->
               <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="8">
                 <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Spacing="2">
                   <TextBlock Text="{Binding UpdateStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                              IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                   <TextBlock Text="{Binding UpdateDescription}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                              IsVisible="{Binding UpdateAvailable}" />
                 </StackPanel>
                 <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8"
                             VerticalAlignment="Center">
                   <Button Classes="softbtn" Content="{l:Tr Main_CheckUpdatesButton}" Command="{Binding CheckUpdateCommand}"
                           IsVisible="{Binding ShowCheckUpdateButton}" />
                   <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding UpdateAvailable}">
                     <TextBlock Text="{Binding UpdateDownloadPercent, StringFormat='{}{0}%'}" Classes="muted"
                                FontSize="12" VerticalAlignment="Center" Width="36" TextAlignment="Right"
                                IsVisible="{Binding DownloadActive}" />
                     <Button Classes="accent" Content="{l:Tr Main_DownloadButton}" Command="{Binding DownloadUpdateCommand}"
                             IsVisible="{Binding ShowDownloadButton}" />
                     <Button Classes="softbtn" Content="{l:Tr Main_CancelButton}" Command="{Binding CancelDownloadCommand}"
                             IsVisible="{Binding DownloadActive}" />
                     <Button Classes="accent" Content="{l:Tr Main_InstallButton}" Command="{Binding ApplyUpdateCommand}"
                             IsVisible="{Binding UpdateDownloaded}" IsEnabled="{Binding !UpdateInstalling}" />
                   </StackPanel>
                 </StackPanel>
               </Grid>
             </StackPanel>
           </StackPanel>

           <Border Height="1" Background="{DynamicResource AgBorderBrush}" IsVisible="{Binding ShowRepairDivider}" />

           <!-- Network repair: elevated one-shot that clears a leftover DNS redirect so the internet works
                again after a failed connect or a removal stranded the resolver. Windows only. -->
           <!-- The button stands under the hint. -->
           <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10"
                 IsVisible="{Binding CanRepairNetwork}">
             <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6" VerticalAlignment="Center">
               <TextBlock Text="{l:Tr General_NetworkRepairSection}" FontWeight="SemiBold" FontSize="15" />
               <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" Text="{l:Tr General_NetworkRepairHint}" />
               <TextBlock Text="{Binding NetworkRepairStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                          IsVisible="{Binding NetworkRepairStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
             </StackPanel>
             <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                         HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
               <Button Classes="softbtn" Padding="16,7" HorizontalAlignment="Stretch"
                       Command="{Binding RepairNetworkCommand}" Content="{l:Tr General_NetworkRepairButton}" />
             </StackPanel>
           </Grid>

           <Border Classes="hairline" />

           <!-- Import / export (full width): hint left, actions right. Opens the bundle sub-views inline. -->
           <!-- The export / import buttons stand under the hint. -->
           <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10">
             <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6" VerticalAlignment="Center">
               <TextBlock Text="{l:Tr Main_ImportExportSection}" FontWeight="SemiBold" FontSize="15" />
               <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" Text="{l:Tr Main_BundleHint}" />
             </StackPanel>
             <!-- Compact splits export / import evenly across the row; wide keeps them at their own width. -->
             <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,*" ColumnSpacing="8" VerticalAlignment="Center"
                   HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
               <Button Grid.Column="0" Classes="softbtn" Padding="16,7" HorizontalAlignment="Stretch"
                       Width="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w130}"
                       Command="{Binding OpenBundleExportCommand}">
                 <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                   <PathIcon Data="{StaticResource AgDownloadGeometry}" Width="15" Height="15" />
                   <TextBlock Text="{l:Tr Main_ExportButton}" />
                 </StackPanel>
               </Button>
               <Button Grid.Column="1" Classes="softbtn" Padding="16,7" HorizontalAlignment="Stretch"
                       Width="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w130}"
                       Command="{Binding OpenBundleImportCommand}">
                 <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                   <PathIcon Data="{StaticResource AgUploadGeometry}" Width="15" Height="15" />
                   <TextBlock Text="{l:Tr Main_ImportButton}" />
                 </StackPanel>
               </Button>
             </Grid>
           </Grid>

           <Border Classes="hairline" />

           <!-- Diagnostics archive: what support asks for. The agent builds the zip under its own account and
                names it here; the button then saves a copy where the user picks. -->
           <!-- The button stands under the hint. -->
           <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10">
             <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6" VerticalAlignment="Center">
               <TextBlock Text="{l:Tr General_DiagnosticsSection}" FontWeight="SemiBold" FontSize="15" />
               <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" Text="{l:Tr General_DiagnosticsHint}" />
               <TextBlock Text="{Binding DiagnosticsStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                          IsVisible="{Binding DiagnosticsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
             </StackPanel>
             <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                         HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
               <Button Classes="softbtn" Padding="16,7" HorizontalAlignment="Stretch"
                       IsEnabled="{Binding !DiagnosticsRunning}" Click="OnCollectDiagnostics">
                 <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                   <PathIcon Data="{StaticResource AgDownloadGeometry}" Width="15" Height="15" />
                   <TextBlock Text="{l:Tr General_DiagnosticsButton}" />
                 </StackPanel>
               </Button>
             </StackPanel>
           </Grid>

         </StackPanel>
       </Border>
     </StackPanel>

     <!-- BUNDLE EXPORT sub-view. -->
     <StackPanel IsVisible="{Binding IsBundleExport}" Spacing="14">
       <StackPanel Orientation="Horizontal" Spacing="8">
         <Button Classes="icon" Padding="6,4" Command="{Binding CloseBundleCommand}">
           <PathIcon Data="{StaticResource AgBackGeometry}" Width="18" Height="18" Foreground="{DynamicResource AgMutedBrush}" />
         </Button>
         <TextBlock Classes="section" Text="{l:Tr BundleExport_WindowTitle}" VerticalAlignment="Center" />
       </StackPanel>
       <views:BundleExportView DataContext="{Binding BundleExport}" />
     </StackPanel>

     <!-- BUNDLE IMPORT sub-view. -->
     <StackPanel IsVisible="{Binding IsBundleImport}" Spacing="14">
       <StackPanel Orientation="Horizontal" Spacing="8">
         <Button Classes="icon" Padding="6,4" Command="{Binding CloseBundleCommand}">
           <PathIcon Data="{StaticResource AgBackGeometry}" Width="18" Height="18" Foreground="{DynamicResource AgMutedBrush}" />
         </Button>
         <TextBlock Classes="section" Text="{l:Tr BundleImport_WindowTitle}" VerticalAlignment="Center" />
       </StackPanel>
       <views:BundleImportView DataContext="{Binding BundleImport}" />
     </StackPanel>

   </Panel>
</UserControl>
