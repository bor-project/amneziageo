#!/bin/sh
set -e

DATA=/var/lib/amneziageo
UNIT=amneziageo-agent.service
LEGACY=/etc/systemd/system/amneziageo-agent.service

case "$1" in
  configure)
    mkdir -p "$DATA"
    chmod 700 "$DATA"

    if [ -e "$LEGACY" ]; then
      echo "amneziageo: $LEGACY shadows the packaged unit; remove it and run 'systemctl daemon-reload'" >&2
    fi

    # The agent runs after every install; it enables its unit at boot itself while survive-reboot is on.
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
      if systemctl is-active --quiet "$UNIT"; then
        echo "amneziageo: restarting the agent drops the tunnel until it dials again"
      fi
      systemctl restart "$UNIT" || true
    fi
    ;;
esac

exit 0
