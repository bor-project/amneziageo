<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AmneziaGeo.Ui.Controls.NumberField"
             Width="80">
  <UserControl.Resources>
    <StreamGeometry x:Key="AgSpinUpGeometry">M6,3 L11,9 L1,9 Z</StreamGeometry>
    <StreamGeometry x:Key="AgSpinDownGeometry">M1,3 L11,3 L6,9 Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Стрелки шага стоят в правом краю поля: своей рамки и фона не носят, фокус не берут. -->
    <Style Selector="RepeatButton.spin">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="13" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="RepeatButton.spin:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AgPanel2Brush}" />
    </Style>
    <Style Selector="RepeatButton.spin:pressed">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <TextBox x:Name="BoxPart" Classes="field" Padding="9,7,23,7" HorizontalAlignment="Stretch" />
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" Spacing="1">
      <RepeatButton x:Name="UpPart" Classes="spin" Focusable="False" IsTabStop="False">
        <PathIcon Data="{StaticResource AgSpinUpGeometry}" Width="8" Height="8"
                  Foreground="{DynamicResource AgMutedBrush}" />
      </RepeatButton>
      <RepeatButton x:Name="DownPart" Classes="spin" Focusable="False" IsTabStop="False">
        <PathIcon Data="{StaticResource AgSpinDownGeometry}" Width="8" Height="8"
                  Foreground="{DynamicResource AgMutedBrush}" />
      </RepeatButton>
    </StackPanel>
  </Panel>
</UserControl>
