<Project>
  <PropertyGroup>
    <_XrayInputRoot>$(MSBuildThisFileDirectory)</_XrayInputRoot>
  </PropertyGroup>
  <UsingTask TaskName="VerifyPinnedXrayRuntime" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <InputRoot ParameterType="System.String" Required="true" />
      <CacheRoot ParameterType="System.String" Required="true" />
      <TargetOS ParameterType="System.String" Required="true" />
      <TargetArch ParameterType="System.String" Required="true" />
      <RuntimeDirectory ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        byte[] Normalize(byte[] value) => Encoding.UTF8.GetBytes(Encoding.UTF8.GetString(value).Replace("\r\n", "\n"));
        string Digest(byte[] value)
        {
            using (var hash = SHA256.Create())
            {
                return BitConverter.ToString(hash.ComputeHash(value)).Replace("-", "").ToLowerInvariant();
            }
        }
        Dictionary<string, string> ReadValues(string path)
        {
            var lines = Encoding.UTF8.GetString(Normalize(File.ReadAllBytes(path))).Split('\n');
            var result = new Dictionary<string, string>(StringComparer.Ordinal);
            for (var index = 0; index < lines.Length; index++)
            {
                if (index == lines.Length - 1 && lines[index].Length == 0)
                {
                    continue;
                }

                var parts = lines[index].Split(new[] { '=' }, 2);
                if (parts.Length != 2 || parts.Any(part => part.Length == 0 || part != part.Trim() || part.Any(char.IsControl))
                    || result.ContainsKey(parts[0]))
                {
                    throw new InvalidDataException("The Xray metadata row is invalid.");
                }

                result.Add(parts[0], parts[1]);
            }

            return result;
        }
        try
        {
            var input = Path.GetFullPath(InputRoot);
            var manifest = ReadValues(Path.Combine(input, "manifest.txt"));
            var manifestKeys = new[] { "schema", "version", "revision", "sourceCommit", "sourceArchiveUrl", "sourceArchiveSha256", "goVersion", "workerPath", "workerBeforeSha256", "workerAfterSha256", "patchSha256", "queueBytes", "patchFileCount" };
            var patchPaths = new[] { "app/proxyman/inbound/worker.go", "common/udppressure/reporter.go", "common/udppressure/reporter_test.go",
                "transport/internet/udp/discard_reporter_test.go", "transport/internet/udp/hub.go", "transport/pipe/discard_reporter_test.go", "transport/pipe/impl.go", "transport/pipe/pipe.go" };
            var addedPaths = new HashSet<string>(new[] { "common/udppressure/reporter.go", "common/udppressure/reporter_test.go",
                "transport/internet/udp/discard_reporter_test.go", "transport/pipe/discard_reporter_test.go" }, StringComparer.Ordinal);
            if (manifest.Count != manifestKeys.Length + patchPaths.Length * 3 || manifestKeys.Any(key => !manifest.ContainsKey(key))
                || manifest["schema"] != "2" || manifest["revision"] != "ag716.2" || manifest["patchFileCount"] != "8" || manifest["version"] != "26.10.31" || manifest["goVersion"] != "go1.27.3"
                || manifest["queueBytes"] != "262144" || manifest["workerPath"] != "app/proxyman/inbound/worker.go"
                || !Regex.IsMatch(manifest["revision"], "^[a-zA-Z0-9.-]+$")
                || !Regex.IsMatch(manifest["sourceCommit"], "^[0-9a-f]{40}$")
                || manifest["sourceArchiveUrl"] != "https://codeload.github.com/XTLS/Xray-core/tar.gz/" + manifest["sourceCommit"]
                || new[] { "sourceArchiveSha256", "workerBeforeSha256", "workerAfterSha256", "patchSha256" }.Any(key => !Regex.IsMatch(manifest[key], "^[0-9a-f]{64}$")))
            {
                throw new InvalidDataException("The pinned Xray manifest is invalid.");
            }

            for (var index = 0; index < patchPaths.Length; index++)
            {
                var prefix = "patch." + index + ".";
                if (!manifest.TryGetValue(prefix + "path", out var path) || path != patchPaths[index]
                    || !manifest.TryGetValue(prefix + "beforeSha256", out var before)
                    || (addedPaths.Contains(path) ? before != "absent" : !Regex.IsMatch(before, "^[0-9a-f]{64}$"))
                    || !manifest.TryGetValue(prefix + "afterSha256", out var after) || !Regex.IsMatch(after, "^[0-9a-f]{64}$"))
                {
                    throw new InvalidDataException("The pinned Xray patched file differs.");
                }
            }

            if (manifest["patch.0.path"] != manifest["workerPath"]
                || manifest["patch.0.beforeSha256"] != manifest["workerBeforeSha256"] || manifest["patch.0.afterSha256"] != manifest["workerAfterSha256"])
            {
                throw new InvalidDataException("The pinned Xray worker aliases differ.");
            }

            if ((TargetOS != "windows" && TargetOS != "linux") || (TargetArch != "amd64" && TargetArch != "arm64"))
            {
                throw new InvalidDataException("The Xray runtime target is invalid.");
            }

            var names = Directory.EnumerateFiles(input, "*", SearchOption.AllDirectories)
                .Select(file => new { File = file, Name = file.Substring(input.TrimEnd(Path.DirectorySeparatorChar).Length + 1).Replace('\\', '/') })
                .Where(file => (file.Name.EndsWith(".go", StringComparison.Ordinal)
                    && (file.Name.IndexOf('/') < 0 || file.Name.StartsWith("cmd/xray-build/", StringComparison.Ordinal) && file.Name.Substring("cmd/xray-build/".Length).IndexOf('/') < 0))
                    || file.Name == "go.mod" || file.Name == "go.sum" || file.Name == "manifest.txt"
                    || file.Name == "udp-worker-queue.patch" || file.Name == "SOURCE.md")
                .OrderBy(file => file.Name, StringComparer.Ordinal).ToArray();
            var source = new StringBuilder("amneziageo.xray-runtime.v2\n");
            foreach (var file in names)
            {
                source.Append(file.Name).Append('\0').Append(Digest(Normalize(File.ReadAllBytes(file.File)))).Append('\n');
            }

            var patch = Digest(Normalize(File.ReadAllBytes(Path.Combine(input, "udp-worker-queue.patch"))));
            if (patch != manifest["patchSha256"])
            {
                throw new InvalidDataException("The pinned Xray patch differs.");
            }

            var identity = manifest["version"] + "-" + manifest["revision"];
            var architecture = TargetArch == "amd64" ? "x64" : "arm64";
            var directory = Path.GetFullPath(Path.Combine(CacheRoot, identity, TargetOS, architecture));
            var receipt = ReadValues(Path.Combine(directory, "runtime.receipt"));
            var expected = new Dictionary<string, string>(StringComparer.Ordinal)
            {
                ["schema"] = "amneziageo.xray-runtime.v2", ["runtime.id"] = identity,
                ["source.commit"] = manifest["sourceCommit"], ["source.archive.sha256"] = manifest["sourceArchiveSha256"],
                ["worker.before.sha256"] = manifest["workerBeforeSha256"], ["worker.after.sha256"] = manifest["workerAfterSha256"],
                ["patch.sha256"] = patch, ["go.version"] = manifest["goVersion"], ["target.os"] = TargetOS, ["target.arch"] = TargetArch,
                ["inputs.sha256"] = Digest(Encoding.UTF8.GetBytes(source.ToString())),
                ["file.manifest.txt.sha256"] = Digest(Normalize(File.ReadAllBytes(Path.Combine(input, "manifest.txt")))),
                ["file.udp-worker-queue.patch.sha256"] = patch,
                ["file.SOURCE.md.sha256"] = Digest(Normalize(File.ReadAllBytes(Path.Combine(input, "SOURCE.md")))),
            };
            if (receipt.Count != 17 || expected.Any(pair => !receipt.TryGetValue(pair.Key, out var value) || value != pair.Value))
            {
                throw new InvalidDataException("The Xray runtime receipt is stale or invalid.");
            }

            var executable = TargetOS == "windows" ? "xray.exe" : "xray";
            foreach (var name in new[] { executable, "LICENSE", "README.md", "SOURCE.md", "manifest.txt", "udp-worker-queue.patch" })
            {
                if (!receipt.TryGetValue("file." + name + ".sha256", out var value) || !Regex.IsMatch(value, "^[0-9a-f]{64}$")
                    || Digest(File.ReadAllBytes(Path.Combine(directory, name))) != value)
                {
                    throw new InvalidDataException("The Xray runtime file differs: " + name);
                }
            }

            var binary = File.ReadAllBytes(Path.Combine(directory, executable));
            if (TargetOS == "windows")
            {
                if (binary.Length < 64 || binary[0] != 0x4d || binary[1] != 0x5a)
                {
                    throw new InvalidDataException("The Xray PE header is missing.");
                }

                var offset = BitConverter.ToInt32(binary, 0x3c);
                if (offset < 0 || offset > binary.Length - 6 || BitConverter.ToUInt32(binary, offset) != 0x00004550
                    || BitConverter.ToUInt16(binary, offset + 4) != (TargetArch == "arm64" ? 0xaa64 : 0x8664))
                {
                    throw new InvalidDataException("The Xray PE architecture differs.");
                }
            }
            else if (binary.Length < 20 || !binary.Take(6).SequenceEqual(new byte[] { 0x7f, 0x45, 0x4c, 0x46, 2, 1 })
                || BitConverter.ToUInt16(binary, 18) != (TargetArch == "arm64" ? 183 : 62))
            {
                throw new InvalidDataException("The Xray ELF architecture differs.");
            }

            RuntimeDirectory = directory;
        }
        catch (Exception ex)
        {
            Log.LogErrorFromException(ex, true);
            Log.LogError("Prepare the pinned patched Xray runtime with the platform tools/fetch-xray script and Go1.27.3.");
            return false;
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="EnsureXHttpRuntime" BeforeTargets="PrepareForBuild;PrepareForPublish;AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <VerifyPinnedXrayRuntime InputRoot="$(_XrayInputRoot)" CacheRoot="$(XrayCacheRoot)" TargetOS="$(XrayTargetOS)" TargetArch="$(XrayTargetArch)">
      <Output TaskParameter="RuntimeDirectory" PropertyName="_XHttpDirectory" />
    </VerifyPinnedXrayRuntime>
    <ItemGroup>
      <None Include="$(_XHttpDirectory)/$(XrayExecutable)" Link="$(XrayExecutable)" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
      <None Include="$(_XHttpDirectory)/LICENSE" Link="licenses/xray/LICENSE" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
      <None Include="$(_XHttpDirectory)/README.md" Link="licenses/xray/README.md" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
      <None Include="$(_XHttpDirectory)/SOURCE.md" Link="licenses/xray/SOURCE.md" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
      <None Include="$(_XHttpDirectory)/manifest.txt" Link="licenses/xray/manifest.txt" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
      <None Include="$(_XHttpDirectory)/udp-worker-queue.patch" Link="licenses/xray/udp-worker-queue.patch" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
      <None Include="$(_XHttpDirectory)/runtime.receipt" Link="licenses/xray/runtime.receipt" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    </ItemGroup>
  </Target>
</Project>
