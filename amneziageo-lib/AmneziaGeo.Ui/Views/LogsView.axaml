<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             xmlns:svc="clr-namespace:AmneziaGeo.Ui.Services"
             x:Class="AmneziaGeo.Ui.Views.LogsView"
             x:CompileBindings="True"
             x:DataType="vm:LogsViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="AgChevronLeftGeometry">M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z</StreamGeometry>
    <StreamGeometry x:Key="AgChevronRightGeometry">M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z</StreamGeometry>
    <StreamGeometry x:Key="AgTrashGeometry">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
    <StreamGeometry x:Key="AgDownloadGeometry">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</StreamGeometry>
    <StreamGeometry x:Key="AgShareGeometry">M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.34C15.11,18.55 15.08,18.77 15.08,19C15.08,20.61 16.39,21.91 18,21.91C19.61,21.91 20.92,20.61 20.92,19A2.92,2.92 0 0,0 18,16.08Z</StreamGeometry>
    <StreamGeometry x:Key="AgSearchGeometry">M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</StreamGeometry>
    <StreamGeometry x:Key="AgDocGeometry">M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z</StreamGeometry>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- Narrow screen: the body frame only takes width off the cards, which carry their own. -->
    <Style Selector="Border.logbody.bare">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
  </UserControl.Styles>
  <!-- Shared segment+source header, then a single content area; only the log body scrolls. -->
  <Grid RowDefinitions="Auto,*" RowSpacing="14">

    <!-- Shared header: view/settings segment + source picker, common to both panes. -->
    <!-- Wide: segment left, source right on one row; the caption sits ahead of the combo. -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding !IsCompact}">
      <Border Grid.Column="0" Classes="segtrack sub" VerticalAlignment="Center">
        <UniformGrid Columns="2">
          <Button Classes="seg" Classes.active="{Binding IsViewMode}" Command="{Binding ShowViewCommand}"
                  Content="{l:Tr Main_LogTabView}" />
          <Button Classes="seg" Classes.active="{Binding IsSettingsMode}" Command="{Binding ShowSettingsCommand}"
                  Content="{l:Tr Main_LogTabSettings}" />
        </UniformGrid>
      </Border>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{l:Tr Main_LogTypeLabel}" Classes="muted" FontSize="11.5" VerticalAlignment="Center" />
        <controls:AdaptiveComboBox Classes="field" Width="140"
                  ItemsSource="{Binding LogTypes}" SelectedItem="{Binding SelectedLogType, Mode=TwoWay}" />
      </StackPanel>
    </Grid>

    <!-- Narrow: segment then source stacked. -->
    <StackPanel Grid.Row="0" Spacing="10" IsVisible="{Binding IsCompact}">
      <Border Classes="segtrack sub">
        <UniformGrid Columns="2">
          <Button Classes="seg" Classes.active="{Binding IsViewMode}" Command="{Binding ShowViewCommand}"
                  Content="{l:Tr Main_LogTabView}" />
          <Button Classes="seg" Classes.active="{Binding IsSettingsMode}" Command="{Binding ShowSettingsCommand}"
                  Content="{l:Tr Main_LogTabSettings}" />
        </UniformGrid>
      </Border>
      <!-- Caption over a full-width picker, capped to match the settings card. -->
      <StackPanel Spacing="6" MaxWidth="420">
        <TextBlock Text="{l:Tr Main_LogTypeLabel}" Classes="muted" FontSize="11.5" HorizontalAlignment="Center" />
        <controls:AdaptiveComboBox Classes="field" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding LogTypes}" SelectedItem="{Binding SelectedLogType, Mode=TwoWay}" />
      </StackPanel>
    </StackPanel>

    <!-- Content: settings pane or viewer pane. -->
    <Panel Grid.Row="1">

      <!-- Settings pane: capture level (ageo) or on/off (routes), then log actions; stacked under the shared source. -->
      <Border IsVisible="{Binding IsSettingsMode}" VerticalAlignment="Top"
              Classes="sect" Classes.compact="{Binding IsCompact}">
        <StackPanel Spacing="18" MaxWidth="420"
                    HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
          <!-- The live source has nothing to tune: it is read from the tunnel, not captured into a table. -->
          <Panel IsVisible="{Binding IsStoredLog}">
            <!-- ageo: maximum capture level (incl. none). -->
            <StackPanel Spacing="8" IsVisible="{Binding IsAgentLog}"
                        HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
              <StackPanel Spacing="2">
                <TextBlock Text="{l:Tr Main_LogCaptureLevelTitle}" FontSize="13.5" />
                <TextBlock Text="{l:Tr Main_LogVerbosityHint}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
              </StackPanel>
              <controls:AdaptiveComboBox Classes="field"
                        MinWidth="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=minW220}"
                        HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}"
                        ItemsSource="{Binding CaptureLevels}" SelectedItem="{Binding CaptureLevel, Mode=TwoWay}" />
            </StackPanel>

            <!-- routes: on/off (no level). -->
            <controls:SettingSwitchRow IsVisible="{Binding IsRouteLog}"
                Label="{l:Tr Main_RouteLogTitle}" Description="{l:Tr Main_RouteLogHint}"
                IsChecked="{Binding RouteLogEnabled, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          </Panel>

          <Border Height="1" Background="{DynamicResource AgBorderBrush}" Opacity="0.6"
                  IsVisible="{Binding IsStoredLog}" />

          <!-- Log actions at their own width: a narrow card carries them onto the next line. -->
          <WrapPanel>
            <Button Classes="methodpick" Margin="0,0,10,10" Padding="16,8" Command="{Binding ClearLogCommand}"
                    IsVisible="{Binding IsStoredLog}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource AgTrashGeometry}" Width="14" Height="14" />
                <TextBlock Text="{l:Tr Main_ClearLogButton}" />
              </StackPanel>
            </Button>
            <Button Classes="methodpick" Margin="0,0,10,10" Padding="16,8" Click="OnExportLog">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource AgDownloadGeometry}" Width="14" Height="14" />
                <TextBlock Text="{l:Tr Main_ExportLogButton}" />
              </StackPanel>
            </Button>
            <Button Classes="methodpick" Margin="0,0,10,10" Padding="16,8" Click="OnSendLog"
                    IsVisible="{Binding CanSendExport}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource AgShareGeometry}" Width="14" Height="14" />
                <TextBlock Text="{l:Tr Main_SendToAppButton}" />
              </StackPanel>
            </Button>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Viewer pane: full-width card. Body fills the rest under the control bar. -->
      <Border IsVisible="{Binding IsViewMode}"
              Classes="sect" Classes.compact="{Binding IsCompact}">
        <Grid RowDefinitions="Auto,Auto,*">

          <!-- Wide control bar: search fills; arrows-only nav; follow. The live source has no history to
               search or to page through, so it carries the follow switch alone. -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding !IsCompact}">
            <TextBox Grid.Column="0" Classes="field" Text="{Binding SearchQuery, Mode=TwoWay}"
                     IsVisible="{Binding IsStoredLog}"
                     Watermark="{l:Tr Main_LogSearchWatermark}">
              <TextBox.InnerLeftContent>
                <PathIcon Data="{StaticResource AgSearchGeometry}" Width="14" Height="14"
                          Margin="10,0,4,0" Foreground="{DynamicResource AgMuted2Brush}" />
              </TextBox.InnerLeftContent>
              <TextBox.InnerRightContent>
                <TextBlock Text="{Binding SearchSummary}" Classes="muted" FontSize="11.5" Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           IsVisible="{Binding SearchSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </TextBox.InnerRightContent>
            </TextBox>
            <Button Grid.Column="1" Classes="methodpick" Padding="10,7" Command="{Binding PageOlderCommand}"
                    IsVisible="{Binding IsStoredLog}" ToolTip.Tip="{l:Tr Main_LogOlderTooltip}">
              <PathIcon Data="{StaticResource AgChevronLeftGeometry}" Width="14" Height="14" />
            </Button>
            <Button Grid.Column="2" Classes="methodpick" Padding="10,7" Command="{Binding PageNewerCommand}"
                    IsVisible="{Binding IsStoredLog}" ToolTip.Tip="{l:Tr Main_LogNewerTooltip}">
              <PathIcon Data="{StaticResource AgChevronRightGeometry}" Width="14" Height="14" />
            </Button>
            <TextBlock Grid.Column="3" Text="{l:Tr Main_LogFollowLabel}" Classes="muted" FontSize="11.5"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
            <ToggleSwitch Grid.Column="4" IsChecked="{Binding LogFollow, Mode=TwoWay}" VerticalAlignment="Center" />
          </Grid>

          <!-- Narrow control bar: search then nav + follow. -->
          <StackPanel Grid.Row="0" Spacing="10" IsVisible="{Binding IsCompact}">
            <TextBox Classes="field" Text="{Binding SearchQuery, Mode=TwoWay}"
                     IsVisible="{Binding IsStoredLog}"
                     Watermark="{l:Tr Main_LogSearchWatermark}">
              <TextBox.InnerLeftContent>
                <PathIcon Data="{StaticResource AgSearchGeometry}" Width="14" Height="14"
                          Margin="10,0,4,0" Foreground="{DynamicResource AgMuted2Brush}" />
              </TextBox.InnerLeftContent>
              <TextBox.InnerRightContent>
                <TextBlock Text="{Binding SearchSummary}" Classes="muted" FontSize="11.5" Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           IsVisible="{Binding SearchSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </TextBox.InnerRightContent>
            </TextBox>

            <!-- Arrows keep the nav at icon width; the caption and the switch take the free end of the row. -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
              <Grid.Resources>
                <GridLength x:Key="ToggleSwitchPreContentMargin">0</GridLength>
                <GridLength x:Key="ToggleSwitchPostContentMargin">0</GridLength>
              </Grid.Resources>
              <Button Grid.Column="0" Classes="methodpick" Padding="12,7"
                      Command="{Binding PageOlderCommand}" IsVisible="{Binding IsStoredLog}">
                <PathIcon Data="{StaticResource AgChevronLeftGeometry}" Width="14" Height="14" />
              </Button>
              <Button Grid.Column="1" Classes="methodpick" Padding="12,7"
                      Command="{Binding PageNewerCommand}" IsVisible="{Binding IsStoredLog}">
                <PathIcon Data="{StaticResource AgChevronRightGeometry}" Width="14" Height="14" />
              </Button>
              <TextBlock Grid.Column="3" Text="{l:Tr Main_LogFollowLabel}" Classes="muted" FontSize="11.5"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <ToggleSwitch Grid.Column="4" IsChecked="{Binding LogFollow, Mode=TwoWay}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>

          <!-- What the tunnel carries in one line, over the destinations it counts. -->
          <TextBlock Grid.Row="1" IsVisible="{Binding IsLiveLog}" Margin="2,12,2,0"
                     Text="{Binding LiveSummary}" TextWrapping="Wrap" FontSize="12.5"
                     Foreground="{DynamicResource AgFgBrush}" />

          <!-- Log body (shared): text / cards / empty state / loader. Fills the pane width. -->
          <Border Grid.Row="2" Classes="logbody" Classes.bare="{Binding IsCompact}"
                  Margin="0,14,0,0" BorderBrush="{DynamicResource AgBorderBrush}" BorderThickness="1"
                  Background="{DynamicResource AgInsetBrush}" CornerRadius="10">
            <Panel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            IsVisible="{Binding ShowStoredText}">
                <SelectableTextBlock Text="{Binding LogText}"
                                     FontFamily="IBM Plex Mono, Cascadia Mono, Consolas, monospace"
                                     FontSize="11.5" LineHeight="18"
                                     Foreground="{DynamicResource AgMutedBrush}"
                                     TextWrapping="Wrap" Margin="16,13" />
              </ScrollViewer>

              <!-- The destinations as a padded table: the columns only line up without wrapping. -->
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                            IsVisible="{Binding ShowLiveText}">
                <SelectableTextBlock Text="{Binding LogText}"
                                     FontFamily="IBM Plex Mono, Cascadia Mono, Consolas, monospace"
                                     FontSize="11.5" LineHeight="18"
                                     Foreground="{DynamicResource AgMutedBrush}"
                                     TextWrapping="NoWrap" Margin="16,13" />
              </ScrollViewer>

              <!-- Narrow: a card per row, so nothing has to be scrolled sideways to be read. -->
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            IsVisible="{Binding ShowStoredCards}">
                <ItemsControl ItemsSource="{Binding Entries}" Margin="0,0,0,2">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogEntryItem">
                      <Border Margin="0,0,0,8" Padding="12,9" CornerRadius="8"
                              Background="{DynamicResource AgPanel2Brush}"
                              BorderThickness="1" BorderBrush="{DynamicResource AgBorderBrush}">
                        <StackPanel Spacing="5">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Time}" FontSize="11"
                                       FontFamily="IBM Plex Mono, Cascadia Mono, Consolas, monospace"
                                       Foreground="{DynamicResource AgMuted2Brush}" VerticalAlignment="Center" />
                            <Panel IsVisible="{Binding HasLevel}">
                              <TextBlock Text="{Binding Level}" FontSize="11" FontWeight="SemiBold"
                                         IsVisible="{Binding IsAlarm}"
                                         Foreground="{DynamicResource AgDownBrush}" />
                              <TextBlock Text="{Binding Level}" FontSize="11" FontWeight="SemiBold"
                                         IsVisible="{Binding IsWarning}"
                                         Foreground="{DynamicResource AgWarnBrush}" />
                              <TextBlock Text="{Binding Level}" FontSize="11" FontWeight="SemiBold"
                                         IsVisible="{Binding IsPlain}"
                                         Foreground="{DynamicResource AgMuted2Brush}" />
                            </Panel>
                          </StackPanel>
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5"
                                     Foreground="{DynamicResource AgFgBrush}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- Narrow: a card per destination — where it goes over what it holds. -->
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            IsVisible="{Binding ShowLiveCards}">
                <ItemsControl ItemsSource="{Binding LiveRows}" Margin="0,0,0,2">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LiveRowItem">
                      <Border Margin="0,0,0,8" Padding="12,9" CornerRadius="8"
                              Background="{DynamicResource AgPanel2Brush}"
                              BorderThickness="1" BorderBrush="{DynamicResource AgBorderBrush}">
                        <Grid ColumnDefinitions="Auto,*">
                          <!-- A destination something is connected to that carries nothing wears the stripe. -->
                          <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,0,10,0"
                                  Background="{DynamicResource AgWarnBrush}" IsVisible="{Binding Stalled}" />
                          <StackPanel Grid.Column="1" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                              <TextBlock Grid.Column="0" Text="{Binding Host}" FontSize="13" FontWeight="SemiBold"
                                         TextTrimming="CharacterEllipsis"
                                         Foreground="{DynamicResource AgFgBrush}" />
                              <TextBlock Grid.Column="1" Text="{Binding Verdict}" FontSize="11.5"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource AgAccentBrush}" />
                            </Grid>
                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{DynamicResource AgMutedBrush}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <!-- Empty state. -->
              <StackPanel IsVisible="{Binding ShowEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Spacing="10" Margin="24">
                <PathIcon Data="{StaticResource AgDocGeometry}" Width="42" Height="42"
                          Foreground="{DynamicResource AgMuted2Brush}" HorizontalAlignment="Center" />
                <TextBlock Text="{l:Tr Main_LogEmptyTitle}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource AgMutedBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{l:Tr Main_LogEmptyHint}" Classes="muted" FontSize="12"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
              </StackPanel>
              <!-- Loader while a window loads. -->
              <StackPanel IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressBar IsIndeterminate="True" Width="150" HorizontalAlignment="Center" />
                <TextBlock Text="{l:Tr Main_RoutingLoading}" Classes="muted" FontSize="13" HorizontalAlignment="Center" />
              </StackPanel>
            </Panel>
          </Border>

        </Grid>
      </Border>

    </Panel>
  </Grid>
</UserControl>
