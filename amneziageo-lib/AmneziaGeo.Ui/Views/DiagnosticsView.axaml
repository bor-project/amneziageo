<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:views="clr-namespace:AmneziaGeo.Ui.Views"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             x:Class="AmneziaGeo.Ui.Views.DiagnosticsView"
             x:CompileBindings="True"
             x:DataType="vm:DiagnosticsViewModel">
  <!-- Title, pane tabs, then the selected pane; only the pane body scrolls. -->
  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">

    <TextBlock Grid.Row="0" Classes="section" Text="{l:Tr Main_DiagnosticsSection}" />

    <!-- Pane tabs: log, configuration or check. Left when wide, full width in compact. Down steps into the
         pane shown below, which directional focus walks past into the window header (#201). -->
    <controls:SegmentedSelector x:Name="PaneTabs" Grid.Row="1" KeyDown="OnTabsKeyDown"
                          Command="{Binding SelectTabCommand}" IsCompact="{Binding IsCompact}"
                          Item1Text="{l:Tr Main_DiagTabLog}" Item1Param="log" Item1Active="{Binding IsLogTab}"
                          Item2Text="{l:Tr Main_DiagTabConfig}" Item2Param="config" Item2Active="{Binding IsConfigTab}"
                          Item3Text="{l:Tr Main_DiagTabCheck}" Item3Param="check" Item3Active="{Binding IsCheckTab}" />

    <!-- Divider between the tabs and the pane. -->
    <Border Grid.Row="2" Height="1" Background="{DynamicResource AgBorderBrush}" />

    <Panel x:Name="Body" Grid.Row="3" KeyDown="OnBodyKeyDown">
      <Panel IsVisible="{Binding IsLogTab}">
        <views:LogsView DataContext="{Binding Logs}" />
      </Panel>
      <Panel IsVisible="{Binding IsConfigTab}">
        <views:RuntimeConfigView DataContext="{Binding Config}" />
      </Panel>
      <Panel IsVisible="{Binding IsCheckTab}">
        <views:CheckView DataContext="{Binding Check}" />
      </Panel>
    </Panel>

  </Grid>
</UserControl>
