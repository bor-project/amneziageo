<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             xmlns:svc="clr-namespace:AmneziaGeo.Ui.Services"
             x:Class="AmneziaGeo.Ui.Views.ConfigTransportView"
             x:CompileBindings="True"
             x:DataType="vm:ConfigTransportViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="AgEyeGeometry">M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9M12,4.5C17,4.5 21.27,7.61 23,12C21.27,16.39 17,19.5 12,19.5C7,19.5 2.73,16.39 1,12C2.73,7.61 7,4.5 12,4.5M3.18,12C4.83,15.36 8.24,17.5 12,17.5C15.76,17.5 19.17,15.36 20.82,12C19.17,8.64 15.76,6.5 12,6.5C8.24,6.5 4.83,8.64 3.18,12Z</StreamGeometry>
  </UserControl.Resources>
  <!-- MTU + WebSocket proxy editor. Fields stay left, capped so they do not stretch across a wide card. -->
  <StackPanel Spacing="14">
    <!-- The section heading carries the switch itself: a separate row under it only said the heading again. -->
    <controls:SettingSwitchRow Heading="True" Label="{l:Tr Main_ProxyWebSocketLabel}"
                               Description="{l:Tr Main_ProxyWebSocketHint}"
                               IsChecked="{Binding UseWebSocket, Mode=TwoWay}" HorizontalAlignment="Stretch"
                               IsVisible="{Binding SupportsWebSocket}" />

    <!-- A platform without wstunnel says so instead of offering a switch that cannot hold. -->
    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:Tr Android_WebSocketUnsupported}"
               IsVisible="{Binding WebSocketUnavailable}" />

    <!-- Blocks stand one under the other; each keeps its own width on a wide card. -->
    <Grid IsVisible="{Binding ShowWebSocketFields}" MaxWidth="980"
          ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto,Auto"
          HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
      <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Spacing="2"
                  Width="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w300}"
                  HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}"
                  Margin="0,0,0,10">
        <TextBlock Classes="label" Text="{l:Tr Main_ServerHostLabel}" />
        <TextBox Classes="field" Text="{Binding WebSocketHost}" Watermark="{l:Tr Main_ServerHostWatermark}" />
      </StackPanel>
      <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="Auto,*"
            HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}"
            Margin="0,0,0,10">
        <StackPanel Grid.Column="0" Width="100" Spacing="2" Margin="0,0,12,0">
          <TextBlock Classes="label" Text="{l:Tr Main_ServerPortLabel}" />
          <TextBox Classes="field" Text="{Binding WebSocketPort}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="2"
                    Width="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w180}"
                    HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
          <TextBlock Classes="label" Text="{l:Tr Main_AuthLabel}" />
          <controls:AdaptiveComboBox Classes="field" HorizontalAlignment="Stretch" SelectedIndex="{Binding AuthMode, Mode=TwoWay}">
            <ComboBoxItem Content="{l:Tr Main_AuthNone}" />
            <ComboBoxItem Content="{l:Tr Main_AuthBasic}" />
            <ComboBoxItem Content="{l:Tr Main_AuthToken}" />
          </controls:AdaptiveComboBox>
        </StackPanel>
      </Grid>
      <Panel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10"
             HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}"
             Width="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w300}">
        <StackPanel Spacing="2" IsVisible="{Binding IsTokenAuth}">
          <TextBlock Classes="label" Text="{l:Tr Main_AccessTokenLabel}" />
          <Panel>
            <TextBox x:Name="TokenBox" Classes="field" Text="{Binding WebSocketToken}"
                     PasswordChar="●" Padding="10,7,36,7" Watermark="{l:Tr Main_AccessTokenWatermark}" />
            <Button Classes="icon" Click="OnToggleTokenReveal" MinWidth="0"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
              <PathIcon Data="{StaticResource AgEyeGeometry}" Width="15" Height="15" />
            </Button>
          </Panel>
        </StackPanel>
        <StackPanel Spacing="2" IsVisible="{Binding IsBasicAuth}">
          <TextBlock Classes="label" Text="{l:Tr Main_LoginLabel}" />
          <TextBox Classes="field" Text="{Binding WebSocketUser}" Watermark="{l:Tr Main_LoginWatermark}" />
          <TextBlock Classes="label" Text="{l:Tr Main_PasswordLabel}" Margin="0,4,0,0" />
          <TextBox Classes="field" Text="{Binding WebSocketPassword}" PasswordChar="●" Watermark="{l:Tr Main_PasswordWatermark}" />
        </StackPanel>
      </Panel>
    </Grid>

    <!-- The front's answer to the address just typed. It holds nothing back: it says what will not work. -->
    <TextBlock Text="{Binding ProbeMessage}" FontSize="12" TextWrapping="Wrap" MaxWidth="980" Margin="0,-6,0,0"
               HorizontalAlignment="Left"
               Classes.muted="{Binding IsProbing}" Classes.fieldwarn="{Binding ProbeFailed}"
               IsVisible="{Binding ProbeMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <!-- Narrow screen: a hairline carries the section boundary the frame used to. -->
    <Border Height="1" Background="{DynamicResource AgBorderBrush}" IsVisible="{Binding IsCompact}" />

    <!-- The box stands beside its heading, where a switch stands in the rows around it. -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="40" HorizontalAlignment="Stretch">
      <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{l:Tr Main_TunnelMtuLabel}" FontWeight="SemiBold" FontSize="15" />
        <TextBlock Classes="muted" FontSize="11.5" TextWrapping="Wrap" Text="{l:Tr Main_MtuHint}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <controls:AdaptiveComboBox Classes="field" Width="132" SelectedIndex="{Binding MtuMode, Mode=TwoWay}">
          <ComboBoxItem Content="{l:Tr Main_MtuModeAuto}" />
          <ComboBoxItem Content="{l:Tr Main_MtuModeConfig}" />
          <ComboBoxItem Content="{l:Tr Main_MtuModeCustom}" />
        </controls:AdaptiveComboBox>
        <TextBox Classes="field" Width="90" IsReadOnly="{Binding IsMtuReadOnly}"
                 controls:NumericInput.Minimum="576" controls:NumericInput.Maximum="1500" Text="{Binding Mtu}" />
      </StackPanel>
    </Grid>

    <Border Height="1" Background="{DynamicResource AgBorderBrush}" IsVisible="{Binding IsCompact}" />

    <controls:SettingSwitchRow Heading="True" Label="{l:Tr Main_UseIpv6Title}" Description="{l:Tr Main_UseIpv6Hint}"
                               IsChecked="{Binding UseIpv6, Mode=TwoWay}" HorizontalAlignment="Stretch" />

    <TextBlock Text="{Binding StatusMessage}" Classes="fieldwarn" FontSize="12" TextWrapping="Wrap"
               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>
