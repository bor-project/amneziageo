<Project Sdk="Microsoft.NET.Sdk">

  <!-- Native engine deps (tunnel.dll/wintun.dll): not-built guard. -->
  <Import Project="..\..\Engine.targets" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- This is the shipped single-process product (agent in-process + tray UI). -->
    <AssemblyName>AmneziaGeo</AssemblyName>
    <!-- Elevate on a manual (shortcut) launch via UAC. Release only, so a Debug `dotnet run` from an
         already-elevated dev shell is not blocked by the requireAdministrator linkage; the logon
         scheduled task launches the Release build elevated without a prompt. -->
    <ApplicationManifest Condition="'$(Configuration)' == 'Release'">app.manifest</ApplicationManifest>
    <!-- Icon from the installer build (installer.config.json), same contract as ui.csproj: HasIcon=false omits
         it, IconFile overrides the source. Embeds into AmneziaGeo.exe (the shipped single-process product);
         the staged Assets\AmneziaGeo.ico (carried in via the Ui project reference) feeds the MSI ARP/shortcut. -->
    <HasIcon Condition="'$(HasIcon)' == ''">true</HasIcon>
    <IconFile Condition="'$(IconFile)' == ''">..\..\AmneziaGeo.Windows.Ui\Assets\AmneziaGeo.ico</IconFile>
    <ApplicationIcon Condition="'$(HasIcon)' == 'true'">$(IconFile)</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AmneziaGeo.Windows.App\AmneziaGeo.Windows.App.csproj" />
    <ProjectReference Include="..\..\AmneziaGeo.Windows.Ui\AmneziaGeo.Windows.Ui.csproj" />
    <!-- Built so its exe can be staged next to the launcher and spawned as the standard tray flow. -->
    <ProjectReference Include="..\..\AmneziaGeo.Windows.Tray\AmneziaGeo.Windows.Tray.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Stage the tray apphost next to the launcher so RunDesktop spawns it (and it finds Ui.exe co-located).
       The tray carries its own TargetFramework, so take the path from the project instead of composing one. -->
  <Target Name="StageTray" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\AmneziaGeo.Windows.Tray\AmneziaGeo.Windows.Tray.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_TrayTarget" />
    </MSBuild>
    <ItemGroup>
      <_TrayOutput Include="%(_TrayTarget.RootDir)%(_TrayTarget.Directory)AmneziaGeo.Windows.Tray.*" />
    </ItemGroup>
    <Error Condition="'@(_TrayOutput)' == ''"
           Text="Tray build output not found; the launcher would fall back to the in-process GUI." />
    <Copy SourceFiles="@(_TrayOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Stage the GUI build over the launcher output, last. The launcher carries a Windows TargetFramework and
       so resolves the WinRT flavour of flavoured packages (CommunityToolkit.Mvvm), which the co-located
       AmneziaGeo.Windows.Ui.exe cannot load: its own deps.json names the plain one. Same rule the installer
       stage follows - the GUI publishes after the backend. -->
  <Target Name="StageUi" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\AmneziaGeo.Windows.Ui\AmneziaGeo.Windows.Ui.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_UiTarget" />
    </MSBuild>
    <ItemGroup>
      <_UiOutput Include="%(_UiTarget.RootDir)%(_UiTarget.Directory)*.dll;%(_UiTarget.RootDir)%(_UiTarget.Directory)*.exe;%(_UiTarget.RootDir)%(_UiTarget.Directory)*.json" />
    </ItemGroup>
    <Error Condition="'@(_UiOutput)' == ''"
           Text="GUI build output not found; the tray would start a GUI that cannot load." />
    <Copy SourceFiles="@(_UiOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.Development.json" Condition="Exists('appsettings.Development.json')" CopyToOutputDirectory="PreserveNewest">
      <DependentUpon>appsettings.json</DependentUpon>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\amneziawg-windows\x64\tunnel.dll" Link="tunnel.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\amneziawg-windows\.deps\wintun\bin\amd64\wintun.dll" Link="wintun.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatform">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
