<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.CAMERA" />
  <!-- Read configs the user copied into shared storage: a TV has no document picker, and scoped storage
       hides every file the app does not own. -->
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
  <!-- The all-files permission starts at API 30; older releases read shared storage through this one. -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
  <uses-feature android:name="android.software.leanback" android:required="false" />
  <uses-feature android:name="android.hardware.camera.any" android:required="false" />
  <!-- Enumerate launchable apps for the per-app routing picker without QUERY_ALL_PACKAGES. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <!-- Resolve the all-files-access screen before offering it. -->
    <intent>
      <action android:name="android.settings.MANAGE_APP_ALL_FILES_ACCESS_PERMISSION" />
      <data android:scheme="package" />
    </intent>
  </queries>
  <!-- Predictive back is off: Avalonia routes the back button through OnBackPressed, which the
       gesture callback replaces from target SDK 35 on. -->
  <!-- Opts out of scoped storage up to API 29, where READ_EXTERNAL_STORAGE alone still hides other apps' files. -->
  <application android:label="AmneziaGeo" android:icon="@mipmap/appicon" android:banner="@drawable/banner"
               android:allowBackup="false" android:enableOnBackInvokedCallback="false"
               android:requestLegacyExternalStorage="true">
    <!-- The tunnel runs in a process of its own: closing the window then unloads the head and leaves the
         tunnel alone in memory. -->
    <!-- Exports leave through a link to a cached file: an intent carries no bytes of its own. -->
    <provider android:name="androidx.core.content.FileProvider"
              android:authorities="org.amneziageo.android.files"
              android:exported="false" android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
    </provider>
    <service android:name="org.amneziageo.android.GeoVpnService"
             android:permission="android.permission.BIND_VPN_SERVICE"
             android:exported="false"
             android:process=":vpn"
             android:foregroundServiceType="specialUse">
      <intent-filter>
        <action android:name="android.net.VpnService" />
      </intent-filter>
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="vpn" />
    </service>
  </application>
</manifest>
