<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             xmlns:svc="clr-namespace:AmneziaGeo.Ui.Services"
             x:Class="AmneziaGeo.Ui.Views.ConfigTransportView"
             x:CompileBindings="True"
             x:DataType="vm:ConfigTransportViewModel">
  <!-- WebSocket, MTU and the switches of a config. Fields stay left, capped so they do not stretch across a wide card. -->
  <StackPanel Spacing="14">
    <!-- The section heading carries the switch itself: a separate row under it only said the heading again. -->
    <controls:SettingSwitchRow Heading="True" Label="{l:Tr Main_ProxyWebSocketLabel}"
                               Description="{l:Tr Main_ProxyWebSocketHint}"
                               IsChecked="{Binding WebSocketOn, Mode=TwoWay}" IsEnabled="{Binding WebSocketOpen}"
                               HorizontalAlignment="Stretch" IsVisible="{Binding SupportsWebSocket}" />

    <!-- A platform without wstunnel says so instead of offering a switch that cannot hold. -->
    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{l:Tr Android_WebSocketUnsupported}"
               IsVisible="{Binding WebSocketUnavailable}" />

    <!-- Narrow screen: a hairline carries the section boundary the frame used to. -->
    <Border Height="1" Background="{DynamicResource AgBorderBrush}" IsVisible="{Binding IsCompact}" />

    <!-- The box stands beside its heading, where a switch stands in the rows around it. A narrow card has no
         width for both, so the pair drops under the heading. -->
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" MinHeight="40" HorizontalAlignment="Stretch">
      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{l:Tr Main_TunnelMtuLabel}" FontWeight="SemiBold" FontSize="15" />
        <TextBlock Classes="muted" FontSize="11.5" TextWrapping="Wrap" Text="{l:Tr Main_MtuHint}" />
      </StackPanel>
      <StackPanel Grid.Row="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=row}"
                  Grid.Column="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=col}"
                  Grid.ColumnSpan="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=span2}"
                  Margin="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=gapTop14}"
                  Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <controls:AdaptiveComboBox Classes="field" Width="132" SelectedIndex="{Binding MtuMode, Mode=TwoWay}">
          <ComboBoxItem Content="{l:Tr Main_MtuModeAuto}" />
          <ComboBoxItem Content="{l:Tr Main_MtuModeConfig}" />
          <ComboBoxItem Content="{l:Tr Main_MtuModeCustom}" />
        </controls:AdaptiveComboBox>
        <TextBox Classes="field" Width="90" IsEnabled="{Binding !IsMtuReadOnly}"
                 controls:NumericInput.Minimum="576" controls:NumericInput.Maximum="1500" Text="{Binding Mtu}" />
      </StackPanel>
    </Grid>

    <Border Height="1" Background="{DynamicResource AgBorderBrush}" IsVisible="{Binding IsCompact}" />

    <controls:SettingSwitchRow Heading="True" Label="{l:Tr Main_UseIpv6Title}" Description="{l:Tr Main_UseIpv6Hint}"
                               IsChecked="{Binding UseIpv6, Mode=TwoWay}" HorizontalAlignment="Stretch" />

    <Border Height="1" Background="{DynamicResource AgBorderBrush}" IsVisible="{Binding IsCompact}" />

    <controls:SettingSwitchRow Heading="True" Label="{l:Tr Main_UseRoutingTitle}" Description="{l:Tr Main_UseRoutingHint}"
                               IsChecked="{Binding RoutingOn, Mode=TwoWay}" IsEnabled="{Binding RoutingOpen}"
                               HorizontalAlignment="Stretch" />

    <!-- Приём входящих по адресу этой машины в туннеле. -->
    <StackPanel Spacing="14" IsVisible="{Binding InboundAvailable}">
      <Border Height="1" Background="{DynamicResource AgBorderBrush}" IsVisible="{Binding IsCompact}" />

      <controls:SettingSwitchRow Heading="True" Label="{l:Tr Main_InboundTitle}" Description="{l:Tr Main_InboundHint}"
                                 IsChecked="{Binding AllowInbound, Mode=TwoWay}" HorizontalAlignment="Stretch" />

      <!-- Адрес этой машины в туннеле: встаёт под описанием приёма. -->
      <SelectableTextBlock Text="{Binding TunnelAddress}" FontSize="12.5" TextWrapping="Wrap"
                           Margin="0,-11,0,0" MaxWidth="430" HorizontalAlignment="Left"
                           IsVisible="{Binding ShowInboundAddress}" />
    </StackPanel>

    <!-- The router decides destinations while the session runs and costs a second pass through userspace;
         turning it off leaves the route table alone with the rules. -->
    <controls:SettingSwitchRow Heading="True" Label="{l:Tr Main_RouterTitle}" Description="{l:Tr Main_RouterHint}"
                               IsVisible="{Binding RouterAvailable}"
                               IsChecked="{Binding UseRouter, Mode=TwoWay}" HorizontalAlignment="Stretch" />

    <TextBlock Text="{Binding StatusMessage}" Classes="fieldwarn" FontSize="12" TextWrapping="Wrap"
               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>
