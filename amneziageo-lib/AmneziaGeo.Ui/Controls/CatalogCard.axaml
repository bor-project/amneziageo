<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             x:Class="AmneziaGeo.Ui.Controls.CatalogCard"
             x:CompileBindings="True"
             x:DataType="vm:ConfigItemViewModel"
             Design.DataContext="{x:Static vm:DesignData.ConfigCard}"
             Design.Width="340">
  <UserControl.Resources>
    <StreamGeometry x:Key="AgCardGearGeometry">M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z</StreamGeometry>
    <StreamGeometry x:Key="AgCardTimerGeometry">M15,1H9V3H15M11,14H13V8H11M19.03,7.39L20.45,5.97C20,5.46 19.55,5 19.04,4.56L17.62,6C16.07,4.74 14.12,4 12,4A9,9 0 0,0 3,13A9,9 0 0,0 12,22C17,22 21,17.97 21,13C21,10.88 20.26,8.93 19.03,7.39M12,20A7,7 0 0,1 5,13A7,7 0 0,1 12,6A7,7 0 0,1 19,13A7,7 0 0,1 12,20Z</StreamGeometry>
    <StreamGeometry x:Key="AgCardTrafficGeometry">M9,3L5,7H8V14H10V7H13M16,17V10H14V17H11L15,21L19,17H16Z</StreamGeometry>
    <StreamGeometry x:Key="AgCardLossGeometry">M3,13H5.79L10.1,4.79L11.28,11.5L14.5,8.75L17.29,13H21V15H16.21L14.5,12.4L10.72,15.5L9.55,8.9L7,13.85V15H3V13Z</StreamGeometry>
  </UserControl.Resources>

  <!-- Тело карточки открывает настройки двойным щелчком, остальные действия стоят на кнопках.
       На телевизоре тело служит входом, дальше пульт ходит по этим же контролам. -->
  <Button x:Name="FacePart" Classes="serverrow noclick" Classes.off="{Binding !IsSelected}">
    <Panel>
      <Grid RowDefinitions="Auto,Auto">
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="12,10">
          <!-- Имя и подключение: имя занимает строку целиком, кнопка жмётся последней. -->
          <Grid Grid.Row="0" Classes="cardhead" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <!-- Подключение: со своей конфигурации туннель снимает, с чужой переносит его сюда. Круг повторяет
                 кнопку в шапке: цвет состояния и дуга на переключении. -->
            <Button x:Name="ConnectPart" Grid.Column="1" Classes="cardpower" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding CardActionText}"
                    Command="{Binding $parent[controls:CatalogCard].ConnectCommand}" CommandParameter="{Binding}">
              <Panel Width="28" Height="28">
                <Ellipse Classes="connspin" Classes.spinning="{Binding CardBusy}"
                         Width="26" Height="26" Stroke="{Binding CardPowerForeground}"
                         StrokeThickness="2" StrokeDashArray="12,29" StrokeLineCap="Round"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border Width="22" Height="22" CornerRadius="11"
                        Background="{Binding CardPowerBrush}"
                        BorderBrush="{Binding CardPowerBorderBrush}" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <PathIcon Data="{DynamicResource AgPowerGeometry}" Width="11" Height="11"
                            Foreground="{Binding CardPowerForeground}"
                            IsVisible="{Binding !CardBusy}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Panel>
            </Button>
          </Grid>

          <!-- Отклик, скорость и потери: иконка и значение, «N/A» вместо пустого места.
               Отступы стоят на группах: скрытая скорость не оставляет прогала. Потери ужимаются первыми. -->
          <Grid Grid.Row="1" Classes="cardinfo" ColumnDefinitions="Auto,Auto,*" Margin="0,8,0,0"
                VerticalAlignment="Center">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" Margin="0,0,10,0">
              <PathIcon Data="{StaticResource AgCardTimerGeometry}" Width="13" Height="13"
                        Foreground="{DynamicResource AgMutedBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ProbeText}" Foreground="{Binding ProbeBrush}" FontSize="12.5"
                         FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         IsVisible="{Binding !Probing}" />
              <!-- Идёт замер: точки приподнимаются по очереди на месте отклика. -->
              <StackPanel Orientation="Horizontal" Spacing="3" Height="13" VerticalAlignment="Center"
                          IsVisible="{Binding Probing}">
                <Ellipse Classes="dot d1" Fill="{DynamicResource AgMutedBrush}" VerticalAlignment="Center" />
                <Ellipse Classes="dot d2" Fill="{DynamicResource AgMutedBrush}" VerticalAlignment="Center" />
                <Ellipse Classes="dot d3" Fill="{DynamicResource AgMutedBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="0,0,10,0"
                        IsVisible="{Binding ShowLinkSpeed}">
              <PathIcon Data="{StaticResource AgCardTrafficGeometry}" Width="13" Height="13"
                        Foreground="{DynamicResource AgMutedBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding CardSpeedText}" FontSize="12.5" Classes="muted"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
            <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="5">
              <PathIcon Grid.Column="0" Data="{StaticResource AgCardLossGeometry}" Width="13" Height="13"
                        Foreground="{DynamicResource AgMutedBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding CardLossText}" FontSize="12.5"
                         Foreground="{Binding CardLossBrush}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
          </Grid>
        </Grid>

        <!-- Подвал карточки: метки настроек слева, настройки конфигурации справа. -->
        <Border Grid.Row="1" Classes="cardfoot">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <controls:CardTags Grid.Column="0" Tags="{Binding Tags}" VerticalAlignment="Center" />
            <!-- Шестерёнка встаёт под кнопку подключения: ширина кнопки повторяет её. -->
            <Button x:Name="SettingsPart" Grid.Column="1" Classes="methodpick cardgear"
                    ToolTip.Tip="{l:Tr Main_CardSettingsLink}"
                    Command="{Binding $parent[controls:CatalogCard].OpenCommand}" CommandParameter="{Binding}">
              <PathIcon Data="{StaticResource AgCardGearGeometry}" Width="15" Height="15" />
            </Button>
          </Grid>
        </Border>
      </Grid>

      <!-- Светлая рамка у всякой карточки; поверх неё рамка выбранной в каталоге - акцентом, за состоянием
           подключения не следует. Рисуется поверх содержимого и компоновки не меняет. -->
      <Border BorderThickness="1" CornerRadius="12" IsHitTestVisible="False"
              BorderBrush="{DynamicResource AgBorder2Brush}" />
      <Border BorderThickness="1" CornerRadius="12" IsHitTestVisible="False"
              BorderBrush="{DynamicResource AgAccentBrush}" IsVisible="{Binding ShowCardFrame}" />
    </Panel>
  </Button>
</UserControl>
