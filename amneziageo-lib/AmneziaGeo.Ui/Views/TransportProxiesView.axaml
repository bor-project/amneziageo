<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             xmlns:svc="clr-namespace:AmneziaGeo.Ui.Services"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             x:Class="AmneziaGeo.Ui.Views.TransportProxiesView"
             x:DataType="vm:TransportProxiesViewModel" x:CompileBindings="True">
  <UserControl.Styles><Style Selector="TextBlock.available"><Setter Property="Foreground" Value="{DynamicResource AgUpBrush}" /></Style></UserControl.Styles>
  <UserControl.Resources>
    <StreamGeometry x:Key="AgProxyPlusGeometry">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
    <StreamGeometry x:Key="AgProxyLockGeometry">M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z</StreamGeometry>
    <StreamGeometry x:Key="AgProxyServerGeometry">M4,2H20A2,2 0 0,1 22,4V8A2,2 0 0,1 20,10H4A2,2 0 0,1 2,8V4A2,2 0 0,1 4,2M4,4V8H20V4H4M4,14H20A2,2 0 0,1 22,16V20A2,2 0 0,1 20,22H4A2,2 0 0,1 2,20V16A2,2 0 0,1 4,14M4,16V20H20V16H4M6,5H8V7H6V5M6,17H8V19H6V17Z</StreamGeometry>
    <StreamGeometry x:Key="AgProxyLocalGeometry">M5,2H19A2,2 0 0,1 21,4V16A2,2 0 0,1 19,18H13V20H17V22H7V20H11V18H5A2,2 0 0,1 3,16V4A2,2 0 0,1 5,2M5,4V16H19V4H5Z</StreamGeometry>
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBlock Classes="section" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Panel Grid.Column="1" VerticalAlignment="Center">
        <Button Classes="linkbtn" Command="{Binding RefreshCommand}" IsVisible="{Binding IsCatalogue}"
                IsEnabled="{Binding CanRefresh}" ToolTip.Tip="{l:Tr Proxies_Refresh}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Classes.spin="{Binding IsRefreshing}" Data="{DynamicResource AgRefreshGeometry}" Width="14" Height="14" />
            <TextBlock Text="{l:Tr Proxies_Refresh}" />
          </StackPanel>
        </Button>
        <PathIcon Data="{StaticResource AgProxyLockGeometry}" Width="16" Height="16" Foreground="{DynamicResource AgMutedBrush}"
                  IsVisible="{Binding Editor.ShowLock, FallbackValue=False}" ToolTip.Tip="{l:Tr Proxies_View}" />
      </Panel>
    </Grid>
    <UniformGrid x:Name="CatalogueHeader" Grid.Row="1" Rows="1" Margin="0,14,0,0" IsVisible="{Binding IsCatalogue}"
                 HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
      <Button x:Name="AddButton" Classes="methodpick" MinHeight="34" Padding="12,6" Margin="0,0,4,0"
              Command="{Binding AddCommand}" IsEnabled="{Binding CanAdd}" HorizontalAlignment="Stretch"
              MinWidth="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=minW130}">
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource AgProxyPlusGeometry}" Width="14" Height="14" />
          <TextBlock Text="{l:Tr Main_AddButton}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Button>
      <Button Classes="methodpick" MinHeight="34" Padding="12,6" Margin="4,0,0,0" HorizontalAlignment="Stretch"
              Command="{Binding CheckAllCommand}" IsEnabled="{Binding CanCheckAll}"
              MinWidth="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=minW130}">
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
          <PathIcon Classes.spin="{Binding IsCheckingAll}" Data="{DynamicResource AgRefreshGeometry}" Width="14" Height="14" />
          <TextBlock Text="{l:Tr Main_ProbeButton}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Button>
    </UniformGrid>
    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Classes="fieldwarn" TextWrapping="Wrap" Margin="0,12,0,0"
               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <Panel Grid.Row="3" x:Name="Body" KeyDown="OnBodyKeyDown" Margin="0,12,0,0">
      <ScrollViewer x:Name="CatalogueScroll" IsVisible="{Binding IsCatalogue}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Margin="0,0,14,0">
          <ProgressBar IsVisible="{Binding IsCatalogueLoading}" IsIndeterminate="True" MaxWidth="320" />
          <StackPanel Spacing="8" IsVisible="{Binding ShowCatalogueError}">
            <TextBlock Text="{Binding CatalogueError}" Classes="fieldwarn" TextWrapping="Wrap" />
            <Button Classes="methodpick" Content="{l:Tr Proxies_Retry}" Command="{Binding RetryCommand}" HorizontalAlignment="Left" />
          </StackPanel>
          <TextBlock Text="{l:Tr Proxies_Empty}" Classes="muted" IsVisible="{Binding IsEmpty}" />
          <ItemsControl x:Name="Cards" ItemsSource="{Binding Items}">
            <ItemsControl.ItemContainerTheme>
              <ControlTheme TargetType="ContentPresenter">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
              </ControlTheme>
            </ItemsControl.ItemContainerTheme>
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding CatalogColumns}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TransportProxyItemViewModel">
                <Button Classes="serverrow noclick" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        VerticalAlignment="Stretch" Margin="0,0,8,8">
                  <Panel>
                    <Grid RowDefinitions="*,Auto">
                      <StackPanel Spacing="7" Margin="12,10">
                        <Grid Classes="cardhead" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBlock Text="{Binding Address}" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                     MinHeight="18" LineHeight="18" MaxLines="2" VerticalAlignment="Center" ToolTip.Tip="{Binding Address}" />
                          <Button Grid.Column="1" Classes="cardpick" ClickMode="Press" VerticalAlignment="Top" Margin="0,1,0,0"
                                  Command="{Binding ToggleSelectedCommand}" AutomationProperties.Name="{Binding Address}">
                            <Panel Width="42"><Border Classes="cardswitch" Classes.on="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse /></Border></Panel>
                          </Button>
                        </Grid>
                        <TextBlock Text="{Binding Fault}" Classes="fieldwarn" TextWrapping="Wrap" FontSize="12"
                                   Height="16" LineHeight="16" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Fault}" />
                      </StackPanel>
                      <Border Grid.Row="1" Classes="cardfoot">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <controls:TagStrip Spacing="6" RowSpacing="6" VerticalAlignment="Center">
                            <Border Classes="cardchip cardtag" ToolTip.Tip="{Binding Source}">
                              <TextBlock Text="{Binding Source}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border Classes="cardchip cardtag">
                              <Grid ColumnDefinitions="Auto,*">
                                <Image Source="avares://AmneziaGeo.Ui/Assets/amneziageo.png" Width="13" Height="13" Margin="0,0,4,0"
                                       VerticalAlignment="Center" IsVisible="{Binding IsHttpGet}" />
                                <TextBlock Grid.Column="1" Text="{Binding Transport}" FontSize="11.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                              </Grid>
                            </Border>
                            <Border Classes="cardchip cardtag" IsVisible="{Binding Cdn}">
                              <TextBlock Text="CDN" FontSize="11.5" FontWeight="SemiBold" />
                            </Border>
                          </controls:TagStrip>
                          <Panel Grid.Column="1" Width="42" VerticalAlignment="Top">
                            <Button Classes="methodpick cardgear" HorizontalAlignment="Center"
                                    ToolTip.Tip="{Binding ActionText}" AutomationProperties.Name="{Binding Address}"
                                    Command="{Binding $parent[UserControl].((vm:TransportProxiesViewModel)DataContext).OpenCardCommand}" CommandParameter="{Binding}">
                              <PathIcon Data="{DynamicResource AgGearGeometry}" Width="15" Height="15" />
                            </Button>
                          </Panel>
                        </Grid>
                      </Border>
                    </Grid>
                    <Border BorderThickness="1" CornerRadius="12" IsHitTestVisible="False" BorderBrush="{DynamicResource AgBorder2Brush}" />
                    <Border BorderThickness="1.5" CornerRadius="12" IsHitTestVisible="False" IsVisible="{Binding IsSelected}"
                            BorderBrush="{DynamicResource AgAccentBrush}" BoxShadow="0 0 14 0 #552A6FDB" />
                  </Panel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <ProgressBar IsIndeterminate="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Width="150" HorizontalAlignment="Center" />
      <ScrollViewer x:Name="EditorScroll" IsVisible="{Binding ShowEditor}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="0,0,14,0" MaxWidth="1100" HorizontalAlignment="Stretch">
          <ContentControl Content="{Binding Editor}" HorizontalContentAlignment="Stretch">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:TransportProxyEditorViewModel">
                <Border Classes="sect" IsEnabled="{Binding !IsBusy}">
                  <StackPanel Spacing="14" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                      <Panel VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource AgProxyLocalGeometry}" Width="15" Height="15"
                                  Foreground="{DynamicResource AgMutedBrush}" IsVisible="{Binding LocalSource}" />
                        <PathIcon Data="{StaticResource AgProxyServerGeometry}" Width="15" Height="15"
                                  Foreground="{DynamicResource AgMutedBrush}" IsVisible="{Binding !LocalSource}" />
                      </Panel>
                      <TextBlock Grid.Column="1" Text="{Binding Source}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </Grid>
                    <Border Classes="hairline" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                      <StackPanel Spacing="4" Grid.ColumnSpan="{Binding Compact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=span2}">
                        <TextBlock Classes="label" Text="{l:Tr Proxies_Host}" />
                        <TextBox x:Name="ProxyHost" Classes="field" Text="{Binding Host}" IsReadOnly="{Binding !Editable}" />
                      </StackPanel>
                      <Grid ColumnDefinitions="95,*" ColumnSpacing="12"
                            Grid.Row="{Binding Compact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=row}"
                            Grid.Column="{Binding Compact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=col}"
                            Grid.ColumnSpan="{Binding Compact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=span2}">
                        <StackPanel Spacing="4"><TextBlock Classes="label" Text="{l:Tr Main_ServerPortLabel}" /><TextBox Classes="field" Text="{Binding Port}" IsReadOnly="{Binding !Editable}" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="label" Text="{l:Tr Proxies_Path}" /><TextBox Classes="field" Text="{Binding Path}" IsReadOnly="{Binding !Editable}" /></StackPanel>
                      </Grid>
                    </Grid>
                    <Border Classes="hairline" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding ModernEditable}">
                      <StackPanel Spacing="4" Grid.ColumnSpan="{Binding !ShowHttpMethod, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=span2}"><TextBlock Classes="label" Text="{l:Tr Proxies_Transport}" /><controls:AdaptiveComboBox Classes="field" ItemsSource="{Binding Transports}" SelectedIndex="{Binding TransportIndex, Mode=TwoWay}" IsEnabled="{Binding ModernEditable}" /></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4" IsVisible="{Binding ShowHttpMethod}"><TextBlock Classes="label" Text="{l:Tr Proxies_HttpMethod}" /><controls:AdaptiveComboBox Classes="field" ItemsSource="{Binding Methods}" SelectedIndex="{Binding MethodIndex, Mode=TwoWay}" IsEnabled="{Binding ModernEditable}" /></StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding !ModernEditable}">
                      <TextBlock Classes="label" Text="{l:Tr Proxies_Protocol}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Image Source="avares://AmneziaGeo.Ui/Assets/amneziageo.png" Width="15" Height="15" IsVisible="{Binding IsHttpGet}" />
                        <TextBlock Text="{Binding Protocol}" Classes="muted" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="CDN" Classes="muted" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding Cdn}" />
                      </StackPanel>
                    </Grid>
                    <Border Classes="hairline" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                      <StackPanel Spacing="4" Grid.ColumnSpan="{Binding Compact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=span2}"><TextBlock Classes="label" Text="{l:Tr Proxies_ServerName}" /><TextBox Classes="field" Text="{Binding ServerName}" PlaceholderText="{Binding Host}" IsReadOnly="{Binding !ModernEditable}" /></StackPanel>
                      <StackPanel Spacing="4" Grid.Row="{Binding Compact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=row}" Grid.Column="{Binding Compact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=col}" Grid.ColumnSpan="{Binding Compact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=span2}"><TextBlock Classes="label" Text="{l:Tr Proxies_Pin}" /><TextBox Classes="field" Text="{Binding Pin}" PlaceholderText="{l:Tr Proxies_NotSet}" IsReadOnly="{Binding !ModernEditable}" /></StackPanel>
                    </Grid>
                    <Border Classes="hairline" />
                    <StackPanel Spacing="4"><TextBlock Classes="label" Text="{Binding CredentialLabel}" /><TextBox Classes="field" Text="{Binding Credential}" PlaceholderText="{Binding CredentialPlaceholder}" PasswordChar="●" IsReadOnly="{Binding !Editable}" IsEnabled="{Binding !Anonymous}" /></StackPanel>
                    <CheckBox Content="{l:Tr Proxies_Anonymous}" IsChecked="{Binding Anonymous, Mode=TwoWay}"
                              IsEnabled="{Binding ModernEditable}" IsVisible="{Binding ShowAnonymous}" />
                    <Border Classes="hairline" IsVisible="{Binding ShowOwner}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding ShowOwner}">
                      <TextBlock Classes="label" Text="{l:Tr Main_ConfigPickerLabel}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding OwnerConfig}" Classes="muted" TextWrapping="Wrap" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Classes="hairline" IsVisible="{Binding ShowTargets}" />
                    <StackPanel Spacing="6" IsVisible="{Binding ShowTargets}">
                      <TextBlock Text="{l:Tr Proxies_Targets}" Classes="label" />
                      <TextBlock Text="{Binding ScopeText}" Classes="muted" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding TargetsText}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                                 IsVisible="{Binding TargetsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
          <Button Classes="methodpick" Content="{l:Tr Proxies_Check}" Command="{Binding ProbeCommand}" IsEnabled="{Binding CanProbe}" HorizontalAlignment="Right" />
          <ProgressBar IsVisible="{Binding IsProbing}" IsIndeterminate="{Binding IsProbing}" />
          <ContentControl Content="{Binding Editor}" HorizontalContentAlignment="Stretch">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:TransportProxyEditorViewModel">
                <TextBlock Text="{Binding StatusMessage}" Classes="muted" Classes.fieldwarn="{Binding !IsVerified}"
                           Classes.available="{Binding IsVerified}" TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
          <StackPanel Spacing="10" IsVisible="{Binding CanDelete}">
            <Button Classes="methodpick" Content="{l:Tr Proxies_Delete}" Command="{Binding RequestDeleteCommand}" IsVisible="{Binding !DeletePending}" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding DeletePending}"><Button Classes="methodpick" Content="{l:Tr Main_CancelButton}" Command="{Binding CancelDeleteCommand}" /><Button Classes="accent" Content="{l:Tr Proxies_Delete}" Command="{Binding DeleteCommand}" /></StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Panel>
  </Grid>
</UserControl>
