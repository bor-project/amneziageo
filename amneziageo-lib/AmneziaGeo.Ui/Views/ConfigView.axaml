<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:views="clr-namespace:AmneziaGeo.Ui.Views"
             xmlns:svc="clr-namespace:AmneziaGeo.Ui.Services"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             x:Class="AmneziaGeo.Ui.Views.ConfigView"
             x:CompileBindings="True"
             x:DataType="vm:ConfigViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="AgPlusGeometry">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
    <StreamGeometry x:Key="AgCopyGeometry">M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z</StreamGeometry>
    <StreamGeometry x:Key="AgDownloadGeometry">M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z</StreamGeometry>
    <StreamGeometry x:Key="AgShareGeometry">M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.34C15.11,18.55 15.08,18.77 15.08,19C15.08,20.61 16.39,21.91 18,21.91C19.61,21.91 20.92,20.61 20.92,19A2.92,2.92 0 0,0 18,16.08Z</StreamGeometry>
    <StreamGeometry x:Key="AgEyeGeometry">M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9M12,4.5C17,4.5 21.27,7.61 23,12C21.27,16.39 17,19.5 12,19.5C7,19.5 2.73,16.39 1,12C2.73,7.61 7,4.5 12,4.5M3.18,12C4.83,15.36 8.24,17.5 12,17.5C15.76,17.5 19.17,15.36 20.82,12C19.17,8.64 15.76,6.5 12,6.5C8.24,6.5 4.83,8.64 3.18,12Z</StreamGeometry>
    <StreamGeometry x:Key="AgRouteGeometry">M14,4L16.29,6.29L13.41,9.17L14.83,10.59L17.71,7.71L20,10V4M10,4H4V10L6.29,7.71L11,12.41V20H13V11.59L7.71,6.29L10,4Z</StreamGeometry>
    <StreamGeometry x:Key="AgLockGeometry">M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z</StreamGeometry>
  </UserControl.Resources>
  <!-- Last row stars to fill the pane with the card catalogue. Cards stretch the full pane width. -->
  <!-- Брошенный на раздел файл добавляется в каталог: берутся только конфигурации. -->
  <Grid RowDefinitions="Auto,*" Background="Transparent"
        controls:FileDropBehavior.Command="{Binding DropFilesCommand}">

    <!-- Шапка каталога: добавление конфигурации и замер всех серверов разом. -->
    <StackPanel x:Name="CatalogueHeader" Grid.Row="0" Margin="0,12,0,0" Spacing="8"
                IsVisible="{Binding IsSectionCatalogue}">
      <!-- Обе кнопки делят строку поровну; на широком экране строка стоит слева своей шириной. Пустому каталогу
           мерить нечего - «Добавить» остаётся одна и занимает строку целиком. -->
      <UniformGrid Rows="1"
                   HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
        <Button x:Name="AddButton" Classes="methodpick" MinHeight="34" Padding="12,6" Margin="0,0,4,0"
                HorizontalAlignment="Stretch" Click="OnAddOptions"
                MinWidth="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=minW130}">
          <StackPanel Orientation="Horizontal" Spacing="6"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource AgPlusGeometry}" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr Main_AddButton}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="methodpick" MinHeight="34" Padding="12,6" Margin="4,0,0,0"
                HorizontalAlignment="Stretch" IsVisible="{Binding HasConfigs}"
                Command="{Binding Home.ProbeAllCommand}" IsEnabled="{Binding !Home.ProbeRunning}"
                ToolTip.Tip="{l:Tr Main_ProbeTooltip}"
                MinWidth="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=minW130}">
          <StackPanel Orientation="Horizontal" Spacing="6"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <PathIcon Classes.spin="{Binding Home.ProbeRunning}" Data="{DynamicResource AgRefreshGeometry}"
                      Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Text="{l:Tr Main_ProbeButton}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </UniformGrid>

      <!-- Каталог пуст: настроек ещё нет, добавление - единственный шаг. -->
      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                 Text="{l:Tr Main_ConfigCatalogueEmpty}" IsVisible="{Binding ShowNoConfigsHint}" />
    </StackPanel>

    <!-- Каталог карточек: кнопка на карточке и двойной щелчок по ней открывают настройки своей
         конфигурации, драг переставляет карточки. -->
    <Panel Grid.Row="1" Margin="0,12,0,0" IsVisible="{Binding IsSectionCatalogue}">
      <!-- Узкий экран: карточки стоят одной колонкой во всю ширину. -->
      <ScrollViewer IsVisible="{Binding ShowCardStack}"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Configs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ConfigItemViewModel">
              <controls:CatalogCard Margin="0,0,0,8"
                      OpenCommand="{Binding $parent[UserControl].((vm:ConfigViewModel)DataContext).OpenCardCommand}"
                      ConnectCommand="{Binding $parent[UserControl].((vm:ConfigViewModel)DataContext).Home.ConnectConfigCommand}"
                      DefaultCommand="{Binding $parent[UserControl].((vm:ConfigViewModel)DataContext).MakeDefaultCommand}"
                      DropCommand="{Binding $parent[UserControl].((vm:ConfigViewModel)DataContext).ApplyOrderCommand}"
                      PickCommand="{Binding $parent[UserControl].((vm:ConfigViewModel)DataContext).PickCardCommand}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Широкий экран: карточки стоят в две равные колонки во всю их ширину, драг переставляет их. -->
      <ScrollViewer IsVisible="{Binding ShowCardGrid}"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Configs}" VerticalAlignment="Top">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ConfigItemViewModel">
              <controls:CatalogCard Margin="0,0,10,10" VerticalAlignment="Top"
                      OpenCommand="{Binding $parent[UserControl].((vm:ConfigViewModel)DataContext).OpenCardCommand}"
                      ConnectCommand="{Binding $parent[UserControl].((vm:ConfigViewModel)DataContext).Home.ConnectConfigCommand}"
                      DefaultCommand="{Binding $parent[UserControl].((vm:ConfigViewModel)DataContext).MakeDefaultCommand}"
                      DropCommand="{Binding $parent[UserControl].((vm:ConfigViewModel)DataContext).ApplyOrderCommand}"
                      PickCommand="{Binding $parent[UserControl].((vm:ConfigViewModel)DataContext).PickCardCommand}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>

    <!-- Catalogue loader: the agent has not reported its configs yet (#137). -->
    <StackPanel Grid.Row="1" Margin="0,14,0,0" IsVisible="{Binding ShowCatalogueLoader}"
                HorizontalAlignment="Center" Spacing="12">
      <ProgressBar IsIndeterminate="True" Width="150" HorizontalAlignment="Center" />
      <TextBlock Text="{l:Tr Main_RoutingLoading}" Classes="muted" FontSize="13" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- Config section: active trigger + name + editable .conf text + proxy + export + delete. Edits held for the
         footer Save. -->
    <StackPanel x:Name="SettingsSection" Grid.Row="1" Margin="0,14,0,0"
                IsVisible="{Binding IsSectionConfig}">
      <!-- One frame around the whole settings block; below the card width it goes and the hairlines carry the boundaries. -->
      <Border Classes="sect">
        <StackPanel Spacing="14">
          <!-- Конфигурация по умолчанию: тумблер делает её целью, ссылка под ним поднимает туннель. -->
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{l:Tr Main_ConfigDefaultTitle}" FontWeight="SemiBold" FontSize="15"
                         TextWrapping="Wrap" />
              <TextBlock Text="{l:Tr Main_ConfigDefaultSubtitle}" Classes="muted" FontSize="11.5"
                         TextWrapping="Wrap" />
              <Button Classes="linkbtn" FontSize="12" HorizontalAlignment="Left"
                      IsVisible="{Binding ShowConnectOpenConfig}"
                      Command="{Binding ConnectOpenConfigCommand}">
                <TextBlock Text="{l:Tr Main_ConnectNowLink}" />
              </Button>
            </StackPanel>
            <ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                          IsChecked="{Binding UseOpenConfig, Mode=TwoWay}" />
          </Grid>

          <Border Classes="hairline" />

          <!-- Config name: per-keystroke so the required-field border reacts at once; committed on the footer Save (#143). -->
          <StackPanel Spacing="2">
            <TextBlock Text="{l:Tr Main_ConfigNameLabel}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
            <TextBox Classes="field" Classes.invalid="{Binding ConfigNameMissing}"
                     Text="{Binding ConfigRename, Mode=TwoWay}" VerticalAlignment="Center" />
            <TextBlock Classes="fieldwarn" IsVisible="{Binding ConfigNameMissing}"
                       Text="{l:Tr Main_RequiredEmptyWarning}" />
            <TextBlock Text="{Binding ConfigRenameStatus}" Classes="fieldwarn" FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding ConfigRenameStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <Border Classes="hairline" />

          <!-- Editable .conf text: committed on the footer Save through the shared config view model. Kept away
               until asked for - it carries the private key - and hidden again on every entry into the section. -->
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{l:Tr Main_ConfigTextLabel}" FontWeight="SemiBold" FontSize="15"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="linkbtn" Command="{Binding ToggleConfigTextCommand}"
                      VerticalAlignment="Center" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource AgEyeGeometry}" Width="14" Height="14" />
                  <!-- Both captions share one cell so the link keeps its width across the toggle. -->
                  <Panel>
                    <TextBlock Text="{l:Tr Main_ShowButton}" IsVisible="{Binding !ShowConfigText}" />
                    <TextBlock Text="{l:Tr Main_HideButton}" IsVisible="{Binding ShowConfigText}" />
                  </Panel>
                </StackPanel>
              </Button>
            </Grid>
            <Border BorderBrush="{DynamicResource AgBorder2Brush}" BorderThickness="1"
                    CornerRadius="8" Background="{DynamicResource AgPanelBrush}"
                    IsVisible="{Binding ShowConfigText}"
                    IsEnabled="{Binding ConfigExport.IsReady}">
              <TextBox Text="{Binding ConfigExport.ConfText, Mode=TwoWay}"
                       AcceptsReturn="True" TextWrapping="NoWrap"
                       VerticalContentAlignment="Top" Height="240"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       BorderThickness="0" Background="Transparent"
                       FontFamily="IBM Plex Mono, Cascadia Mono, Consolas, monospace" FontSize="12" />
            </Border>
            <TextBlock Text="{Binding ConfigExport.StatusMessage}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"
                       IsVisible="{Binding ConfigExport.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <Border Classes="hairline" />

          <!-- Proxy (WebSocket). -->
          <views:ConfigTransportView DataContext="{Binding ConfigTransport}" />

          <Border Classes="hairline" />

          <!-- Маршрутизация: список, по которому эта конфигурация решает, что уводить в туннель. -->
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{l:Tr Main_ConfigRoutingTitle}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
              <TextBlock Text="{l:Tr Main_ConfigRoutingSubtitle}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Row="1" Grid.Column="0" Classes="methodpick" VerticalAlignment="Center"
                    Click="OnRoutingOptions"
                    Width="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w180}"
                    HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
              <StackPanel Orientation="Horizontal" Spacing="6"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource AgRouteGeometry}" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock Text="{Binding OpenRow.RoutingLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <Border Classes="hairline" IsVisible="{Binding MultiTunnel}" />

          <!-- Приложения: какой из туннелей уводит всё, что не назвали остальные. -->
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding MultiTunnel}">
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{l:Tr Main_ConfigDefaultRouteTitle}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
              <TextBlock Text="{l:Tr Main_ConfigDefaultRouteSubtitle}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DefaultRouteHeldText}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                          IsChecked="{Binding CarriesDefaultRoute, Mode=TwoWay}" />
          </Grid>

          <Border Classes="hairline" />

          <!-- Экспорт: способ - экран QR, ссылка в буфер или файл - выпадает списком у кнопки, а на телефоне
               приходит шторкой снизу. -->
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{l:Tr Main_ExportConfigTitle}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
              <TextBlock Text="{l:Tr Main_ExportConfigSubtitle}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Row="1" Grid.Column="0" Classes="methodpick" VerticalAlignment="Center"
                    Click="OnExportOptions"
                    Width="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w180}"
                    HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
              <StackPanel Orientation="Horizontal" Spacing="6"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource AgShareGeometry}" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock Text="{l:Tr Main_ExportTab}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <Border Classes="hairline" />

          <!-- Delete: description left, delete trigger right. When armed, the trigger is replaced in place by
               the Confirm/Cancel pair sharing its footprint - one per column, each stretched (#4). -->
          <StackPanel Spacing="10">
            <!-- The trigger stands under the description. -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
              <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{l:Tr Main_DeleteConfigTitle}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DeleteConfigPrompt}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
              </StackPanel>
              <Grid Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                    Width="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w180}"
                    HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}"
                    ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.ColumnSpan="2" Classes="danger" HorizontalAlignment="Stretch"
                        Content="{l:Tr Main_DeleteConfigButton}"
                        IsVisible="{Binding !ConfigDeletePending}"
                        Command="{Binding RequestDeleteOpenConfigCommand}" />
                <Button Grid.Column="0" Classes="danger" HorizontalAlignment="Stretch"
                        Content="{l:Tr Main_ConfirmDeleteButton}"
                        IsVisible="{Binding ConfigDeletePending}"
                        Command="{Binding ConfirmDeleteOpenConfigCommand}" />
                <Button Grid.Column="1" Classes="softbtn" HorizontalAlignment="Stretch"
                        Content="{l:Tr Main_CancelButton}"
                        IsVisible="{Binding ConfigDeletePending}"
                        Command="{Binding CancelDeleteConfigCommand}" />
              </Grid>
            </Grid>
            <TextBlock Text="{Binding ConfigDeleteStatus}" Classes="fieldwarn" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding ConfigDeleteStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Черновик новой конфигурации: способ уже выбран в шторке, отсюда ведут «Сохранить» и «Отмена» в футере.
         Imported with the footer Save once text parses + name is set (#143). -->
    <Border x:Name="ImportSection" Grid.Row="1" Margin="0,12,0,0" Classes="sect"
            IsVisible="{Binding IsSectionImport}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
          <TextBlock Text="{l:Tr Main_ConfigNameLabel}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
          <TextBox x:Name="SectionConfigNameBox" Classes="field" Classes.invalid="{Binding SectionConfigNameMissing}"
                   Text="{Binding SectionConfigName, Mode=TwoWay}"
                   Watermark="{l:Tr Main_ConfigNameWatermark}" />
          <TextBlock Classes="fieldwarn" IsVisible="{Binding SectionConfigNameMissing}"
                     Text="{l:Tr Main_RequiredEmptyWarning}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding SectionConfigStatus}" Classes="fieldwarn"
                   FontSize="11.5" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                   Margin="0,10,0,0"
                   IsVisible="{Binding SectionConfigStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Same proxy / MTU / IPv6 an open config carries; the footer Save applies them to the imported
              configuration. Shown beside the text, where there is something to apply them to. -->
        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0"
                IsVisible="{Binding IsImportManual}">
          <views:ConfigTransportView DataContext="{Binding SectionTransport}" />
        </Border>

        <!-- Источник: набранный текст либо живой сканер. -->
        <Panel MinHeight="220" Margin="0,12,0,0">

          <Border IsVisible="{Binding IsImportManual}"
                  BorderBrush="{DynamicResource AgBorder2Brush}" BorderThickness="1"
                  CornerRadius="8" Background="{DynamicResource AgPanelBrush}">
            <TextBox Text="{Binding SectionConfigText, Mode=TwoWay}"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalContentAlignment="Top" MinHeight="200"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent"
                     FontFamily="IBM Plex Mono, Cascadia Mono, Consolas, monospace" FontSize="12"
                     Watermark="[Interface]&#x0a;PrivateKey = ...&#x0a;Address = ...&#x0a;&#x0a;[Peer]&#x0a;PublicKey = ...&#x0a;Endpoint = host:port" />
          </Border>

          <Panel IsVisible="{Binding IsImportCamera}">
            <views:ScanView DataContext="{Binding SectionScan}" />
          </Panel>

        </Panel>
      </DockPanel>
    </Border>

    <!-- Export section: read-only QR of the .conf / of the vpn:// link, with copy / save. -->
    <StackPanel x:Name="ExportSection" Grid.Row="1" Margin="0,12,0,0"
                IsVisible="{Binding IsSectionExport}" Spacing="12">
      <!-- Экран экспорта занимает пану целиком; возвращает с него стрелка «назад» в шапке окна. -->
      <TextBlock Text="{l:Tr Main_ExportConfigTitle}" FontWeight="SemiBold" FontSize="15"
                 TextWrapping="Wrap" VerticalAlignment="Center" />

      <Border Classes="sect">
        <StackPanel Spacing="12" DataContext="{Binding ConfigExport}" x:DataType="vm:ExportDialogViewModel">
          <TextBlock Text="{l:Tr Main_ExportConfigSubtitle}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <Border Background="{DynamicResource AgInsetBrush}"
                  BorderBrush="{DynamicResource AgBorderBrush}" BorderThickness="1"
                  CornerRadius="9" Padding="3" MaxWidth="480" HorizontalAlignment="Center">
            <UniformGrid Columns="2">
              <Button Classes="seg" Classes.active="{Binding IsQrConf}" Command="{Binding ShowQrConfCommand}"
                      Content="{l:Tr Main_QrConfTabShort}" HorizontalAlignment="Stretch" Padding="20,6" />
              <Button Classes="seg" Classes.active="{Binding IsQrLink}" Command="{Binding ShowQrLinkCommand}"
                      Content="{l:Tr Main_QrLinkTabShort}" HorizontalAlignment="Stretch" Padding="20,6" />
            </UniformGrid>
          </Border>
          <Border HorizontalAlignment="Center" Background="White" CornerRadius="8" Padding="10"
                  IsVisible="{Binding ShowQr}">
            <Image Source="{Binding QrImage}" Width="220" Height="220" />
          </Border>
          <Border HorizontalAlignment="Center" Background="{DynamicResource AgInsetBrush}"
                  BorderBrush="{DynamicResource AgBorderBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="16" Width="240" IsVisible="{Binding QrUnavailable}">
            <TextBlock Text="{l:Tr Main_QrUnavailableHint}"
                       Classes="muted" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
          </Border>
          <!-- vpn:// link under its QR: read-only, borderless, selectable to copy. -->
          <TextBox Text="{Binding LinkText}" IsReadOnly="True" IsVisible="{Binding IsQrLink}"
                   TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"
                   FontFamily="IBM Plex Mono, Cascadia Mono, Consolas, monospace" FontSize="11.5" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" MaxWidth="480" HorizontalAlignment="Center">
            <PathIcon Grid.Column="0" Data="{StaticResource AgLockGeometry}" Width="13" Height="13"
                      Foreground="{DynamicResource AgMutedBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <TextBlock Grid.Column="1" Text="{l:Tr Main_QrPrivateKeyWarning}" Classes="muted" FontSize="12"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                     HorizontalAlignment="Center" TextAlignment="Center" />
          <!-- Buttons at their own width: a narrow card carries them onto the next line instead of
               squeezing them. -->
          <WrapPanel HorizontalAlignment="Center" MaxWidth="520">
            <Button Classes="methodpick" Margin="4" Padding="16,6"
                    Click="OnCopyExport" IsEnabled="{Binding IsReady}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource AgCopyGeometry}" Width="14" Height="14" />
                <TextBlock Text="{l:Tr Main_CopyContentButtonShort}" />
              </StackPanel>
            </Button>
            <Button Classes="accent" Margin="4" Padding="16,6"
                    Click="OnDownloadQr" IsVisible="{Binding ShowQr}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource AgDownloadGeometry}" Width="14" Height="14" />
                <TextBlock Text="{l:Tr Main_DownloadQrButton}" />
              </StackPanel>
            </Button>
            <!-- Sending the QR on: shows up where the platform hands a file to another application. -->
            <Button Classes="methodpick" Margin="4" Padding="16,6" Click="OnSendQr"
                    IsVisible="{Binding CanSendExport}" IsEnabled="{Binding ShowQr}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource AgShareGeometry}" Width="14" Height="14" />
                <TextBlock Text="{l:Tr Main_SendToAppButton}" />
              </StackPanel>
            </Button>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
