<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:svc="clr-namespace:AmneziaGeo.Ui.Services"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             xmlns:sys="using:System"
             x:Class="AmneziaGeo.Ui.Views.RoutingEditorView"
             x:CompileBindings="True"
             x:DataType="vm:RoutingViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="AgSourcesGeometry">M12,3C7.58,3 4,4.79 4,7C4,9.21 7.58,11 12,11C16.42,11 20,9.21 20,7C20,4.79 16.42,3 12,3M4,9V12C4,14.21 7.58,16 12,16C16.42,16 20,14.21 20,12V9C20,11.21 16.42,13 12,13C7.58,13 4,11.21 4,9M4,14V17C4,19.21 7.58,21 12,21C16.42,21 20,19.21 20,17V14C20,16.21 16.42,18 12,18C7.58,18 4,16.21 4,14Z</StreamGeometry>
    <StreamGeometry x:Key="AgRuleDeleteGeometry">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
    <StreamGeometry x:Key="AgRuleSortGeometry">M9,3L5,7H8V14H10V7H13M16,17V10H14V17H11L15,21L19,17H16Z</StreamGeometry>
  </UserControl.Resources>

  <!-- Shared rule + traffic editor, bound to RoutingEditor / RoutingSettings; used by both the Settings and
       Import sections. -->
  <StackPanel Spacing="14">

    <!-- Rules card: name + per-app tunneling + geo/domain/cidr entries. -->
    <Border Classes="sect" Classes.compact="{Binding IsCompact}">
      <StackPanel Spacing="14" DataContext="{Binding RoutingEditor}" x:DataType="vm:RoutingListEditorViewModel">
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLoading}">
          <PathIcon Classes.spin="{Binding IsLoading}" Data="{DynamicResource AgRefreshGeometry}"
                    Width="14" Height="14" Foreground="{DynamicResource AgMutedBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{l:Tr Main_RoutingLoading}" Classes="muted" FontSize="12.5" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Spacing="2">
          <TextBlock Text="{l:Tr Main_ListNameLabel}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
          <TextBox Classes="field" Classes.invalid="{Binding IsNameMissing}"
                   Text="{Binding Name, Mode=TwoWay}" Watermark="{l:Tr Main_ListNameWatermark}" />
          <TextBlock Classes="fieldwarn" IsVisible="{Binding IsNameMissing}"
                     Text="{l:Tr Main_RequiredEmptyWarning}" />
        </StackPanel>

        <!-- Narrow screen: a hairline carries the section boundary the frame used to. -->
        <Border Height="1" Background="{DynamicResource AgBorderBrush}"
                IsVisible="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact}" />

        <!-- Add an entry by address (geo / domain / cidr) or per-application. Content-width when wide,
             full-width in compact. -->
        <StackPanel Spacing="6">

          <!-- Per-application entries are Windows-only; on Android the method selector is hidden and entries are address-only. -->
          <controls:SegmentedSelector Label="{l:Tr Main_AddMethodLabel}" Heading="True"
              IsVisible="{Binding IsAppMethodAvailable}"
              Command="{Binding SelectAddMethodCommand}"
              IsCompact="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact}"
              Item1Text="{l:Tr Main_AddByAddressTab}" Item1Param="address" Item1Active="{Binding IsAddressMethod}"
              Item2Text="{l:Tr Main_AddByAppTab}" Item2Param="app" Item2Active="{Binding IsAppMethod}" />

          <!-- Address entry: geo category / domain / cidr. -->
          <StackPanel Spacing="6" Margin="0,4,0,0" IsVisible="{Binding IsAddressMethod}">
            <!-- The geo bases stand behind a link here, where their categories are typed in; they have no
                 section of their own. -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
              <TextBlock Grid.Column="0" Text="{l:Tr Main_AddEntryLabel}" FontWeight="SemiBold" FontSize="15"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="linkbtn" VerticalAlignment="Center" HorizontalAlignment="Right"
                      Command="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).OpenGeoSourcesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource AgSourcesGeometry}" Width="12" Height="12"
                            VerticalAlignment="Center" />
                  <TextBlock Text="{l:Tr Main_SourcesSection}" VerticalAlignment="Center" />
                  <PathIcon Data="{DynamicResource AgChevronGeometry}" Width="10" Height="10"
                            VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
            <!-- Input takes the row, the add button drops under it. -->
            <StackPanel Spacing="8">
              <TextBox Classes="field"
                       Watermark="{l:Tr Main_AddEntryWatermark}"
                       Text="{Binding RuleInput, Mode=TwoWay}" />
              <Button Classes="accent" Command="{Binding AddRuleCommand}" KeyDown="OnAddEntryKeyDown"
                      Width="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w130}"
                      HorizontalAlignment="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                  <TextBlock Text="+" />
                  <TextBlock Text="{l:Tr Main_AddButton}" />
                </StackPanel>
              </Button>
            </StackPanel>
            <!-- Best geo-category matches for what's typed; a tap adds one. Works on touch (no dropdown). -->
            <Border IsVisible="{Binding HasMatchedSuggestions}"
                    BorderBrush="{DynamicResource AgBorderBrush}" BorderThickness="1"
                    Background="{DynamicResource AgPanelBrush}" CornerRadius="10" Padding="6">
              <ItemsControl ItemsSource="{Binding MatchedSuggestions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="sys:String">
                    <Button Classes="softbtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Margin="0,1"
                            Command="{Binding $parent[ItemsControl].((vm:RoutingListEditorViewModel)DataContext).PickSuggestionCommand}"
                            CommandParameter="{Binding}">
                      <TextBlock Text="{Binding}" Classes="mono" FontSize="12.5" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>

          <!-- Per-application entry. -->
          <StackPanel Spacing="8" Margin="0,4,0,0" IsVisible="{Binding IsAppMethod}">
            <TextBlock Text="{l:Tr Main_PerAppRoutingLabel}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />

            <!-- Windows: running / installed / folder / file source picker. -->
            <StackPanel Spacing="8" IsVisible="{Binding IsAppSourceWindows}">

            <!-- Source picker and add button share the row; the app input takes its own. -->
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                    HorizontalAlignment="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
                <Button Grid.Column="0" Classes="softbtn" HorizontalAlignment="Stretch" Content="{l:Tr Main_SourceDropdown}"
                        Width="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w130}">
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem Header="{l:Tr Main_AppSourceRunning}" Click="OnAppSourceRunning" />
                      <MenuItem Header="{l:Tr Main_AppSourceInstalled}" Click="OnAppSourceInstalled" />
                      <MenuItem Header="{l:Tr Main_AppSourceFolder}" Click="OnAppSourceFolder" />
                      <MenuItem Header="{l:Tr Main_AppSourceFile}" Click="OnAppSourceFile" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
                <Button Grid.Column="1" Classes="accent" HorizontalAlignment="Stretch" Command="{Binding AddAppCommand}"
                        IsEnabled="{Binding IsAppPickerActive}"
                        Width="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w130}">
                  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="+" />
                    <TextBlock Text="{l:Tr Main_AddButton}" />
                  </StackPanel>
                </Button>
              </Grid>
              <AutoCompleteBox Classes="field"
                               Watermark="{Binding AppWatermark}"
                               Text="{Binding AppInput, Mode=TwoWay}"
                               SelectedItem="{Binding AppSelected, Mode=TwoWay}"
                               ItemsSource="{Binding AppSuggestions}"
                               FilterMode="ContainsOrdinal" MaxDropDownHeight="220"
                               IsEnabled="{Binding IsAppPickerActive}" />
            </StackPanel>
            </StackPanel>

            <!-- Android: pick installed apps to route through the tunnel (include). -->
            <StackPanel Spacing="6" IsVisible="{Binding IsAppSourceAndroid}">
              <Button Classes="accent" HorizontalAlignment="Stretch" Command="{Binding PickAppsCommand}"
                      Content="{l:Tr Main_AppsButton}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <!-- Required-field validation, red; clears on any edit (#2/#3). -->
        <TextBlock Text="{Binding ValidationMessage}" Classes="fieldwarn" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Border Height="1" Background="{DynamicResource AgBorderBrush}"
                IsVisible="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact}" />

        <!-- Role segment [Прокси | Директ | Блок]: which bucket the add rows target and the list below shows. -->
        <StackPanel Spacing="6">
          <!-- The link below sits far to the right, so directional focus walks past it down the left edge;
               naming it as the down target puts it on the way. -->
          <controls:SegmentedSelector x:Name="RoleSegments" Label="{l:Tr Main_RoleLabel}" Heading="True"
              Command="{Binding SelectRoleCommand}"
              XYFocus.Down="{Binding #AddLocalSubnetsLink}"
              IsCompact="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact}"
              Item1Text="{l:Tr Main_RoleProxy}" Item1Param="proxy" Item1Active="{Binding IsProxyRole}"
              Item2Text="{l:Tr Main_RoleDirect}" Item2Param="direct" Item2Active="{Binding IsDirectRole}"
              Item3Text="{l:Tr Main_RoleBlock}" Item3Param="block" Item3Active="{Binding IsBlockRole}" />
          <!-- Role hint left; a blue link (Direct only) fills the Direct bucket with the machine's local subnets. -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding RoleHint}" Classes="muted" FontSize="11.5"
                       TextWrapping="Wrap" VerticalAlignment="Top" />
            <Button x:Name="AddLocalSubnetsLink" Grid.Column="1" Classes="linkbtn"
                    IsVisible="{Binding IsDirectRole}" Margin="12,0,0,0"
                    Command="{Binding AddLocalSubnetsCommand}" IsEnabled="{Binding !IsBusy}"
                    VerticalAlignment="Top" HorizontalAlignment="Right">
              <TextBlock Text="{l:Tr Main_AddLocalSubnetsButton}" TextWrapping="Wrap" />
            </Button>
          </Grid>
          <!-- The Proxy bucket is inert while the global proxy is on: everything already goes through the tunnel. -->
          <TextBlock Text="{l:Tr Main_RoleProxyUnusedWarning}" FontSize="11.5" TextWrapping="Wrap"
                     Foreground="{DynamicResource AgWarnBrush}" IsVisible="{Binding IsProxyBucketUnused}" />
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding Rules.Count}">
          <Border Height="1" Background="{DynamicResource AgBorderBrush}" Margin="0,0,0,8"
                  IsVisible="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact}" />
          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <TextBlock Grid.Column="0" Text="{l:Tr Main_EntriesLabel}" FontWeight="SemiBold" FontSize="15"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="icon" Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding SortRulesCommand}"
                    ToolTip.Tip="{l:Tr Main_SortRulesTooltip}">
              <PathIcon Data="{StaticResource AgRuleSortGeometry}" Width="14" Height="14" />
            </Button>
            <Button Grid.Column="3" Classes="linkbtn" Command="{Binding ClearRulesCommand}"
                    VerticalAlignment="Center" HorizontalAlignment="Right"
                    ToolTip.Tip="{l:Tr Main_ClearRulesTooltip}">
              <TextBlock Text="{l:Tr Main_ClearButton}" />
            </Button>
          </Grid>
          <Border Classes="rulebox"
                  Classes.compact="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact}">
            <ItemsControl ItemsSource="{Binding RuleItems}"
                          Margin="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=boxPad}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RoutingRuleItemViewModel">
                  <StackPanel Spacing="0">
                    <Border Background="{DynamicResource AgInsetBrush}"
                            BorderBrush="{DynamicResource AgBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10,7" Margin="0,3">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Token}" Classes="mono" FontSize="12.5"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <!-- Geo categories only: collapses the entries the rule expands to. -->
                        <Button Grid.Column="1" Classes="icon"
                                IsVisible="{Binding CanExpand}"
                                ToolTip.Tip="{l:Tr Main_RuleEntriesTooltip}"
                                Command="{Binding $parent[ItemsControl].((vm:RoutingListEditorViewModel)DataContext).ToggleRuleDetailsCommand}"
                                CommandParameter="{Binding}">
                          <!-- Scaled at render time: the glyph matches the delete cross without growing the row. -->
                          <TextBlock Text="{Binding Glyph}" RenderTransform="scale(1.5)" />
                        </Button>
                        <Button Grid.Column="2" Classes="icon"
                                Command="{Binding $parent[ItemsControl].((vm:RoutingListEditorViewModel)DataContext).RemoveRuleCommand}"
                                CommandParameter="{Binding Token}">
                          <PathIcon Data="{StaticResource AgRuleDeleteGeometry}" Width="14" Height="14" />
                        </Button>
                      </Grid>
                    </Border>

                    <!-- Expanded entries, indented under their item. -->
                    <Border IsVisible="{Binding IsExpanded}" Margin="14,0,0,6" Padding="10,7"
                            Background="{DynamicResource AgPanelBrush}"
                            BorderBrush="{DynamicResource AgBorderBrush}" BorderThickness="1" CornerRadius="8">
                      <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLoading}">
                          <PathIcon Classes.spin="{Binding IsLoading}" Data="{DynamicResource AgRefreshGeometry}"
                                    Width="12" Height="12" Foreground="{DynamicResource AgMutedBrush}"
                                    VerticalAlignment="Center" />
                          <TextBlock Text="{l:Tr Main_RoutingLoading}" Classes="muted" FontSize="12"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto"
                              IsVisible="{Binding DetailSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                          <TextBlock Grid.Column="0" Text="{Binding DetailSummary}" Classes="label"
                                     TextWrapping="Wrap" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Classes="linkbtn" Click="OnCopyRuleEntries"
                                  IsVisible="{Binding HasEntries}" VerticalAlignment="Center"
                                  ToolTip.Tip="{l:Tr Main_RoutingCopyTooltip}">
                            <TextBlock Text="{l:Tr Main_CopyButton}" />
                          </Button>
                        </Grid>
                        <!-- Whole category, one entry per row: the list realizes only the rows on screen, so a
                             country costs no more than a short one. -->
                        <ListBox ItemsSource="{Binding Entries}" IsVisible="{Binding HasEntries}"
                                 MaxHeight="220" CornerRadius="8" Padding="4,2" BorderThickness="0"
                                 Background="{DynamicResource AgInsetBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                          <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                              <Setter Property="Padding" Value="6,1" />
                              <Setter Property="MinHeight" Value="0" />
                            </Style>
                          </ListBox.Styles>
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                              <TextBlock Text="{Binding}" FontSize="11.5"
                                         FontFamily="IBM Plex Mono, Cascadia Mono, Consolas, monospace"
                                         Foreground="{DynamicResource AgMutedBrush}" />
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Per-routing traffic card: all-UDP + IPv6. -->
    <Border Classes="sect" Classes.compact="{Binding IsCompact}"
            IsVisible="{Binding RoutingSettings, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="14" DataContext="{Binding RoutingSettings}" x:DataType="vm:RoutingSettingsViewModel">
        <Border Height="1" Background="{DynamicResource AgBorderBrush}"
                IsVisible="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact}" />

        <!-- The section heading carries the switch itself: a separate row under it only said the heading again. -->
        <controls:SettingSwitchRow Heading="True" Label="{l:Tr Main_GlobalProxyTitle}"
                                   Description="{l:Tr Main_GlobalProxyHint}"
                                   IsChecked="{Binding UseGlobalProxy, Mode=TwoWay}" HorizontalAlignment="Stretch" />

        <Border Height="1" Background="{DynamicResource AgBorderBrush}"
                IsVisible="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact}" />

        <controls:SettingSwitchRow Heading="True" Label="{l:Tr Main_AllUdpTitle}" Description="{l:Tr Main_AllUdpHint}"
                                   IsChecked="{Binding AllUdp, Mode=TwoWay}" HorizontalAlignment="Stretch" />

        <Border Height="1" Background="{DynamicResource AgBorderBrush}"
                IsVisible="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact}" />

        <!-- The box stands beside its heading, where a switch stands in the rows around it. -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="40">
          <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{l:Tr Main_RouteTtlTitle}" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="{l:Tr Main_RouteTtlHint}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBox Classes="field" Classes.invalid="{Binding RouteTtlInvalid}" Width="90"
                     VerticalAlignment="Center" Text="{Binding RouteTtl, Mode=TwoWay}" />
            <TextBlock Text="{l:Tr General_Seconds}" Classes="muted" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>

        <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
