<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:views="clr-namespace:AmneziaGeo.Ui.Views"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             x:Class="AmneziaGeo.Ui.Views.DiagnosticsView"
             x:CompileBindings="True"
             x:DataType="vm:DiagnosticsViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="AgDownloadGeometry">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</StreamGeometry>
  </UserControl.Resources>
  <!-- Title, then the viewer; only the viewer body scrolls. Every source is picked in the viewer itself, so the
       screen carries nothing to switch between. -->
  <Grid RowDefinitions="Auto,*" RowSpacing="{Binding Logs.SectionSpacing}">

    <!-- Head: the title left, the archive support asks for right, its result line under both. The button stays
         when a low pane drops the title, since this screen is the only place the archive is offered. -->
    <StackPanel Grid.Row="0" Spacing="4">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Grid.Column="0" Classes="section" Text="{l:Tr Main_DiagnosticsSection}"
                   VerticalAlignment="Center" IsVisible="{Binding !Logs.IsShort}" />
        <Button Grid.Column="1" Classes="softbtn" Padding="12,5" VerticalAlignment="Center"
                ToolTip.Tip="{l:Tr Main_ArchiveHint}"
                IsEnabled="{Binding !ArchiveRunning}" Click="OnCollectArchive">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource AgDownloadGeometry}" Width="15" Height="15" />
            <TextBlock Text="{l:Tr Main_ArchiveButton}" />
          </StackPanel>
        </Button>
      </Grid>
      <TextBlock Text="{Binding ArchiveStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                 IsVisible="{Binding ArchiveStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <views:LogsView Grid.Row="1" DataContext="{Binding Logs}" />

  </Grid>
</UserControl>
