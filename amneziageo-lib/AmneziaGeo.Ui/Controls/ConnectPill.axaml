<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             x:Class="AmneziaGeo.Ui.Controls.ConnectPill"
             x:CompileBindings="True"
             x:DataType="vm:ConnectionViewModel">
  <!-- Connect / disconnect control: the retry counter (#197) then the animated pill; the inner circle and the
       text carry the state colour (gray off, orange while switching or while the server stays silent, blue
       connected). Shared by the settings header and the compact home header. -->
  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
    <TextBlock Text="{Binding ReserveText}" FontSize="11"
               Foreground="{Binding ConnectHintBrush}" VerticalAlignment="Center"
               IsVisible="{Binding ShowReserves}" />
    <TextBlock Text="{Binding RetryText}" FontSize="11" FontWeight="SemiBold"
               Foreground="{Binding ConnectStatusBrush}" VerticalAlignment="Center"
               IsVisible="{Binding ShowRetry}" />
    <Button x:Name="TogglePart" Classes="powerctl" VerticalAlignment="Center"
            Width="130" HorizontalContentAlignment="Left"
            Command="{Binding ToggleConnectionCommand}"
            IsEnabled="{Binding CanToggleConnection}"
            ToolTip.Tip="{Binding ConnectHint}">
      <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
        <Panel Width="28" Height="28">
          <Ellipse Classes="connspin" Classes.spinning="{Binding IsConnecting}"
                   Width="26" Height="26" Stroke="{Binding ConnectCircleForeground}"
                   StrokeThickness="2" StrokeDashArray="12,29" StrokeLineCap="Round"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border Width="22" Height="22" CornerRadius="11"
                  Background="{Binding ConnectCircleBrush}"
                  BorderBrush="{Binding ConnectCircleBorderBrush}" BorderThickness="1"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
            <PathIcon Data="{DynamicResource AgPowerGeometry}" Width="11" Height="11"
                      Foreground="{Binding ConnectCircleForeground}"
                      IsVisible="{Binding !IsConnecting}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Panel>
        <TextBlock Text="{Binding AgentStatusText}" FontSize="12" FontWeight="SemiBold"
                   Foreground="{Binding ConnectStatusBrush}" VerticalAlignment="Center" />
      </StackPanel>
    </Button>
  </StackPanel>
</UserControl>
