<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:views="clr-namespace:AmneziaGeo.Ui.Views"
             xmlns:svc="clr-namespace:AmneziaGeo.Ui.Services"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             x:Class="AmneziaGeo.Ui.Views.RoutingView"
             x:CompileBindings="True"
             x:DataType="vm:RoutingViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="AgPlusGeometry">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
    <StreamGeometry x:Key="AgCopyGeometry">M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z</StreamGeometry>
    <StreamGeometry x:Key="AgDownloadGeometry">M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z</StreamGeometry>
    <StreamGeometry x:Key="AgShareGeometry">M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.34C15.11,18.55 15.08,18.77 15.08,19C15.08,20.61 16.39,21.91 18,21.91C19.61,21.91 20.92,20.61 20.92,19A2.92,2.92 0 0,0 18,16.08Z</StreamGeometry>
  </UserControl.Resources>
  <!-- Cards stretch the full pane width. -->
  <!-- Брошенный на раздел файл добавляется в каталог: берутся только списки маршрутизации. -->
  <Grid RowDefinitions="Auto,*" Background="Transparent"
        controls:FileDropBehavior.Command="{Binding DropFilesCommand}">

    <!-- Шапка каталога: добавление списка маршрутизации. Способы «Добавить» выпадают списком у кнопки, а на
         телефоне приходят шторкой снизу. -->
    <StackPanel x:Name="CatalogueHeader" Grid.Row="0" Margin="0,12,0,0" Spacing="8"
                IsVisible="{Binding IsSectionCatalogue}">
      <Button x:Name="AddButton" Classes="methodpick" MinHeight="34" Padding="12,6" Click="OnAddOptions"
              HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}"
              MinWidth="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=minW130}">
        <StackPanel Orientation="Horizontal" Spacing="6"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource AgPlusGeometry}" Width="14" Height="14" VerticalAlignment="Center" />
          <TextBlock Text="{l:Tr Main_AddButton}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- Каталог пуст: списков ещё нет, добавление - единственный шаг. -->
      <TextBlock IsVisible="{Binding ShowNoListsHint}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                 Margin="0,4,0,0" Text="{l:Tr Main_NoRoutingListsHint}" />
    </StackPanel>

    <!-- Content: one section shown at a time. Up from its top row returns to the header, not to the window one. -->
    <Panel x:Name="Body" Grid.Row="1" Margin="0,14,0,0" KeyDown="OnBodyKeyDown">

      <!-- Каталог карточек: кнопка на карточке и двойной щелчок по ней открывают настройки своего списка,
           драг переставляет карточки. -->
      <Panel IsVisible="{Binding IsSectionCatalogue}">
        <!-- Узкий экран: карточки стоят одной колонкой во всю ширину. -->
        <ScrollViewer IsVisible="{Binding ShowCardStack}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding RoutingLists}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RoutingListSummaryViewModel">
                <controls:RoutingCard Margin="0,0,0,8"
                        OpenCommand="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).OpenCardCommand}"
                        SelectCommand="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).SelectCardCommand}"
                        DropCommand="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).ApplyOrderCommand}"
                        PickCommand="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).PickCardCommand}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Широкий экран: карточки стоят в две равные колонки во всю их ширину. -->
        <ScrollViewer IsVisible="{Binding ShowCardGrid}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding RoutingLists}" VerticalAlignment="Top">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RoutingListSummaryViewModel">
                <controls:RoutingCard Margin="0,0,10,10" VerticalAlignment="Top"
                        OpenCommand="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).OpenCardCommand}"
                        SelectCommand="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).SelectCardCommand}"
                        DropCommand="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).ApplyOrderCommand}"
                        PickCommand="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).PickCardCommand}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>

      <!-- Catalogue loader: the agent has not reported its routing lists yet (#134). -->
      <StackPanel IsVisible="{Binding ShowCatalogueLoader}" HorizontalAlignment="Center" Spacing="12" Margin="0,24">
        <ProgressBar IsIndeterminate="True" Width="150" HorizontalAlignment="Center" />
        <TextBlock Text="{l:Tr Main_RoutingLoading}" Classes="muted" FontSize="13" HorizontalAlignment="Center" />
      </StackPanel>

      <!-- Section loader until an opened list's rules + traffic settings finish (#193). -->
      <StackPanel IsVisible="{Binding ShowSettingsLoader}" HorizontalAlignment="Center" Spacing="12" Margin="0,24">
        <ProgressBar IsIndeterminate="True" Width="150" HorizontalAlignment="Center" />
        <TextBlock Text="{l:Tr Main_RoutingLoading}" Classes="muted" FontSize="13" HorizontalAlignment="Center" />
      </StackPanel>

      <!-- Settings section: the picked-list switch + the shared editor + delete. -->
      <StackPanel x:Name="SettingsSection" IsVisible="{Binding ShowSettingsEditor}">
        <!-- One frame around the whole settings block; below the card width it goes and the hairlines carry the boundaries. -->
        <Border Classes="sect">
          <StackPanel Spacing="14">
            <!-- Narrow screen: a hairline carries the section boundary the frame used to. -->
            <Border Classes="hairline" />

            <!-- Действует ли список: тумблер. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBlock Grid.Column="0" Text="{l:Tr Main_UseRoutingToggle}" FontWeight="SemiBold" FontSize="15"
                         TextWrapping="Wrap" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                            IsChecked="{Binding UseOpenList, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hairline" />

            <views:RoutingEditorView />

            <Border Classes="hairline" />

            <!-- Экспорт: способ - экран QR, текст списка в буфер или файл - выпадает списком у кнопки, а на
                 телефоне приходит шторкой снизу. -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10"
                  IsVisible="{Binding CanExportOpenList}">
              <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{l:Tr Main_ExportListTitle}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                <TextBlock Text="{l:Tr Main_TransferSubtitle}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Row="1" Grid.Column="0" Classes="methodpick" VerticalAlignment="Center"
                      Click="OnExportOptions"
                      Width="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w180}"
                      HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
                <StackPanel Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource AgShareGeometry}" Width="14" Height="14" VerticalAlignment="Center" />
                  <TextBlock Text="{l:Tr Main_ExportTab}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>

            <Border Classes="hairline" />

            <!-- Delete: description left, delete trigger right. When armed, the trigger is replaced in place by
                 the Confirm/Cancel pair sharing its footprint - one per column, each stretched (#4). -->
            <StackPanel Spacing="10" IsVisible="{Binding ShowDeleteCard}">
              <!-- The trigger stands under the description. -->
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="{l:Tr Main_DeleteListTitle}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding DeleteListPrompt}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <Grid Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                      Width="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w180}"
                      HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}"
                      ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Grid.ColumnSpan="2" Classes="danger" HorizontalAlignment="Stretch"
                          Content="{l:Tr Main_DeleteListButton}"
                          IsVisible="{Binding !RoutingDeletePending}"
                          Command="{Binding RequestDeleteSectionRoutingListCommand}" />
                  <Button Grid.Column="0" Classes="danger" HorizontalAlignment="Stretch"
                          Content="{l:Tr Main_ConfirmDeleteButton}"
                          IsVisible="{Binding RoutingDeletePending}"
                          Command="{Binding ConfirmDeleteSectionRoutingListCommand}" />
                  <Button Grid.Column="1" Classes="softbtn" HorizontalAlignment="Stretch"
                          Content="{l:Tr Main_CancelButton}"
                          IsVisible="{Binding RoutingDeletePending}"
                          Command="{Binding CancelDeleteRoutingCommand}" />
                </Grid>
              </Grid>
              <TextBlock Text="{Binding RoutingDeleteStatus}" Classes="fieldwarn" FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding RoutingDeleteStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Export section: QR / raw payload of the list, with copy / save. -->
      <StackPanel x:Name="ExportSection" IsVisible="{Binding IsSectionExport}" Spacing="12">
        <!-- Экран экспорта занимает пану целиком; возвращает с него стрелка «назад» в шапке окна. -->
        <TextBlock Text="{l:Tr Main_ExportListTitle}" FontWeight="SemiBold" FontSize="15"
                   TextWrapping="Wrap" VerticalAlignment="Center" />

        <Border Classes="sect">
          <StackPanel Spacing="12" DataContext="{Binding RoutingEditor}" x:DataType="vm:RoutingListEditorViewModel">
            <TextBlock Text="{l:Tr Main_TransferSubtitle}" Classes="muted" FontSize="12" TextWrapping="Wrap" />

            <!-- Segmented [QR | Конфиг]. -->
            <Border Background="{DynamicResource AgInsetBrush}"
                    BorderBrush="{DynamicResource AgBorderBrush}" BorderThickness="1"
                    CornerRadius="9" Padding="3" MaxWidth="420" HorizontalAlignment="Center">
              <UniformGrid Columns="2">
                <Button Classes="seg" Classes.active="{Binding IsTransferQr}" Command="{Binding ShowTransferQrCommand}"
                        Content="{l:Tr Main_TransferQrTab}" HorizontalAlignment="Stretch" Padding="20,6" />
                <Button Classes="seg" Classes.active="{Binding IsTransferText}" Command="{Binding ShowTransferTextCommand}"
                        Content="{l:Tr Main_TransferTextTab}" HorizontalAlignment="Stretch" Padding="20,6" />
              </UniformGrid>
            </Border>

            <!-- QR tab: fixed 240x240 stage so the image (or notice) appearing never reflows the card. -->
            <Panel Height="240" IsVisible="{Binding IsTransferQr}">
              <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="8" Padding="10"
                      IsVisible="{Binding RoutingQrImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Image Source="{Binding RoutingQrImage}" Width="220" Height="220" />
              </Border>
              <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource AgInsetBrush}"
                      BorderBrush="{DynamicResource AgBorderBrush}" BorderThickness="1"
                      CornerRadius="8" Padding="16" Width="240" IsVisible="{Binding QrUnavailable}">
                <TextBlock Text="{l:Tr Main_QrUnavailableHint}" Classes="muted" FontSize="12"
                           TextAlignment="Center" TextWrapping="Wrap" />
              </Border>
            </Panel>

            <!-- Config tab: the raw transfer payload, read-only and selectable. -->
            <TextBox Classes="field" Text="{Binding TransferText}" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="NoWrap" IsVisible="{Binding IsTransferText}"
                     VerticalContentAlignment="Top" Height="200"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="IBM Plex Mono, Cascadia Mono, Consolas, monospace" FontSize="12" />

            <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Export actions: copy, save and send all take the open form - the QR as a picture, the config
                 as text. Sending shows up where the platform carries it. -->
            <WrapPanel HorizontalAlignment="Center">
              <Button Classes="methodpick" Margin="4" Padding="14,6" Click="OnRoutingExportCopy"
                      IsEnabled="{Binding TransferReady}"
                      ToolTip.Tip="{l:Tr Main_RoutingCopyTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource AgCopyGeometry}" Width="14" Height="14" />
                  <TextBlock Text="{l:Tr Main_CopyButton}" />
                </StackPanel>
              </Button>
              <Button Classes="accent" Margin="4" Padding="14,6" Click="OnRoutingExportSave"
                      IsEnabled="{Binding TransferReady}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource AgDownloadGeometry}" Width="14" Height="14" />
                  <TextBlock Text="{l:Tr Main_SaveToFileButton}" />
                </StackPanel>
              </Button>
              <Button Classes="methodpick" Margin="4" Padding="14,6" Click="OnRoutingExportSend"
                      IsVisible="{Binding CanSendExport}" IsEnabled="{Binding TransferReady}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource AgShareGeometry}" Width="14" Height="14" />
                  <TextBlock Text="{l:Tr Main_SendToAppButton}" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Черновик нового списка: способ уже выбран в шторке, имя списка называет сам редактор, отсюда ведут
           «Сохранить» и «Отмена» в футере. -->
      <Border x:Name="ImportEditor" Classes="sect" IsVisible="{Binding ShowImportEditor}">
        <views:RoutingEditorView />
      </Border>

      <!-- Import section - live QR scanner. -->
      <Panel IsVisible="{Binding ShowImportCamera}" MinHeight="220">
        <views:ScanView DataContext="{Binding SectionScan}" />
      </Panel>

    </Panel>
  </Grid>
</UserControl>
