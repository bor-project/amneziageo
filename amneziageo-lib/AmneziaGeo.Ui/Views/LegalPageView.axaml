<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:views="clr-namespace:AmneziaGeo.Ui.Views"
             x:Class="AmneziaGeo.Ui.Views.LegalPageView"
             x:CompileBindings="True"
             x:DataType="vm:LegalViewModel">
  <StackPanel Spacing="14">
    <TextBlock Classes="section" Text="{Binding Title}" TextWrapping="Wrap" />
    <Border Classes="sect">
      <StackPanel Spacing="10">
        <StackPanel Spacing="2" IsVisible="{Binding HasVersion}">
          <TextBlock Text="{Binding VersionLine}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
          <TextBlock Text="{Binding AcceptedLine}" Classes="muted" FontSize="12.5" TextWrapping="Wrap"
                     IsVisible="{Binding HasAcceptedLine}" />
        </StackPanel>
        <views:LegalView />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
