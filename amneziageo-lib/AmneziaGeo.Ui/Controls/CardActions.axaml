<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             x:Class="AmneziaGeo.Ui.Controls.CardActions"
             x:CompileBindings="True"
             x:DataType="vm:ConfigItemViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="AgCardEditGeometry">M20.71 7.04c.39-.39.39-1.04 0-1.41l-2.34-2.34c-.37-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83zM3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z</StreamGeometry>
    <StreamGeometry x:Key="AgCardDeleteGeometry">M9 3v1H4v2h1v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V6h1V4h-5V3H9zm0 5h2v9H9V8zm4 0h2v9h-2V8z</StreamGeometry>
    <StreamGeometry x:Key="AgCardConfirmGeometry">M21 7L9 19l-5.5-5.5 1.41-1.41L9 16.17 19.59 5.59 21 7z</StreamGeometry>
    <StreamGeometry x:Key="AgCardCancelGeometry">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
  </UserControl.Resources>

  <!-- The pair the card carries: edit and delete, and the confirm and cancel the armed delete puts in their
       place - the footprint stays the same, so nothing under the finger resizes. They take focus only while
       the remote stands inside the card. -->
  <Grid x:Name="Part" ColumnDefinitions="Auto,Auto">
    <Button Grid.Column="0" Classes="rowact"
            Width="{Binding $parent[controls:CardActions].ButtonWidth}"
            Height="{Binding $parent[controls:CardActions].ButtonHeight}"
            Focusable="{Binding $parent[controls:ServerCard].Entered}"
            IsVisible="{Binding !DeletePending}" ToolTip.Tip="{l:Tr Main_EditButton}"
            Command="{Binding $parent[controls:ServerCard].EditCommand}" CommandParameter="{Binding}">
      <Border Classes="rowactcard">
        <PathIcon Data="{StaticResource AgCardEditGeometry}" Width="19" Height="19"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Foreground="{Binding $parent[Button].Foreground}" />
      </Border>
    </Button>
    <Button Grid.Column="1" Classes="rowact drop"
            Width="{Binding $parent[controls:CardActions].ButtonWidth}"
            Height="{Binding $parent[controls:CardActions].ButtonHeight}"
            Focusable="{Binding $parent[controls:ServerCard].Entered}"
            IsVisible="{Binding !DeletePending}" ToolTip.Tip="{l:Tr Main_ConfirmDeleteButton}"
            Command="{Binding RequestDeleteCommand}">
      <Border Classes="rowactcard">
        <PathIcon Data="{StaticResource AgCardDeleteGeometry}" Width="19" Height="19"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Foreground="{Binding $parent[Button].Foreground}" />
      </Border>
    </Button>

    <Button Grid.Column="0" Classes="rowact drop"
            Width="{Binding $parent[controls:CardActions].ButtonWidth}"
            Height="{Binding $parent[controls:CardActions].ButtonHeight}"
            Focusable="{Binding $parent[controls:ServerCard].Entered}"
            IsVisible="{Binding DeletePending}" ToolTip.Tip="{l:Tr Main_ConfirmButton}"
            Command="{Binding $parent[controls:ServerCard].DeleteCommand}" CommandParameter="{Binding}">
      <Border Classes="rowactcard">
        <PathIcon Data="{StaticResource AgCardConfirmGeometry}" Width="20" Height="20"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Foreground="{Binding $parent[Button].Foreground}" />
      </Border>
    </Button>
    <Button Grid.Column="1" Classes="rowact"
            Width="{Binding $parent[controls:CardActions].ButtonWidth}"
            Height="{Binding $parent[controls:CardActions].ButtonHeight}"
            Focusable="{Binding $parent[controls:ServerCard].Entered}"
            IsVisible="{Binding DeletePending}" ToolTip.Tip="{l:Tr Main_CancelButton}"
            Command="{Binding CancelDeleteCommand}">
      <Border Classes="rowactcard">
        <PathIcon Data="{StaticResource AgCardCancelGeometry}" Width="19" Height="19"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Foreground="{Binding $parent[Button].Foreground}" />
      </Border>
    </Button>
  </Grid>
</UserControl>
