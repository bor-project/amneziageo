+func TestHubReporterPanicReleasesDatagramAndPropagates(t *testing.T) {
+	marker := &struct{}{}
+	h := &Hub{}
+	HubDiscardReporter(func(int32, int32) { panic(marker) })(h)
+	packet := buf.New()
+	packet.Extend(7)
+	var caught interface{}
+	func() {
+		defer func() { caught = recover() }()
+		h.discard(packet)
+	}()
+	if caught != marker {
+		t.Fatal("callback panic contract changed")
+	}
+	if packet.Len() != 0 {
+		t.Fatal("panicking hub callback retained discarded buffer")
+	}
+}
