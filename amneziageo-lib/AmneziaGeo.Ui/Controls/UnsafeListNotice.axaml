<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             xmlns:svc="clr-namespace:AmneziaGeo.Ui.Services"
             x:Class="AmneziaGeo.Ui.Controls.UnsafeListNotice"
             x:Name="Root">
  <!-- Список ведёт через VPN всё, кроме выбранного: почему он опасен и ссылка на сайт. -->
  <Border Background="{DynamicResource AgWarnSoftBrush}" CornerRadius="8" Padding="10,8">
    <Grid ColumnDefinitions="Auto,*">
      <PathIcon Grid.Column="0" Data="{DynamicResource AgAlertGeometry}" Width="16" Height="16"
                VerticalAlignment="Top" Margin="0,0,8,0" Foreground="{DynamicResource AgWarnBrush}" />
      <!-- Ссылка продолжает текст и встаёт своей строкой, когда текст занимает ширину. -->
      <WrapPanel Grid.Column="1">
        <TextBlock Text="{Binding #Root.Text}" FontSize="12" TextWrapping="Wrap"
                   VerticalAlignment="Center" Foreground="{DynamicResource AgWarnBrush}" />
        <Button Classes="linkbtn" FontSize="12" VerticalAlignment="Center"
                Command="{x:Static svc:SitePages.FullModeCommand}">
          <TextBlock Text="{l:Tr Main_UnsafeListMore}" />
        </Button>
      </WrapPanel>
    </Grid>
  </Border>
</UserControl>
