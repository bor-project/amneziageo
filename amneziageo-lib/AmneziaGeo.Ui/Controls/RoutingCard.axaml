<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             x:Class="AmneziaGeo.Ui.Controls.RoutingCard"
             x:CompileBindings="True"
             x:DataType="vm:RoutingListSummaryViewModel"
             Design.DataContext="{x:Static vm:DesignData.RoutingCard}"
             Design.Width="340">
  <!-- Применение и настройки стоят на кнопках. На телевизоре тело служит входом, дальше пульт ходит
       по этим же контролам. -->
  <Button x:Name="FacePart" Classes="serverrow noclick" Classes.off="{Binding !IsSelected}">
    <Panel>
      <Grid RowDefinitions="Auto,Auto">
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="12,10">
          <!-- Имя списка и его применение: круг стоит на месте кнопки подключения карточки сервера. -->
          <Grid Grid.Row="0" Classes="cardhead" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

            <Button x:Name="ActivePart" Grid.Column="1" Classes="cardpower" VerticalAlignment="Center"
                    ClickMode="Press" ToolTip.Tip="{l:Tr Main_CardActiveFlag}"
                    Command="{Binding $parent[controls:RoutingCard].SelectCommand}"
                    CommandParameter="{Binding}">
              <Panel Width="42" Height="42">
                <Border Classes="cardradio" Classes.on="{Binding IsSelected}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Ellipse Width="18" Height="18" Fill="{DynamicResource AgAccentBrush}"
                           IsVisible="{Binding IsSelected}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Panel>
            </Button>
          </Grid>

          <!-- Состав списка: сколько правил уводит в туннель, сколько пускает мимо и сколько глушит. -->
          <StackPanel Grid.Row="1" Classes="cardinfo" Orientation="Horizontal" Spacing="10" Margin="0,8,0,0"
                      VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                       Fill="{DynamicResource AgAccentBrush}" />
              <TextBlock Text="{Binding ProxyRulesText}" FontSize="12" Classes="muted"
                         VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                       Fill="{DynamicResource AgMutedBrush}" />
              <TextBlock Text="{Binding DirectRulesText}" FontSize="12" Classes="muted"
                         VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                       Fill="{DynamicResource AgDownBrush}" />
              <TextBlock Text="{Binding BlockRulesText}" FontSize="12" Classes="muted"
                         VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- Подвал карточки: метки режимов слева, настройки списка справа. -->
        <Border Grid.Row="1" Classes="cardfoot">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <controls:CardTags x:Name="TagsPart" Grid.Column="0" Tags="{Binding Tags}" VerticalAlignment="Center" />
            <!-- Шестерёнка встаёт под круг применения: поле повторяет его ширину. -->
            <Panel Grid.Column="1" Width="42">
              <Button x:Name="SettingsPart" Classes="methodpick cardgear" HorizontalAlignment="Center"
                      ToolTip.Tip="{l:Tr Main_CardSettingsLink}"
                      Command="{Binding $parent[controls:RoutingCard].OpenCommand}" CommandParameter="{Binding}">
                <PathIcon Data="{DynamicResource AgGearGeometry}" Width="15" Height="15" />
              </Button>
            </Panel>
          </Grid>
        </Border>
      </Grid>

      <!-- Светлая рамка у всякой карточки; поверх неё рамка выбранного в каталоге - цветом его подключения.
           Рисуется поверх содержимого и компоновки не меняет. -->
      <Border BorderThickness="1" CornerRadius="12" IsHitTestVisible="False"
              BorderBrush="{DynamicResource AgBorder2Brush}" />
      <Border BorderThickness="1.5" CornerRadius="12" IsHitTestVisible="False"
              BorderBrush="{DynamicResource AgAccentBrush}" BoxShadow="0 0 14 0 #552A6FDB"
              IsVisible="{Binding IsSelected}" />
      <Border BorderThickness="1" CornerRadius="12" IsHitTestVisible="False"
              BorderBrush="{Binding CardFrameBrush}" IsVisible="{Binding ShowCardFrame}" />
    </Panel>
  </Button>
</UserControl>
