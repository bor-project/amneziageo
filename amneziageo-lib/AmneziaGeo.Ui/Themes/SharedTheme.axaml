<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ti="using:Avalonia.Input.TextInput"
        xmlns:svc="using:AmneziaGeo.Ui.Services">

  <!-- Shared control styles. No hover effect app-wide; feedback is press opacity only. -->
    <FluentTheme />

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AgPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #14000000" />
    </Style>

    <!-- Section card inside the settings pane. Below the card width the frame only eats width, so it goes and the
         section reads by its own heading; the width is gated in one place for every settings screen. -->
    <Style Selector="Border.sect">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorderBrush}" />
      <Setter Property="BorderThickness"
              Value="{Binding IsCardless, Source={x:Static svc:UiLayout.Instance},
                              Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=cardEdge}" />
      <Setter Property="CornerRadius"
              Value="{Binding IsCardless, Source={x:Static svc:UiLayout.Instance},
                              Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=cardRadius}" />
      <Setter Property="Padding"
              Value="{Binding IsCardless, Source={x:Static svc:UiLayout.Instance},
                              Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=cardPad}" />
    </Style>

    <!-- Section boundary the dropped frame leaves behind. -->
    <Style Selector="Border.hairline">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource AgBorderBrush}" />
      <Setter Property="IsVisible" Value="{Binding IsCardless, Source={x:Static svc:UiLayout.Instance}}" />
    </Style>

    <!-- Frame around a list of rows. A narrow screen drops it: the rows carry their own outlines. -->
    <Style Selector="Border.rulebox">
      <Setter Property="Background" Value="{DynamicResource AgPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="Border.rulebox.compact">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Border.subcard">
      <Setter Property="Background" Value="{DynamicResource AgPanel2Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="Border.inset">
      <Setter Property="Background" Value="{DynamicResource AgInsetBrush}" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AgFgBrush}" />
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AgMutedBrush}" />
      <Setter Property="LetterSpacing" Value="0.5" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource AgMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="IBM Plex Mono, Cascadia Mono, Consolas, monospace" />
    </Style>

    <!-- Shared text-button base: 11.5px medium label, centered. -->
    <Style Selector="Button.softbtn, Button.danger">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Segmented-control button: shared by SegmentedSelector and the inline export/logs segments.
         One selected look app-wide so no segment reads as an action button. box-sizing parity: the
         inactive segment carries a transparent 1px border so it keeps the active segment's height. -->
    <Style Selector="Button.seg">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AgMutedBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.seg.active">
      <Setter Property="Background" Value="{DynamicResource AgPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorder2Brush}" />
      <Setter Property="Foreground" Value="{DynamicResource AgFgBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Selected segment lift: soft shadow that separates it from the track. -->
    <Style Selector="Button.seg.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="0 1 2 0 #1A101828" />
    </Style>

    <!-- Segmented-control track: content-width and left when wide (cap + alignment set inline on the control),
         full-width in compact. The 900px-class touch step is folded onto the app's compact signal: 44px height
         when narrow, 36px otherwise. -->
    <Style Selector="Border.segtrack">
      <Setter Property="Background" Value="{DynamicResource AgInsetBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Border.segtrack.compact Button.seg">
      <Setter Property="MinHeight" Value="44" />
    </Style>

    <!-- Second-level track: sits under a segmented control, so it drops the track and draws only the selected
         chip. Content-width and left in both layouts. -->
    <Style Selector="Border.segtrack.sub">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.segtrack.sub Button.seg">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style Selector="Button.softbtn">
      <Setter Property="Background" Value="{DynamicResource AgInsetBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorder2Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource AgFgBrush}" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- Shared soft/accent button base: 12px semibold, centered, borderless. -->
    <Style Selector="Button.methodpick, Button.accent">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- Soft-fill accent button: inset background, no border, blue text. -->
    <Style Selector="Button.methodpick">
      <Setter Property="Background" Value="{DynamicResource AgInsetBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AgAccentBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource AgAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter, Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AgAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.accent:pressed">
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AgAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- Save over a setting that did not answer: it still saves, dimmed to say so. -->
    <Style Selector="Button.accent.unverified">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <!-- Picked member of a row of soft buttons: it keeps the row's border box, so picking moves nothing. -->
    <Style Selector="Button.softbtn.accent">
      <Setter Property="BorderBrush" Value="{DynamicResource AgAccentBrush}" />
    </Style>

    <!-- Question standing over the whole screen: a card of its own, a step above the ones behind it. -->
    <Style Selector="Border.dialogcard">
      <Setter Property="Background" Value="{DynamicResource AgPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BoxShadow" Value="0 18 44 0 #59000000" />
    </Style>
    <!-- The answer that removes something: filled in the colour the delete wears everywhere else. -->
    <Style Selector="Button.dropfill">
      <Setter Property="Background" Value="{DynamicResource AgDownBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.dropfill /template/ ContentPresenter#PART_ContentPresenter, Button.dropfill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AgDownBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgDownBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.dropfill:pressed">
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <!-- The answer that leaves everything as it was: outline only. -->
    <Style Selector="Button.outline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgFgBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource AgFgBrush}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.outline /template/ ContentPresenter#PART_ContentPresenter, Button.outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgFgBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AgFgBrush}" />
    </Style>
    <Style Selector="Button.outline:pressed">
      <Setter Property="Opacity" Value="0.72" />
    </Style>

    <!-- Кнопка на карточке: светлая рамка и заливка панели, чтобы не спорить с текстом рядом. -->
    <!-- Плашка состояния и адрес на карточке каталога. -->
    <Style Selector="Border.cardpill, Border.cardchip">
      <Setter Property="Background" Value="{DynamicResource AgInsetBrush}" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Метка режима на карточке списка: включённый режим носит цвет действия, выключенный уходит в серое. -->
    <Style Selector="Border.cardtag TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AgAccentBrush}" />
    </Style>
    <Style Selector="Border.cardtag.off">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Border.cardtag.off TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AgMutedBrush}" />
    </Style>

    <!-- Подвал карточки: действия отделены полосой, фон остаётся карточкин - на нём видны мягкие кнопки. -->
    <Style Selector="Border.cardfoot">
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="CornerRadius" Value="0,0,12,12" />
      <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- Button icons follow the button's text colour. -->
    <Style Selector="Button PathIcon">
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>

    <!-- Destructive action. -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#E0A0A0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#D64545" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AgMutedBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- Round on/off connection control: soft inset pill; the inner circle + text carry the state colour. -->
    <Style Selector="Button.powerctl">
      <Setter Property="Background" Value="{DynamicResource AgInsetBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="5,3,11,3" />
    </Style>

    <!-- Inline text link: transparent, accent text, no chrome; shared by "Add local networks" and "Hide settings".
         The padding carries the focus ring, which is drawn on the bounds and would otherwise lie on the glyphs. -->
    <Style Selector="Button.linkbtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AgAccentBrush}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Снятие туннеля на карточке: место кнопки подключения, тон спокойнее. -->
    <Style Selector="Button.linkbtn.down">
      <Setter Property="Foreground" Value="{DynamicResource AgMutedBrush}" />
    </Style>

    <!-- Header back button. -->
    <Style Selector="Button.backbtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AgMutedBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- Large round connection control on the home screen. -->
    <Style Selector="Button.powerbig">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="120" />
    </Style>

    <!-- Active-item radio. -->
    <Style Selector="Button.radiopick">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- Flat selectable list row. -->
    <Style Selector="Button.rowselect">
      <Setter Property="Background" Value="{DynamicResource AgPanel2Brush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.rowselect.active">
      <Setter Property="Background" Value="{DynamicResource AgAccentSoftBrush}" />
    </Style>
    <!-- Home server row: a flat card whose frame, not its fill, carries the connection state. -->
    <Style Selector="Button.serverrow">
      <Setter Property="Background" Value="{DynamicResource AgPanelBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- Idle card: a dimmer fill than the applied one. -->
    <Style Selector="Button.serverrow.off">
      <Setter Property="Background" Value="{DynamicResource AgPanel2Brush}" />
    </Style>
    <Style Selector="Button.serverrow:focus-visible">
      <Setter Property="FocusAdorner">
        <Template>
          <Border BorderBrush="{DynamicResource AgAccentBrush}" BorderThickness="3" CornerRadius="12" />
        </Template>
      </Setter>
    </Style>

    <!-- Buttons the swipe uncovers: the button is the touch target and holds no fill of its own, the card
         inside it is what shows - a card as tall as the row they sit behind, carrying a coloured glyph. -->
    <Style Selector="Button.rowact">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource AgAccentBrush}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.rowact Border.rowactcard">
      <Setter Property="Background" Value="{DynamicResource AgInsetBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Margin" Value="2,0" />
    </Style>
    <!-- Ring on the card, not on the touch target around it. -->
    <Style Selector="Button.rowact:focus-visible">
      <Setter Property="FocusAdorner">
        <Template>
          <Border BorderBrush="{DynamicResource AgAccentBrush}" BorderThickness="3" CornerRadius="10"
                  Margin="2,0" />
        </Template>
      </Setter>
    </Style>
    <Style Selector="Button.rowact.drop">
      <Setter Property="Foreground" Value="{DynamicResource AgDownBrush}" />
    </Style>

    <!-- Menu the server card opens: a card of the same make, with room around its rows. -->
    <Style Selector="Border.cardmenu">
      <Setter Property="Background" Value="{DynamicResource AgPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="BoxShadow" Value="0 8 20 0 #33000000" />
    </Style>
    <Style Selector="Button.cardmenurow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.cardmenurow:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AgInsetBrush}" />
    </Style>
    <Style Selector="Border.cardmenuline">
      <Setter Property="Background" Value="{DynamicResource AgBorderBrush}" />
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="8,3" />
    </Style>

    <!-- Строка способа в шторке «Добавить» / «Экспорт». -->
    <Style Selector="Button.sheetrow">
      <Setter Property="Background" Value="{DynamicResource AgInsetBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- Connect button on a server card, bigger on the narrow screen a finger works. -->
    <Style Selector="Button.cardact">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="32" />
    </Style>
    <Style Selector="Button.cardact PathIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Button.cardact.big">
      <Setter Property="Width" Value="76" />
      <Setter Property="Height" Value="46" />
    </Style>
    <Style Selector="Button.cardact.big PathIcon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
    </Style>

    <!-- Compact settings menu: rows are navigation (a tap opens the detail and replaces the rail), so drop the
         radio dot and the selected-row highlight. Wide keeps them - the rail sits beside the open panel. -->
    <Style Selector="StackPanel.railmenu StackPanel.railtext">
      <Setter Property="Margin" Value="11,0,0,0" />
    </Style>
    <Style Selector="StackPanel.railmenu.compact Grid.railradio">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="StackPanel.railmenu.compact StackPanel.railtext">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="StackPanel.railmenu.compact Button.rowselect.active">
      <Setter Property="Background" Value="{DynamicResource AgPanel2Brush}" />
    </Style>

    <!-- Pin button content-presenter colours in every state; no hover recolour app-wide. -->
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions" Value="{x:Null}" />
      <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
      <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button:pressed /template/ ContentPresenter#PART_ContentPresenter, Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
      <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>

    <Style Selector="Button">
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <!-- Press leaves the card alone: the body is not clickable, the frame answers. Stands after the
         opacity rule above, so it wins. -->
    <Style Selector="Button.serverrow:pressed">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- D-pad / keyboard focus ring: a bright accent outline drawn on the control bounds, so remote and
         keyboard focus stays visible on Android TV. A ring outside the bounds is clipped by the adorner layer. -->
    <Style Selector="Button:focus-visible, ComboBox:focus-visible, ToggleSwitch:focus-visible, CheckBox:focus-visible, TextBox:focus-visible, AutoCompleteBox:focus-visible">
      <Setter Property="FocusAdorner">
        <Template>
          <Border BorderBrush="{DynamicResource AgAccentBrush}" BorderThickness="3" CornerRadius="9" />
        </Template>
      </Setter>
    </Style>
    <!-- Round home connect control: the ring lives in the button content and takes the current status colour,
         so it is shown and hidden by these rules instead of by an adorner. -->
    <Style Selector="Button.powerbig Ellipse.focusring">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.powerbig:focus-visible Ellipse.focusring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Section-rail rows: ring matching their 12px corner. -->
    <Style Selector="Button.rowselect:focus-visible">
      <Setter Property="FocusAdorner">
        <Template>
          <Border BorderBrush="{DynamicResource AgAccentBrush}" BorderThickness="3" CornerRadius="12" />
        </Template>
      </Setter>
    </Style>
    <!-- Accent-filled buttons: a light ring, an accent one is invisible on their own fill. -->
    <Style Selector="Button.accent:focus-visible">
      <Setter Property="FocusAdorner">
        <Template>
          <Border BorderBrush="White" BorderThickness="3" CornerRadius="9" />
        </Template>
      </Setter>
    </Style>
    <!-- Switch: the ring is drawn on the template focus target, which carries a 12px spacer column for the
         (empty) on/off labels and a 1px band above and below the knob. The margin trims it onto the knob. -->
    <Style Selector="ToggleSwitch:focus-visible">
      <Setter Property="FocusAdorner">
        <Template>
          <Border BorderBrush="{DynamicResource AgAccentBrush}" BorderThickness="3" CornerRadius="10"
                  Margin="0,1,12,1" />
        </Template>
      </Setter>
    </Style>

    <!-- Connection controls already express unavailable/disconnected state through their own colours. -->
    <Style Selector="Button.powerbig:disabled, Button.powerctl:disabled">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="TextBox.field">
      <Setter Property="Background" Value="{DynamicResource AgPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorder2Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="13" />
      <!-- Fill the pane width like ComboBox.field, so form fields line up with the combos above/below
           them. An authored Width still wins (Stretch is ignored when a Width is set). -->
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Names the field multiline for the on-screen keyboard: its return key breaks the line instead of
         closing the edit. -->
    <Style Selector="TextBox[AcceptsReturn=True]">
      <Setter Property="ti:TextInputOptions.Multiline" Value="True" />
    </Style>

    <!-- Pin text-input border on the template PART in every state. -->
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Transitions" Value="{x:Null}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorder2Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{Binding $parent[TextBox].Background}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement, TextBox:focus /template/ Border#PART_BorderElement, TextBox:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorder2Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{Binding $parent[TextBox].Background}" />
    </Style>

    <!-- Required-field red border in every state. -->
    <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement, TextBox.invalid:pointerover /template/ Border#PART_BorderElement, TextBox.invalid:focus /template/ Border#PART_BorderElement, TextBox.invalid:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource AgDownBrush}" />
    </Style>

    <!-- Warning line paired with a .invalid field. -->
    <Style Selector="TextBlock.fieldwarn">
      <Setter Property="Foreground" Value="{DynamicResource AgDownBrush}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="ComboBox.field">
      <Setter Property="Background" Value="{DynamicResource AgPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorder2Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource AgFgBrush}" />
      <!-- Reset the inherited Fluent ComboBoxThemeMinWidth (120) so authored narrow
           Width values (e.g. the 92px "24 ч" combos) are honored, not clamped wider. -->
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- Flicker-free closed ComboBox.field. -->
    <Style Selector="ComboBox.field /template/ Border#Background">
      <Setter Property="Transitions" Value="{x:Null}" />
      <Setter Property="Background" Value="{DynamicResource AgPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorder2Brush}" />
    </Style>
    <Style Selector="ComboBox.field:pointerover /template/ Border#Background, ComboBox.field:pressed /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource AgPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorder2Brush}" />
    </Style>
    <Style Selector="ComboBox.field:pressed">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="ComboBox.field:focus-visible /template/ Border#HighlightBackground">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorder2Brush}" />
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="ComboBox.field /template/ ContentControl#ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource AgFgBrush}" />
    </Style>
    <Style Selector="ComboBox.field /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="{DynamicResource AgMutedBrush}" />
    </Style>
    <Style Selector="ComboBox.field:disabled /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource AgPanel2Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorder2Brush}" />
    </Style>
    <Style Selector="ComboBox.field:disabled /template/ ContentControl#ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource AgMuted2Brush}" />
    </Style>

    <!-- Match AutoCompleteBox.field to TextBox.field via its inner text box. -->
    <Style Selector="AutoCompleteBox.field">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="AutoCompleteBox.field /template/ TextBox#PART_TextBox">
      <Setter Property="Background" Value="{DynamicResource AgPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgBorder2Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Compact, text-less toggle: drop the default (untranslated) "On/Off" labels and the
         WinUI-inherited wide MinWidth, so a switch is just the knob and never widens/clips its row. -->
    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="" />
      <Setter Property="OffContent" Value="" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="ToggleSwitch /template/ ContentPresenter#PART_OnContentPresenter">
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="ToggleSwitch /template/ ContentPresenter#PART_OffContentPresenter">
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- Keep enabled switches vivid in normal and pointer-over states. The checked track uses the accent
         with a white knob; the unchecked track keeps its meaning through an accent outline and knob. A press
         changes only opacity, mirroring accent buttons instead of swapping in Fluent's pressed palette. -->
    <Style Selector="ToggleSwitch /template/ Border#OuterBorder, ToggleSwitch:pointerover /template/ Border#OuterBorder, ToggleSwitch:pressed /template/ Border#OuterBorder">
      <Setter Property="Background" Value="{DynamicResource AgPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgAccentBrush}" />
    </Style>
    <Style Selector="ToggleSwitch /template/ Ellipse#SwitchKnobOff, ToggleSwitch:pointerover /template/ Ellipse#SwitchKnobOff, ToggleSwitch:pressed /template/ Ellipse#SwitchKnobOff">
      <Setter Property="Fill" Value="{DynamicResource AgAccentBrush}" />
    </Style>
    <Style Selector="ToggleSwitch /template/ Border#SwitchKnobBounds, ToggleSwitch:pointerover /template/ Border#SwitchKnobBounds, ToggleSwitch:pressed /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="{DynamicResource AgAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgAccentBrush}" />
    </Style>
    <Style Selector="ToggleSwitch /template/ Ellipse#SwitchKnobOn, ToggleSwitch:pointerover /template/ Ellipse#SwitchKnobOn, ToggleSwitch:pressed /template/ Ellipse#SwitchKnobOn">
      <Setter Property="Fill" Value="White" />
    </Style>
    <Style Selector="ToggleSwitch:pressed">
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="ToggleSwitch:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Drop the WinUI-inherited 120px MinWidth: the focus ring is drawn on the control bounds, and a short
         label left it framing empty space next to the box. -->
    <Style Selector="CheckBox">
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- Checkbox flags follow the same interaction rule while preserving checked/unchecked semantics. -->
    <Style Selector="CheckBox /template/ ContentPresenter#PART_ContentPresenter, CheckBox:pointerover /template/ ContentPresenter#PART_ContentPresenter, CheckBox:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource AgFgBrush}" />
    </Style>
    <Style Selector="CheckBox /template/ Border#NormalRectangle, CheckBox:pointerover /template/ Border#NormalRectangle, CheckBox:pressed /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgAccentBrush}" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle, CheckBox:checked:pointerover /template/ Border#NormalRectangle, CheckBox:checked:pressed /template/ Border#NormalRectangle, CheckBox:indeterminate /template/ Border#NormalRectangle, CheckBox:indeterminate:pointerover /template/ Border#NormalRectangle, CheckBox:indeterminate:pressed /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="{DynamicResource AgAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AgAccentBrush}" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph, CheckBox:checked:pointerover /template/ Path#CheckGlyph, CheckBox:checked:pressed /template/ Path#CheckGlyph, CheckBox:indeterminate /template/ Path#CheckGlyph, CheckBox:indeterminate:pointerover /template/ Path#CheckGlyph, CheckBox:indeterminate:pressed /template/ Path#CheckGlyph">
      <Setter Property="Fill" Value="White" />
    </Style>
    <Style Selector="CheckBox:pressed">
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="CheckBox:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Continuous rotation. -->
    <Style Selector="Control.spin">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="rotate(0)" />
    </Style>
    <Style Selector="Control.spin">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Connect-control spinner arc via StrokeDashOffset. -->
    <Style Selector="Ellipse.connspin">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Ellipse.connspin.spinning">
      <Setter Property="Opacity" Value="1" />
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE" Easing="LinearEasing">
          <KeyFrame Cue="0%"><Setter Property="StrokeDashOffset" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="StrokeDashOffset" Value="-41" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Opacity breathing busy indicator. -->
    <Style Selector="Control.pulse">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Opacity" Value="0.25" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Power-button ring wave during connect / disconnect. -->
    <Style Selector="Ellipse.ring">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Ellipse.r1.waveout">
      <Style.Animations>
        <Animation Duration="0:0:1.35" Delay="0:0:0" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="30%"><Setter Property="Opacity" Value="0.85" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Ellipse.r2.waveout">
      <Style.Animations>
        <Animation Duration="0:0:1.35" Delay="0:0:0.45" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="30%"><Setter Property="Opacity" Value="0.85" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Ellipse.r3.waveout">
      <Style.Animations>
        <Animation Duration="0:0:1.35" Delay="0:0:0.9" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="30%"><Setter Property="Opacity" Value="0.85" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Ellipse.r1.wavein">
      <Style.Animations>
        <Animation Duration="0:0:1.35" Delay="0:0:0.9" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="30%"><Setter Property="Opacity" Value="0.85" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Ellipse.r2.wavein">
      <Style.Animations>
        <Animation Duration="0:0:1.35" Delay="0:0:0.45" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="30%"><Setter Property="Opacity" Value="0.85" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Ellipse.r3.wavein">
      <Style.Animations>
        <Animation Duration="0:0:1.35" Delay="0:0:0" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="30%"><Setter Property="Opacity" Value="0.85" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Flicker-free ComboBox dropdown rows. -->
    <Style Selector="ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AgHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AgFgBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AgAccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AgFgBrush}" />
    </Style>
  

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="AgBg">#eceef1</Color>
          <Color x:Key="AgPanel">#ffffff</Color>
          <Color x:Key="AgPanel2">#f7f8fa</Color>
          <Color x:Key="AgSidebar">#e7e9ec</Color>
          <Color x:Key="AgBorder">#e4e6ea</Color>
          <Color x:Key="AgBorder2">#d2d6dd</Color>
          <Color x:Key="AgFg">#181b20</Color>
          <Color x:Key="AgMuted">#646c78</Color>
          <Color x:Key="AgMuted2">#9aa1ab</Color>
          <Color x:Key="AgAccent">#2a6fdb</Color>
          <Color x:Key="AgAccentSoft">#1A2a6fdb</Color>
          <Color x:Key="AgInset">#f0f2f5</Color>
          <Color x:Key="AgHover">#eef0f3</Color>
          <Color x:Key="AgUp">#1f9d57</Color>
          <Color x:Key="AgDown">#e0533d</Color>
          <Color x:Key="AgWarn">#cf9a17</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="AgBg">#0d1014</Color>
          <Color x:Key="AgPanel">#171a1f</Color>
          <Color x:Key="AgPanel2">#1d212a</Color>
          <Color x:Key="AgSidebar">#101317</Color>
          <Color x:Key="AgBorder">#262b33</Color>
          <Color x:Key="AgBorder2">#343a45</Color>
          <Color x:Key="AgFg">#e8ebf0</Color>
          <Color x:Key="AgMuted">#98a0ac</Color>
          <Color x:Key="AgMuted2">#5f6772</Color>
          <Color x:Key="AgAccent">#4d8df0</Color>
          <Color x:Key="AgAccentSoft">#294d8df0</Color>
          <Color x:Key="AgInset">#22272f</Color>
          <Color x:Key="AgHover">#1e232b</Color>
          <Color x:Key="AgUp">#34c77b</Color>
          <Color x:Key="AgDown">#f1664c</Color>
          <Color x:Key="AgWarn">#e6b23a</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <SolidColorBrush x:Key="AgBgBrush" Color="{DynamicResource AgBg}" />
      <SolidColorBrush x:Key="AgPanelBrush" Color="{DynamicResource AgPanel}" />
      <SolidColorBrush x:Key="AgPanel2Brush" Color="{DynamicResource AgPanel2}" />
      <SolidColorBrush x:Key="AgSidebarBrush" Color="{DynamicResource AgSidebar}" />
      <SolidColorBrush x:Key="AgBorderBrush" Color="{DynamicResource AgBorder}" />
      <SolidColorBrush x:Key="AgBorder2Brush" Color="{DynamicResource AgBorder2}" />
      <SolidColorBrush x:Key="AgFgBrush" Color="{DynamicResource AgFg}" />
      <SolidColorBrush x:Key="AgMutedBrush" Color="{DynamicResource AgMuted}" />
      <SolidColorBrush x:Key="AgMuted2Brush" Color="{DynamicResource AgMuted2}" />
      <SolidColorBrush x:Key="AgAccentBrush" Color="{DynamicResource AgAccent}" />
      <SolidColorBrush x:Key="AgAccentSoftBrush" Color="{DynamicResource AgAccentSoft}" />
      <SolidColorBrush x:Key="AgInsetBrush" Color="{DynamicResource AgInset}" />
      <SolidColorBrush x:Key="AgHoverBrush" Color="{DynamicResource AgHover}" />
      <SolidColorBrush x:Key="AgUpBrush" Color="{DynamicResource AgUp}" />
      <SolidColorBrush x:Key="AgDownBrush" Color="{DynamicResource AgDown}" />
      <SolidColorBrush x:Key="AgWarnBrush" Color="{DynamicResource AgWarn}" />

      <!-- Power glyph, shared by the round home control and the header pill. -->
      <StreamGeometry x:Key="AgPowerGeometry">M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42C17.99 7.86 19 9.81 19 12c0 3.87-3.13 7-7 7s-7-3.13-7-7c0-2.19 1.01-4.14 2.58-5.42L6.17 5.17C4.23 6.82 3 9.26 3 12c0 4.97 4.03 9 9 9s9-4.03 9-9c0-2.74-1.23-5.18-3.17-6.83z</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

</Styles>
