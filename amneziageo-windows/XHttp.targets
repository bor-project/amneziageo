<Project>
  <PropertyGroup>
    <XHttpArch Condition="'$(RuntimeIdentifier)' == 'win-arm64' or ('$(RuntimeIdentifier)' == '' and '$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64')">arm64</XHttpArch>
    <XHttpArch Condition="'$(XHttpArch)' == ''">x64</XHttpArch>
    <HttpGetCacheRoot>$(MSBuildThisFileDirectory).deps/http-get</HttpGetCacheRoot>
    <HttpGetTargetOS>windows</HttpGetTargetOS>
    <HttpGetTargetArch Condition="'$(XHttpArch)' == 'arm64'">arm64</HttpGetTargetArch>
    <HttpGetTargetArch Condition="'$(HttpGetTargetArch)' == ''">amd64</HttpGetTargetArch>
    <HttpGetExecutable>http-get-proxy.exe</HttpGetExecutable>
  </PropertyGroup>
  <Import Project="../tools/http-get-build/HttpGetRuntime.targets" />
</Project>
