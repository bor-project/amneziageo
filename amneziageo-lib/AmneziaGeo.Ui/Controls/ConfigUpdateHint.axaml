<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             x:Class="AmneziaGeo.Ui.Controls.ConfigUpdateHint"
             x:CompileBindings="True"
             x:DataType="vm:ConnectionViewModel"
             IsVisible="{Binding ShowConfigUpdate}">
  <!-- The subscription of some config waits for an update: the choice takes it or skips it till the next one. -->
  <Button x:Name="LinkPart" Classes="linkbtn" HorizontalAlignment="Center" Click="OnLinkClick">
    <TextBlock Text="{Binding ConfigUpdateText}" FontSize="12" FontWeight="SemiBold"
               TextAlignment="Center" TextWrapping="Wrap" Foreground="{Binding ConfigUpdateBrush}" />
    <FlyoutBase.AttachedFlyout>
      <MenuFlyout Placement="Bottom">
        <MenuItem Header="{l:Tr Main_ConfigUpdateApply}" Click="OnUpdateClick">
          <MenuItem.Icon>
            <PathIcon Data="{DynamicResource AgRefreshGeometry}" Width="14" Height="14" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{l:Tr Main_ConfigUpdateSkip}" Click="OnSkipClick">
          <MenuItem.Icon>
            <PathIcon Data="{DynamicResource AgCloseGeometry}" Width="12" Height="12" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuFlyout>
    </FlyoutBase.AttachedFlyout>
  </Button>
</UserControl>
