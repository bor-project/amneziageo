<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             x:Class="AmneziaGeo.Ui.Controls.CatalogCard"
             x:CompileBindings="True"
             x:DataType="vm:ConfigItemViewModel"
             Design.DataContext="{x:Static vm:DesignData.ConfigCard}"
             Design.Width="340">
  <!-- Действия карточки стоят на кнопках. На телевизоре тело служит входом, дальше пульт ходит
       по этим же контролам. -->
  <Button x:Name="FacePart" Classes="serverrow noclick">
    <Panel>
      <Grid RowDefinitions="Auto,Auto">
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="12,10">
          <!-- Имя и подключение: имя с адресом занимают строку целиком, кнопка жмётся последней. -->
          <Grid Grid.Row="0" Classes="cardhead" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding CardAddress}" FontSize="11" Classes="muted"
                         TextTrimming="CharacterEllipsis" IsVisible="{Binding HasAddress}" />
            </StackPanel>
            <!-- Подключение: со своей конфигурации туннель снимает, с чужой переносит его сюда. Круг повторяет
                 кнопку в шапке: цвет состояния и дуга на переключении. -->
            <Button x:Name="ConnectPart" Grid.Column="1" Classes="cardpower" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding CardActionText}"
                    Command="{Binding $parent[controls:CatalogCard].ConnectCommand}" CommandParameter="{Binding}">
              <Panel Width="42" Height="42">
                <Ellipse Classes="connspin" Classes.spinning="{Binding CardBusy}"
                         Width="40" Height="40" Stroke="{Binding CardPowerForeground}"
                         StrokeThickness="2.5" StrokeDashArray="12,29" StrokeLineCap="Round"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border Classes="powerglow" Classes.on="{Binding CardPowerOn}"
                        Width="36" Height="36" CornerRadius="18"
                        Background="{Binding CardPowerBrush}"
                        BorderBrush="{Binding CardPowerBorderBrush}" BorderThickness="1.5"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <PathIcon Data="{DynamicResource AgPowerGeometry}" Width="17" Height="17"
                            Foreground="{Binding CardPowerForeground}"
                            IsVisible="{Binding !CardBusy}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Panel>
            </Button>
          </Grid>

          <!-- Отклик, скорость и потери, следом место режима: иконка и значение, «N/A» вместо пустого места.
               Отступы стоят на группах: скрытая скорость не оставляет прогала. Хвост за краем отсекается. -->
          <Grid Grid.Row="1" Classes="cardinfo" ColumnDefinitions="*,Auto" Margin="0,8,0,0"
                VerticalAlignment="Center">
            <StackPanel Grid.Column="0" Orientation="Horizontal" ClipToBounds="True" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,10,0">
                <PathIcon Data="{DynamicResource AgCardTimerGeometry}" Width="13" Height="13"
                          Foreground="{DynamicResource AgMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ProbeText}" Foreground="{Binding ProbeBrush}" FontSize="12.5"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           IsVisible="{Binding !Probing}" />
                <!-- Идёт замер: точки приподнимаются по очереди на месте отклика. -->
                <StackPanel Orientation="Horizontal" Spacing="3" Height="13" VerticalAlignment="Center"
                            IsVisible="{Binding Probing}">
                  <Ellipse Classes="dot d1" Classes.bounce="{Binding Probing}" Fill="{DynamicResource AgMutedBrush}"
                           VerticalAlignment="Center" />
                  <Ellipse Classes="dot d2" Classes.bounce="{Binding Probing}" Fill="{DynamicResource AgMutedBrush}"
                           VerticalAlignment="Center" />
                  <Ellipse Classes="dot d3" Classes.bounce="{Binding Probing}" Fill="{DynamicResource AgMutedBrush}"
                           VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,10,0"
                          IsVisible="{Binding ShowLinkSpeed}">
                <PathIcon Data="{DynamicResource AgCardTrafficGeometry}" Width="13" Height="13"
                          Foreground="{DynamicResource AgMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CardSpeedText}" FontSize="12.5" Classes="muted"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,10,0">
                <PathIcon Data="{DynamicResource AgCardLossGeometry}" Width="13" Height="13"
                          Foreground="{DynamicResource AgMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CardLossText}" FontSize="12.5"
                           Foreground="{Binding CardLossBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </StackPanel>
              <!-- Место режима: у машины с одним туннелем пусто и строки не занимает. -->
              <ContentControl VerticalAlignment="Center"
                              Content="{Binding $parent[controls:CatalogCard].Extras}"
                              IsVisible="{Binding $parent[controls:CatalogCard].Extras, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <!-- Конфигурация из подписки: перечитать её прямо с карточки, под кнопкой подключения. -->
            <!-- Ширина повторяет круг подключения, поэтому иконка встаёт ровно под ним. -->
            <Panel Grid.Column="1" Width="42" VerticalAlignment="Center">
              <Button x:Name="RefreshPart" Classes="cardtune" HorizontalAlignment="Center"
                      IsVisible="{Binding FromSubscription}"
                      ToolTip.Tip="{l:Tr Main_SubscriptionRefresh}"
                      Command="{Binding $parent[controls:CatalogCard].RefreshSubscriptionCommand}"
                      CommandParameter="{Binding}">
                <PathIcon Data="{DynamicResource AgRefreshGeometry}" Width="14" Height="14" />
              </Button>
            </Panel>
          </Grid>
        </Grid>

        <!-- Подвал карточки: метки настроек слева, настройки конфигурации справа. -->
        <Border Grid.Row="1" Classes="cardfoot">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <controls:CardTags x:Name="TagsPart" Grid.Column="0" Tags="{Binding Tags}" VerticalAlignment="Center" />
            <!-- Шестерёнка встаёт под кнопку подключения: поле повторяет её ширину. -->
            <Panel Grid.Column="1" Width="42">
              <Button x:Name="SettingsPart" Classes="methodpick cardgear" HorizontalAlignment="Center"
                      ToolTip.Tip="{l:Tr Main_CardSettingsLink}"
                      Command="{Binding $parent[controls:CatalogCard].OpenCommand}" CommandParameter="{Binding}">
                <PathIcon Data="{DynamicResource AgGearGeometry}" Width="15" Height="15" />
              </Button>
            </Panel>
          </Grid>
        </Border>
      </Grid>

      <!-- Светлая рамка у всякой карточки; поверх неё рамка выбранной в каталоге - акцентом, за состоянием
           подключения не следует. Рисуется поверх содержимого и компоновки не меняет. -->
      <Border BorderThickness="1" CornerRadius="12" IsHitTestVisible="False"
              BorderBrush="{DynamicResource AgBorder2Brush}" />
      <Border BorderThickness="1" CornerRadius="12" IsHitTestVisible="False"
              BorderBrush="{DynamicResource AgAccentBrush}" IsVisible="{Binding ShowCardFrame}" />
    </Panel>
  </Button>
</UserControl>
