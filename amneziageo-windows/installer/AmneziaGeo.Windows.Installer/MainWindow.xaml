<Window x:Class="AmneziaGeo.Windows.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AmneziaGeo.Windows.Installer"
        Title="AmneziaGeo" Height="510" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V" />
    <!-- #151: hides while keeping layout space, so the progress bar does not shift down. -->
    <l:BoolToVisibilityHiddenConverter x:Key="B2VH" />
    <!-- A tab of the terms page: the open one is a raised white face on the inset strip. -->
    <Style x:Key="SegmentTab" TargetType="{x:Type RadioButton}">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RadioButton}">
            <Border x:Name="Face" Background="Transparent" CornerRadius="6" Padding="8,5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- A thin scroll bar for the text of the terms. -->
    <Style x:Key="ThinScrollBar" TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="8" />
      <Setter Property="MinWidth" Value="8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                      <Border Background="{StaticResource Border2Brush}" CornerRadius="2.5" Width="5" HorizontalAlignment="Center" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Border Style="{StaticResource Card}" Padding="24,22">
      <DockPanel LastChildFill="True">

        <!-- Header -->
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="{Binding Heading}" FontSize="23" FontWeight="SemiBold" />
          <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedTextBlock}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Sub text / status line -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding SubText}"
                   Style="{StaticResource MutedTextBlock}"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,16,0,0" />

        <!-- Geo-list download outcome (final screen, install/update). -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding GeoResult}"
                   Style="{StaticResource MutedTextBlock}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="{Binding HasGeoResult, Converter={StaticResource B2V}}" />

        <!-- Progress (apply phase) -->
        <StackPanel DockPanel.Dock="Bottom"
                    Visibility="{Binding ShowProgress, Converter={StaticResource B2V}}">
          <!-- The step the engine is on, so a long one reads as work rather than a stalled bar. -->
          <TextBlock Text="{Binding StepText}"
                     Style="{StaticResource MutedTextBlock}"
                     FontSize="12"
                     TextTrimming="CharacterEllipsis"
                     Margin="0,0,0,8"
                     Visibility="{Binding HasStepText, Converter={StaticResource B2VH}}" />
          <!-- RangeBase.Value binds TwoWay by default; Progress is read-only, so pin OneWay or the binding throws. -->
          <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding IsIndeterminate}" />
          <TextBlock Text="{Binding Progress, StringFormat={}{0}%}"
                     Style="{StaticResource MutedTextBlock}"
                     HorizontalAlignment="Right" Margin="0,8,0,0"
                     Visibility="{Binding ShowPercent, Converter={StaticResource B2VH}}" />
        </StackPanel>

        <!-- Done. The launch-after choice now lives on the options step (#165); when it is on, a
             successful install/update auto-closes here and starts the app, so this screen is only
             reached when launch is off or the run failed - just a Close button. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Visibility="{Binding ShowDone, Converter={StaticResource B2V}}">
          <Button Content="{l:Tr InstallerUi_Close}" Style="{StaticResource AccentButton}" Command="{Binding CloseCommand}" />
        </StackPanel>

        <!-- Ready, step 1 (#114): pick a maintenance action. Its options move to a dedicated step below. -->
        <StackPanel DockPanel.Dock="Bottom"
                    Visibility="{Binding ShowActionButtons, Converter={StaticResource B2V}}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{l:Tr InstallerUi_Remove}" Style="{StaticResource DangerButton}"
                    Command="{Binding RemoveCommand}" Margin="0,0,10,0"
                    Visibility="{Binding ShowRemove, Converter={StaticResource B2V}}" />
            <Button Content="{l:Tr InstallerUi_Repair}"
                    Command="{Binding RepairCommand}" Margin="0,0,10,0"
                    Visibility="{Binding ShowRepair, Converter={StaticResource B2V}}" />
            <Button Content="{l:Tr InstallerUi_Update}" Style="{StaticResource AccentButton}"
                    Command="{Binding UpdateCommand}" Margin="0,0,10,0"
                    Visibility="{Binding ShowUpdate, Converter={StaticResource B2V}}" />
            <Button Content="{Binding InstallButtonText}" Style="{StaticResource AccentButton}"
                    Command="{Binding InstallCommand}"
                    Visibility="{Binding ShowInstall, Converter={StaticResource B2V}}" />
          </StackPanel>
        </StackPanel>

        <!-- Ready, step 2 (#114): configure the chosen action, then Continue / Back. Which options appear is
             per-action (install/update/repair: geo + reset; remove: only delete config). Configurations are
             imported in the app itself, never here (#150). -->
        <StackPanel DockPanel.Dock="Bottom"
                    Visibility="{Binding ShowOptionsStep, Converter={StaticResource B2V}}">
          <TextBlock Text="{Binding OptionsHeading}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />
          <CheckBox Content="{l:Tr InstallerUi_DownloadGeoDbUpdates}"
                    IsChecked="{Binding DownloadLists}"
                    Margin="0,0,0,12"
                    Visibility="{Binding ShowDownloadOption, Converter={StaticResource B2V}}" />
          <!-- #165: launch-after choice up front (install/update only). When on, a successful run
               closes the installer and starts the app instead of showing the Done screen. -->
          <CheckBox Content="{l:Tr InstallerUi_LaunchAfterInstall}"
                    IsChecked="{Binding LaunchOnClose}"
                    Margin="0,0,0,12"
                    Visibility="{Binding ShowLaunchOnInstall, Converter={StaticResource B2V}}" />
          <!-- #188: nested under launch-after - dial the existing connection straight after the launch. Shown
               only when the agent reports a connectable profile; disabled unless launch-after is on. -->
          <CheckBox Content="{l:Tr InstallerUi_AutoConnect}"
                    IsChecked="{Binding AutoConnect}"
                    IsEnabled="{Binding LaunchOnClose}"
                    Margin="22,-4,0,12"
                    Visibility="{Binding ShowAutoConnectOption, Converter={StaticResource B2V}}" />
          <!-- #183: optional desktop / Start-menu shortcuts (install/update/repair, not removal). -->
          <CheckBox Content="{l:Tr InstallerUi_DesktopShortcut}"
                    IsChecked="{Binding DesktopShortcut}"
                    Margin="0,0,0,12"
                    Visibility="{Binding ShowShortcutOptions, Converter={StaticResource B2V}}" />
          <CheckBox Content="{l:Tr InstallerUi_StartMenuShortcut}"
                    IsChecked="{Binding StartMenuShortcut}"
                    Margin="0,0,0,12"
                    Visibility="{Binding ShowShortcutOptions, Converter={StaticResource B2V}}" />
          <!-- #105/#114: wipe the runtime configuration (ProgramData\AmneziaGeo). The label is contextual -
               «Сбросить настройки» on install/update/repair, «Удалить конфигурацию и кэш» on removal. Off by
               default so a plain (re)install keeps the user's profiles and settings. -->
          <CheckBox Content="{Binding DeleteConfigLabel}"
                    IsChecked="{Binding DeleteConfig}"
                    Margin="0,0,0,12"
                    Visibility="{Binding ShowDeleteConfigOption, Converter={StaticResource B2V}}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{l:Tr InstallerUi_Back}" Command="{Binding BackCommand}" Margin="0,0,10,0"
                    Visibility="{Binding ShowBack, Converter={StaticResource B2V}}" />
            <Button Content="{l:Tr InstallerUi_Continue}" Style="{StaticResource AccentButton}"
                    Command="{Binding ConfirmCommand}" />
          </StackPanel>
        </StackPanel>

        <!-- Terms of a new installation, before its options; the last child, so it takes the rest of the card. -->
        <Grid Margin="0,14,0,0" Visibility="{Binding ShowTermsStep, Converter={StaticResource B2V}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{StaticResource InsetBrush}" CornerRadius="8" Padding="3">
            <UniformGrid Columns="2">
              <RadioButton Style="{StaticResource SegmentTab}" Content="{l:Tr About_Terms}" IsChecked="{Binding ShowTerms}" />
              <RadioButton Style="{StaticResource SegmentTab}" Content="{l:Tr About_Privacy}" IsChecked="{Binding ShowPrivacy}" />
            </UniformGrid>
          </Border>
          <Border Grid.Row="1" Margin="0,10,0,0" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="8">
            <ScrollViewer x:Name="TermsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,4,6,4">
              <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ThinScrollBar}" />
              </ScrollViewer.Resources>
              <ItemsControl ItemsSource="{Binding LegalBlocks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid x:Name="Block" Margin="0,0,0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="Mark" Text="•" FontSize="12.5" Margin="2,0,8,0" Visibility="Collapsed" />
                      <TextBlock x:Name="Words" Grid.Column="1" Text="{Binding Text}" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" />
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsHeading}" Value="True">
                        <Setter TargetName="Words" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="Words" Property="FontSize" Value="13" />
                        <Setter TargetName="Block" Property="Margin" Value="0,8,0,4" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsBullet}" Value="True">
                        <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Block" Property="Margin" Value="0,0,0,3" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="{l:Tr Terms_Accept}" Style="{StaticResource AccentButton}"
                    Command="{Binding AcceptTermsCommand}" Margin="10,0,0,0" />
            <Button DockPanel.Dock="Right" Content="{l:Tr Terms_Quit}" Command="{Binding CloseCommand}" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding LegalFooter}" Style="{StaticResource MutedTextBlock}" FontSize="11"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</Window>
