<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
        xmlns:svc="clr-namespace:AmneziaGeo.Ui.Services"
        xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
        xmlns:views="clr-namespace:AmneziaGeo.Ui.Views"
        xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
        x:Class="AmneziaGeo.Ui.MainView"
        x:CompileBindings="True"
        x:DataType="vm:MainWindowViewModel"
        Design.DataContext="{x:Static vm:DesignData.MainWindow}"
        Design.Width="987" Design.Height="610"
        Background="{DynamicResource AgBgBrush}"
        FontFamily="IBM Plex Sans, Segoe UI, sans-serif"
        Foreground="{DynamicResource AgFgBrush}"
        XYFocus.NavigationModes="Enabled">

  <UserControl.Resources>
    <!-- Refresh glyph. -->
    <StreamGeometry x:Key="AgRefreshGeometry">M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z</StreamGeometry>
    <!-- Gear glyph. -->
    <StreamGeometry x:Key="AgGearGeometry">M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z</StreamGeometry>
    <!-- Back glyph. -->
    <StreamGeometry x:Key="AgBackGeometry">M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20z</StreamGeometry>
    <!-- Plus glyph. -->
    <StreamGeometry x:Key="AgPlusGeometry">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
    <!-- Trash glyph, drawn as an outline. -->
    <StreamGeometry x:Key="AgTrashGeometry">M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M10 11v6 M14 11v6</StreamGeometry>
    <!-- Close glyph. -->
    <StreamGeometry x:Key="AgCloseGeometry">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
    <!-- Chevron glyph. -->
    <StreamGeometry x:Key="AgChevronGeometry">M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z</StreamGeometry>
  </UserControl.Resources>

  <Grid>

    <!-- HOME screen: gear left, centered title, the connect control and the servers. A pair of tabs shows one
         of the two at a time, at every width. -->
    <Border Classes="card" Margin="12" Padding="0" IsVisible="{Binding IsHome}">
      <DockPanel LastChildFill="True">

        <!-- Top row, one per pane: the connect pane carries the gear and the app name, the server pane carries
             the way back and its own actions. -->
        <Border DockPanel.Dock="Top" Height="48" Padding="12,0">
          <Panel>
            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsHomeMain}">
              <Button Grid.Column="0" Classes="icon" Padding="6,4" VerticalAlignment="Center"
                      Command="{Binding NavSettingsCommand}" ToolTip.Tip="{l:Tr Main_SettingsTooltip}">
                <PathIcon Data="{DynamicResource AgGearGeometry}" Width="18" Height="18"
                          Foreground="{DynamicResource AgMutedBrush}" />
              </Button>
              <TextBlock Grid.Column="1" Text="AmneziaGeo" FontSize="15" FontWeight="SemiBold" Margin="8,0"
                         VerticalAlignment="Center" HorizontalAlignment="Center"
                         Foreground="{DynamicResource AgMutedBrush}" />
              <Button Grid.Column="2" Classes="icon" Padding="6,4" VerticalAlignment="Center"
                      IsVisible="{Binding CanExit}"
                      Command="{Binding ExitCommand}" ToolTip.Tip="{l:Tr Main_ExitTooltip}">
                <!-- Smaller than the gear: the cross reaches its corners, the gear stays inscribed. -->
                <PathIcon Data="{DynamicResource AgCloseGeometry}" Width="15" Height="15"
                          Foreground="{DynamicResource AgMutedBrush}" />
              </Button>
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto" IsVisible="{Binding IsHomeServers}">
              <Button x:Name="HomeServersBack" Grid.Column="0" Classes="icon" Padding="6,4" VerticalAlignment="Center"
                      Command="{Binding SelectHomeTabCommand}" CommandParameter="main"
                      ToolTip.Tip="{l:Tr Main_BackTooltip}">
                <PathIcon Data="{DynamicResource AgBackGeometry}" Width="18" Height="18"
                          Foreground="{DynamicResource AgMutedBrush}" />
              </Button>
              <TextBlock Grid.Column="1" Text="{l:Tr Main_HomeTabServers}" FontSize="15" FontWeight="SemiBold"
                         Margin="8,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                         Foreground="{DynamicResource AgMutedBrush}" />
              <Button Grid.Column="2" Classes="icon" Padding="6,4" VerticalAlignment="Center"
                      IsVisible="{Binding HasConfigs}"
                      Command="{Binding Home.ProbeAllCommand}" IsEnabled="{Binding !Home.ProbeRunning}"
                      ToolTip.Tip="{l:Tr Main_ProbeTooltip}">
                <PathIcon Data="{DynamicResource AgRefreshGeometry}" Width="18" Height="18"
                          Foreground="{DynamicResource AgMutedBrush}" />
              </Button>
              <Button Grid.Column="3" Classes="icon" Padding="6,4" VerticalAlignment="Center"
                      Command="{Binding AddServerCommand}" ToolTip.Tip="{l:Tr Main_AddConfigButton}">
                <PathIcon Data="{DynamicResource AgPlusGeometry}" Width="18" Height="18"
                          Foreground="{DynamicResource AgMutedBrush}" />
              </Button>
            </Grid>
          </Panel>
        </Border>

        <Panel>
          <!-- Body: the connect control on one screen, the servers on the other. A loader stands in until the
               first agent snapshot, so the indeterminate power button never flashes on open. -->
          <Grid Margin="12,4,12,12" IsVisible="{Binding Home.IsReady}">

              <!-- Connect pane: the round control, the status and the config picker. -->
              <StackPanel Width="290" Spacing="14"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsVisible="{Binding ShowHomeConnect}">
                <Button x:Name="HomePowerButton" Classes="powerbig" HorizontalAlignment="Center"
                        FocusAdorner="{x:Null}"
                        Command="{Binding Home.ToggleConnectionCommand}"
                        IsEnabled="{Binding Home.CanToggleConnection}"
                        ToolTip.Tip="{Binding Home.ConnectHint}">
                  <Grid Width="168" Height="168">
                    <Ellipse Width="168" Height="168" Stroke="{DynamicResource AgBorderBrush}"
                             StrokeThickness="1" Opacity="0.7" />
                    <Ellipse Width="140" Height="140" Stroke="{DynamicResource AgBorderBrush}"
                             StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Width="112" Height="112" Stroke="{DynamicResource AgBorder2Brush}"
                             StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <!-- Accent ring-wave overlays during connect / disconnect. -->
                    <Ellipse Classes="ring r1" Classes.waveout="{Binding Home.IsConnectingOut}"
                             Classes.wavein="{Binding Home.IsConnectingIn}"
                             Width="112" Height="112" Stroke="{Binding Home.ConnectCircleForeground}" StrokeThickness="2"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Classes="ring r2" Classes.waveout="{Binding Home.IsConnectingOut}"
                             Classes.wavein="{Binding Home.IsConnectingIn}"
                             Width="140" Height="140" Stroke="{Binding Home.ConnectCircleForeground}" StrokeThickness="2"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Classes="ring r3" Classes.waveout="{Binding Home.IsConnectingOut}"
                             Classes.wavein="{Binding Home.IsConnectingIn}"
                             Width="168" Height="168" Stroke="{Binding Home.ConnectCircleForeground}" StrokeThickness="2"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border Width="94" Height="94" CornerRadius="47"
                            Background="{Binding Home.ConnectCircleBrush}"
                            BorderBrush="{Binding Home.ConnectCircleBorderBrush}" BorderThickness="2"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            BoxShadow="0 6 18 0 #1F000000">
                      <Panel>
                        <PathIcon Data="{DynamicResource AgPowerGeometry}" Width="38" Height="38"
                                  Foreground="{Binding Home.ConnectCircleForeground}"
                                  IsVisible="{Binding !Home.IsConnecting}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Classes.pulse="{Binding Home.IsConnecting}" Width="32" Height="32"
                                 IsVisible="{Binding Home.IsConnecting}" Fill="{Binding Home.ConnectCircleForeground}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Panel>
                    </Border>
                    <!-- Focus ring in the current status colour. -->
                    <Ellipse Classes="focusring" Width="168" Height="168" StrokeThickness="3"
                             Stroke="{Binding Home.ConnectStatusBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <!-- Status and hint wrap inside the column, so a long hint neither clips nor widens it. -->
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                  <TextBlock Text="{Binding Home.AgentStatusText}" FontSize="17" FontWeight="SemiBold"
                             TextAlignment="Center" TextWrapping="Wrap" Foreground="{Binding Home.ConnectStatusBrush}" />
                  <TextBlock Text="{Binding Home.ConnectHint}" FontSize="12.5"
                             TextAlignment="Center" TextWrapping="Wrap" Foreground="{Binding Home.ConnectHintBrush}" />
                  <!-- Retry counter while a stalled connect keeps trying (#197). -->
                  <TextBlock Text="{Binding Home.RetryText}" FontSize="12" FontWeight="SemiBold"
                             TextAlignment="Center" TextWrapping="Wrap" Foreground="{Binding Home.ConnectStatusBrush}"
                             IsVisible="{Binding Home.ShowRetry}" />
                  <!-- What the live tunnel carries, what it loses on the way, and the warning that it keeps
                       re-establishing the session instead of carrying anything. -->
                  <TextBlock Text="{Binding Home.LinkSpeedText}" FontSize="12"
                             TextAlignment="Center" Foreground="{Binding Home.ConnectHintBrush}"
                             IsVisible="{Binding Home.ShowLink}" />
                  <TextBlock Text="{Binding Home.LinkLossText}" FontSize="12"
                             TextAlignment="Center" Foreground="{Binding Home.LinkLossBrush}"
                             IsVisible="{Binding Home.ShowLinkLoss}" />
                  <TextBlock Text="{Binding Home.LinkChurnText}" FontSize="12" FontWeight="SemiBold"
                             TextAlignment="Center" TextWrapping="Wrap" Foreground="{Binding Home.LinkChurnBrush}"
                             IsVisible="{Binding Home.LinkChurning}" />
                  <!-- The resolver the machine sends its lookups to stopped answering, so rules by domain no
                       longer apply. -->
                  <TextBlock Text="{Binding Home.NamesUnroutedText}" FontSize="12" FontWeight="SemiBold"
                             TextAlignment="Center" TextWrapping="Wrap" Foreground="{Binding Home.NamesUnroutedBrush}"
                             IsVisible="{Binding Home.ShowNamesUnrouted}" />
                </StackPanel>

                <!-- Always-on switch: the switch itself belongs to the system, so while it is on the power button
                     leads to the system screen instead of dialling. -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Home.ShowAlwaysOnToggle}">
                  <TextBlock Grid.Column="0" Text="{l:Tr Main_AlwaysOnMode}" Classes="muted"
                             FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                IsChecked="{Binding Home.AlwaysOnMode, Mode=TwoWay}" />
                </Grid>

                <!-- Config picker: the same pick the server screen carries, with the way to that screen over it. -->
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasConfigs}">
                    <TextBlock Grid.Column="0" Text="{l:Tr Main_HomeServerLabel}" Classes="muted"
                               FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="linkbtn" Padding="4,0" FontSize="12"
                            Command="{Binding SelectHomeTabCommand}" CommandParameter="servers"
                            Content="{l:Tr Main_HomeManageServers}" />
                  </Grid>
                  <controls:AdaptiveComboBox Classes="field" HorizontalAlignment="Stretch"
                            IsVisible="{Binding HasConfigs}"
                            ItemsSource="{Binding Config.HomeConfigOptions}"
                            SelectedItem="{Binding Home.ActiveConfigChoice, Mode=TwoWay}">
                    <controls:AdaptiveComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ConfigChoice">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </controls:AdaptiveComboBox.ItemTemplate>
                  </controls:AdaptiveComboBox>
                  <!-- No configs: add-config button (opens the config settings section) and its hint. -->
                  <Button Classes="accent" HorizontalAlignment="Center" Padding="20,7"
                          IsVisible="{Binding !HasConfigs}" Command="{Binding AddConfigCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="+" />
                      <TextBlock Text="{l:Tr Main_AddConfigButton}" />
                    </StackPanel>
                  </Button>
                  <TextBlock IsVisible="{Binding !HasConfigs}" Classes="muted" FontSize="12"
                             HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                             Text="{l:Tr Main_NoConfigsHint}" />
                </StackPanel>
              </StackPanel>

              <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding ShowHomeServers}">
                <!-- Over the table: the list every config routes by, picked here and applied at once, then how
                     many servers stand under it. -->
                <StackPanel Grid.Row="0" Spacing="6" Margin="2,0,0,10" IsVisible="{Binding HasConfigs}">
                  <TextBlock Text="{l:Tr Main_RoutingSection}" Classes="muted"
                             FontSize="11.5" FontWeight="SemiBold" />
                  <controls:AdaptiveComboBox Classes="field"
                            MinWidth="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=minW220}"
                            HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}"
                            ItemsSource="{Binding Routing.HomeRoutingOptions}"
                            SelectedItem="{Binding Routing.HomeRoutingChoice, Mode=TwoWay}">
                    <controls:AdaptiveComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:RoutingListChoice">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </controls:AdaptiveComboBox.ItemTemplate>
                  </controls:AdaptiveComboBox>
                  <TextBlock Text="{Binding ServersCountText}" Classes="muted" FontSize="11.5" Margin="0,4,0,0" />
                </StackPanel>

                <Panel Grid.Row="1">
                  <!-- Narrow: the cards stand in one column, each stretched to the width. -->
                  <ScrollViewer IsVisible="{Binding ShowServerStack}"
                                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Config.Configs}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConfigItemViewModel">
                          <controls:ServerCard Margin="0,0,0,8" Compact="True"
                                  IsOpen="{Binding SwipeOpen, Mode=TwoWay}"
                                  SelectCommand="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Home.SelectRowCommand}"
                                  ConnectCommand="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Home.ConnectConfigCommand}"
                                  EditCommand="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).EditServerCommand}"
                                  DeleteCommand="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).DeleteServerCommand}"
                                  DropCommand="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Config.ApplyOrderCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                  <!-- Wide: the same cards tiled across the pane. A remote walks them with the arrows, steps
                       into one with the centre key to reach its buttons, and steps back out with the back key.
                       A drag carries a card to another place. -->
                  <ScrollViewer IsVisible="{Binding ShowServerGrid}"
                                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Config.Configs}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConfigItemViewModel">
                          <controls:ServerCard Width="252" Margin="0,0,10,10"
                                  IsOpen="{Binding SwipeOpen, Mode=TwoWay}"
                                  SelectCommand="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Home.SelectRowCommand}"
                                  ConnectCommand="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Home.ConnectConfigCommand}"
                                  EditCommand="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).EditServerCommand}"
                                  DeleteCommand="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).DeleteServerCommand}"
                                  AskDeleteCommand="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).AskDeleteServerCommand}"
                                  DropCommand="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Config.ApplyOrderCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                  <!-- No configs: the add-config button (opens the config settings section) and its hint. -->
                  <StackPanel VerticalAlignment="Center" Spacing="8" IsVisible="{Binding !HasConfigs}">
                    <Button Classes="accent" HorizontalAlignment="Center" Padding="20,7"
                            Command="{Binding AddConfigCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="+" />
                        <TextBlock Text="{l:Tr Main_AddConfigButton}" />
                      </StackPanel>
                    </Button>
                    <TextBlock Classes="muted" FontSize="12"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"
                               Text="{l:Tr Main_NoConfigsHint}" />
                  </StackPanel>
                </Panel>

                <!-- Configs exist but none picked: hint to pick one. -->
                <TextBlock Grid.Row="2" IsVisible="{Binding Home.ShowSelectConfigHint}" Classes="muted" FontSize="12"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="{l:Tr Main_HomeSelectConfigHint}" />
              </Grid>
          </Grid>

          <!-- Loader until the first snapshot. -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"
                      IsVisible="{Binding !Home.IsReady}">
            <ProgressBar IsIndeterminate="True" Width="150" HorizontalAlignment="Center" />
            <TextBlock Text="{l:Tr Main_RoutingLoading}" Classes="muted" FontSize="13"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Panel>

      </DockPanel>
    </Border>

    <!-- SETTINGS screen: back to home (left), title centered, connect control (right), over the section rail
         and content pane. -->
      <Border Classes="card" Height="48" Margin="12,12,12,0" Padding="12,0"
              VerticalAlignment="Top" IsVisible="{Binding IsSettings}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <!-- Back: compact section detail steps back to the rail, otherwise home. Every screen autosaves, so
               navigation is never locked; deletion is confirmed inline. -->
          <Button Grid.Column="0" Classes="backbtn" VerticalAlignment="Center"
                  Click="OnBackClick"
                  ToolTip.Tip="{l:Tr Main_BackTooltip}">
            <PathIcon Data="{DynamicResource AgBackGeometry}" Width="18" Height="18"
                      Foreground="{DynamicResource AgMutedBrush}" />
          </Button>

          <!-- Title centered between the back arrow and the connect control: the app name, or the current section
               name when a compact section detail is open. -->
          <Panel Grid.Column="1" Margin="8,0">
            <TextBlock Text="AmneziaGeo" FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource AgMutedBrush}"
                       IsVisible="{Binding !IsSectionDetail}" />
            <Panel IsVisible="{Binding IsSectionDetail}">
              <TextBlock Text="{l:Tr Main_ConfigSection}" IsVisible="{Binding IsSettingsConfig}"
                         FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AgMutedBrush}" />
              <TextBlock Text="{l:Tr Main_RoutingSection}" IsVisible="{Binding IsSettingsRouting}"
                         FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AgMutedBrush}" />
              <TextBlock Text="{l:Tr Main_SourcesSection}" IsVisible="{Binding IsSettingsSources}"
                         FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AgMutedBrush}" />
              <TextBlock Text="{l:Tr Main_DiagnosticsSection}" IsVisible="{Binding IsSettingsLogs}"
                         FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AgMutedBrush}" />
              <TextBlock Text="{l:Tr General_Section}" IsVisible="{Binding IsSettingsGeneral}"
                         FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AgMutedBrush}" />
            </Panel>
          </Panel>

          <!-- Connect control (right), the same pill the compact home header carries. -->
          <controls:ConnectPill Grid.Column="2" DataContext="{Binding Home}" />
        </Grid>
      </Border>

    <Grid x:Name="SettingsBody" IsVisible="{Binding IsSettings}" Margin="12,4,12,12" RowDefinitions="48,*">
      <Grid.ColumnDefinitions>
        <!-- Section rail column, drag-resizable via the GridSplitter.
             MaxWidth capped so that even at the rail's widest the content pane keeps its MinWidth at the
             window's MinWidth: railMax(320) + splitter(5) + contentMin(440) + hMargins(24) = 789 <= Window.MinWidth(800).
             With the old 360 cap a wide rail + small window pushed the content below its min (hscroll is
             Disabled), so its widest fixed control (the 320px segmented toggle) spilled left/down out of the pane. -->
        <ColumnDefinition Width="260" MinWidth="210" MaxWidth="320" />
        <ColumnDefinition Width="Auto" />
        <!-- Content floored: the splitter can never starve it below its min, so the
             disabled-hscroll pane fits/wraps instead of clipping right-side controls. -->
        <ColumnDefinition Width="*" MinWidth="440" />
      </Grid.ColumnDefinitions>

      <!-- Section rail. -->
      <Border x:Name="RailPane" Grid.Column="0" Grid.Row="1" Classes="card" Margin="0,12,0,0" Padding="0"
              IsVisible="{Binding ShowRail}">
        <ScrollViewer>
          <StackPanel x:Name="RailMenu" Classes="railmenu" Classes.compact="{Binding IsCompact}" Margin="12,12"
                      KeyboardNavigation.TabNavigation="Cycle" KeyDown="OnRailKeyDown">
              <Button x:Name="RailConfig" Classes="rowselect" Classes.active="{Binding IsSettingsConfig}" Margin="0,3"
                      XYFocus.Up="{Binding ElementName=RailGeneral}"
                      Command="{Binding SelectSettingsCommand}" CommandParameter="config">
                <Grid ColumnDefinitions="Auto,*" Margin="12,7">
                  <Grid Grid.Column="0" Classes="railradio" Width="18" Height="18" VerticalAlignment="Center">
                    <Ellipse Width="16" Height="16" StrokeThickness="2"
                             Stroke="{DynamicResource AgBorder2Brush}" Fill="Transparent"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AgAccentBrush}"
                             IsVisible="{Binding IsSettingsConfig}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                  <StackPanel Grid.Column="1" Classes="railtext" VerticalAlignment="Center">
                    <TextBlock Text="{l:Tr Main_RailConfigTitle}" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock Text="{l:Tr Main_RailConfigSubtitle}" FontSize="11.5" Classes="muted"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Button>

              <Button Classes="rowselect" Classes.active="{Binding IsSettingsRouting}" Margin="0,3"
                      Command="{Binding SelectSettingsCommand}" CommandParameter="routing">
                <Grid ColumnDefinitions="Auto,*" Margin="12,7">
                  <Grid Grid.Column="0" Classes="railradio" Width="18" Height="18" VerticalAlignment="Center">
                    <Ellipse Width="16" Height="16" StrokeThickness="2"
                             Stroke="{DynamicResource AgBorder2Brush}" Fill="Transparent"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AgAccentBrush}"
                             IsVisible="{Binding IsSettingsRouting}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                  <StackPanel Grid.Column="1" Classes="railtext" VerticalAlignment="Center">
                    <TextBlock Text="{l:Tr Main_RailRoutingTitle}" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock Text="{l:Tr Main_RailRoutingSubtitle}" FontSize="11.5" Classes="muted"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Button>

              <Button Classes="rowselect" Classes.active="{Binding IsSettingsSources}" Margin="0,3"
                      Command="{Binding SelectSettingsCommand}" CommandParameter="sources">
                <Grid ColumnDefinitions="Auto,*" Margin="12,7">
                  <Grid Grid.Column="0" Classes="railradio" Width="18" Height="18" VerticalAlignment="Center">
                    <Ellipse Width="16" Height="16" StrokeThickness="2"
                             Stroke="{DynamicResource AgBorder2Brush}" Fill="Transparent"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AgAccentBrush}"
                             IsVisible="{Binding IsSettingsSources}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                  <StackPanel Grid.Column="1" Classes="railtext" VerticalAlignment="Center">
                    <TextBlock Text="{l:Tr Main_RailSourcesTitle}" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock Text="{l:Tr Main_RailSourcesSubtitle}" FontSize="11.5" Classes="muted"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Button>

              <Button Classes="rowselect" Classes.active="{Binding IsSettingsLogs}" Margin="0,3"
                      Command="{Binding SelectSettingsCommand}" CommandParameter="logs">
                <Grid ColumnDefinitions="Auto,*" Margin="12,7">
                  <Grid Grid.Column="0" Classes="railradio" Width="18" Height="18" VerticalAlignment="Center">
                    <Ellipse Width="16" Height="16" StrokeThickness="2"
                             Stroke="{DynamicResource AgBorder2Brush}" Fill="Transparent"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AgAccentBrush}"
                             IsVisible="{Binding IsSettingsLogs}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                  <StackPanel Grid.Column="1" Classes="railtext" VerticalAlignment="Center">
                    <TextBlock Text="{l:Tr Main_RailLogsTitle}" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock Text="{l:Tr Main_RailLogsSubtitle}" FontSize="11.5" Classes="muted"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Button>

              <Button x:Name="RailGeneral" Classes="rowselect" Classes.active="{Binding IsSettingsGeneral}" Margin="0,3"
                      XYFocus.Down="{Binding ElementName=RailConfig}"
                      Command="{Binding SelectSettingsCommand}" CommandParameter="general">
                <Grid ColumnDefinitions="Auto,*" Margin="12,7">
                  <Grid Grid.Column="0" Classes="railradio" Width="18" Height="18" VerticalAlignment="Center">
                    <Ellipse Width="16" Height="16" StrokeThickness="2"
                             Stroke="{DynamicResource AgBorder2Brush}" Fill="Transparent"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AgAccentBrush}"
                             IsVisible="{Binding IsSettingsGeneral}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                  <StackPanel Grid.Column="1" Classes="railtext" VerticalAlignment="Center">
                    <TextBlock Text="{l:Tr Main_RailGeneralTitle}" FontWeight="SemiBold" FontSize="13.5" />
                    <TextBlock Text="{l:Tr Main_RailGeneralSubtitle}" FontSize="11.5" Classes="muted"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Button>
            </StackPanel>
          </ScrollViewer>
      </Border>

      <!-- Draggable divider between rail and content (wide mode only). Unfocusable: a pointer affordance that
           otherwise swallows the rail's right press and strands D-pad focus on a 5px strip. -->
      <GridSplitter Grid.Column="1" Grid.Row="1" Width="5" IsVisible="{Binding ShowSplitter}"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Focusable="False" IsTabStop="False"
                    Background="Transparent" Margin="0,12,0,0" />

      <!-- Content pane. -->
      <Border x:Name="ContentPane" Grid.Column="2" Grid.Row="1" Classes="card" Margin="0,12,0,0" Padding="0"
              IsVisible="{Binding ShowContent}" KeyDown="OnContentKeyDown"
              controls:FileDropBehavior.Command="{Binding ImportDroppedFilesCommand}">
        <!-- Rows rather than a DockPanel: tab order follows the declaration, so the footer comes after
             the content and a remote reaches Save by tabbing on from the last field. -->
        <Grid RowDefinitions="*,Auto">
        <!-- ALL insets live on the inner Grid's Margin, none on the ScrollViewer. A ScrollViewer Padding is
             applied asymmetrically between the measure and arrange passes, so the padded side is pushed past
             the presenter's clip: horizontally it shoved stretched fields off the edge; vertically the
             bottom 16px of a scrolled-to-max section (e.g. the config «Удалить» button) landed below the
             viewport's clip and was unreachable even at max scroll. A Grid Margin is applied identically in
             both passes, so the top+bottom inset survives and the last control always scrolls fully into view. -->
        <!-- Never scroll sideways: long values (source URLs) trim/wrap instead of overflowing the card. -->
        <ScrollViewer Grid.Row="0" x:Name="ContentScroll" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="18,16">

            <!-- Each section is built when it is first opened, not when the shell loads: six section trees cost
                 seconds on a TV and a session opens one or two. A hidden control is never measured, so the
                 template stays unrealized until the section is shown; the built view is kept afterwards, so
                 switching back is free. The viewport-derived sizes stay outside the templates: an element-name
                 binding does not cross a template's name scope. -->

            <!-- CONFIG SECTION: cap height to the viewport minus the Grid's 32px inset. -->
            <ContentControl IsVisible="{Binding IsSettingsConfig}" Content="{Binding Config}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            MinHeight="{Binding #ContentScroll.Viewport.Height, Converter={x:Static svc:SubtractConverter.Instance}, ConverterParameter=32}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:ConfigViewModel">
                  <views:ConfigView />
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- ROUTING SECTION -->
            <ContentControl IsVisible="{Binding IsSettingsRouting}" Content="{Binding Routing}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:RoutingViewModel">
                  <views:RoutingView />
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- SOURCES SECTION -->
            <ContentControl IsVisible="{Binding IsSettingsSources}" Content="{Binding Sources}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:SourcesViewModel">
                  <views:SourcesView />
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- DIAGNOSTICS SECTION: fixed to the viewport (minus the Grid's 32px inset) so only the pane body scrolls. -->
            <ContentControl IsVisible="{Binding IsSettingsLogs}" Content="{Binding Diagnostics}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Height="{Binding #ContentScroll.Viewport.Height, Converter={x:Static svc:SubtractConverter.Instance}, ConverterParameter=32}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:DiagnosticsViewModel">
                  <views:DiagnosticsView />
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- GENERAL SECTION -->
            <ContentControl IsVisible="{Binding IsSettingsGeneral}" Content="{Binding General}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:GeneralViewModel">
                  <views:GeneralView />
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>

          </Grid>
        </ScrollViewer>
          <StackPanel Grid.Row="1">
            <!-- Static footer for config: import-draft or open-config edits. Save / Cancel + unsaved indicator. -->
            <Border IsVisible="{Binding Config.ShowSaveBar}"
                    Background="{DynamicResource AgPanelBrush}" BorderBrush="{DynamicResource AgBorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,13,13" MinHeight="52" Padding="18,7">
              <!-- Compact drops the Save / Cancel pair under the unsaved-changes label so they never overlap it. -->
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            Grid.ColumnSpan="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=span2}">
                  <Ellipse Width="8" Height="8" Fill="{DynamicResource AgWarnBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{l:Tr Main_UnsavedChanges}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Grid.Row="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=row}"
                            Grid.Column="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=col}">
                  <Button Classes="methodpick" Content="{l:Tr Main_CancelButton}"
                          Width="120"
                          Command="{Binding Config.CancelSectionCommand}" />
                  <Button Classes="accent" Content="{l:Tr Main_SaveButton}"
                          Width="120" Padding="6"
                          Command="{Binding Config.SaveSectionCommand}"
                          IsVisible="{Binding Config.ShowSaveButton}"
                          IsEnabled="{Binding Config.CanSave}" />
                </StackPanel>
              </Grid>
            </Border>
            <!-- Static footer for routing: import-draft or open-list edits. Save / Cancel + unsaved indicator. -->
            <Border IsVisible="{Binding Routing.ShowSaveBar}"
                    Background="{DynamicResource AgPanelBrush}" BorderBrush="{DynamicResource AgBorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,13,13" MinHeight="52" Padding="18,7">
              <StackPanel Spacing="8">
                <!-- Says why Save is off before the button is reached. -->
                <TextBlock Text="{Binding Routing.RouteBudgetWarning}"
                           IsVisible="{Binding Routing.ShowRouteBudgetWarning}"
                           Foreground="{DynamicResource AgWarnBrush}" FontSize="12" TextWrapping="Wrap" />
                <!-- Compact drops the Save / Cancel pair under the unsaved-changes label so they never overlap it. -->
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                  <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                              Grid.ColumnSpan="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=span2}">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AgWarnBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{l:Tr Main_UnsavedChanges}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right"
                              Grid.Row="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=row}"
                              Grid.Column="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=col}">
                    <Button Classes="methodpick" Content="{l:Tr Main_CancelButton}"
                            Width="120"
                            Command="{Binding Routing.CancelSectionCommand}" />
                    <Button Classes="accent" Content="{l:Tr Main_SaveButton}"
                            Width="120" Padding="6"
                            Command="{Binding Routing.SaveSectionCommand}"
                            IsVisible="{Binding Routing.ShowSaveButton}"
                            IsEnabled="{Binding Routing.CanSave}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <!-- Static footer shared by the editable sections: a saved change that needs a reconnect takes the
                 strip the Save bar just left, offering the reconnect in place of Save / Cancel. -->
            <Border IsVisible="{Binding ShowReconnectBar}"
                    Background="{DynamicResource AgPanelBrush}" BorderBrush="{DynamicResource AgBorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,13,13" MinHeight="52" Padding="18,7">
              <!-- Compact drops the reconnect actions under the prompt so they never overlap it. -->
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            Grid.ColumnSpan="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=span2}">
                  <Ellipse Width="8" Height="8" Fill="{DynamicResource AgWarnBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{l:Tr Main_ReconnectPrompt}" Classes="muted" FontSize="12"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Grid.Row="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=row}"
                            Grid.Column="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=col}">
                  <Button Classes="methodpick" Content="{l:Tr Main_ReconnectLaterButton}"
                          Width="120"
                          Command="{Binding DismissReconnectCommand}" />
                  <Button Classes="accent" Content="{l:Tr Main_ReconnectApplyButton}"
                          Width="120" Padding="6"
                          Command="{Binding Home.ReconnectCommand}" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Floating notification toasts (reconnect notice, app update); shown over home and settings. -->
    <StackPanel ZIndex="50" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="12,24,12,0" MaxWidth="560" Spacing="6">

      <Border IsVisible="{Binding Home.NoticeVisible}"
              Background="{DynamicResource AgAccentBrush}"
              CornerRadius="8" Padding="12,7" BoxShadow="0 6 18 0 #2A000000">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <Ellipse Grid.Column="0" Width="8" Height="8" Fill="White" VerticalAlignment="Top" Margin="0,5,9,0" />
          <TextBlock Grid.Column="1" Text="{Binding Home.NoticeText}" Foreground="White"
                     FontSize="12" FontWeight="SemiBold"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="radiopick" Command="{Binding Home.ReconnectCommand}"
                  Content="{Binding Home.NoticeActionText}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                  Margin="10,0,0,0" VerticalAlignment="Center" IsVisible="{Binding Home.ReconnectAvailable}" />
          <Button Grid.Column="3" Classes="radiopick" Command="{Binding Home.DismissNoticeCommand}"
                  Content="✕" Foreground="White" FontSize="12" Margin="9,0,0,0"
                  VerticalAlignment="Top" ToolTip.Tip="{l:Tr Main_CloseTooltip}"
                  IsVisible="{Binding Home.CanDismissNotice}" />
        </Grid>
      </Border>

      <Border IsVisible="{Binding AppUpdateBannerVisible}"
              Background="{DynamicResource AgAccentBrush}"
              CornerRadius="8" Padding="12,7" BoxShadow="0 6 18 0 #2A000000">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <Ellipse Grid.Column="0" Width="8" Height="8" Fill="White" VerticalAlignment="Top" Margin="0,5,9,0" />
          <TextBlock Grid.Column="1" Text="{Binding General.UpdateBannerText}"
                     Foreground="White" FontSize="12" FontWeight="SemiBold"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                      Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding General.UpdateDownloadPercent, StringFormat='{}{0}%'}" Foreground="White"
                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                       Width="36" TextAlignment="Right"
                       IsVisible="{Binding General.DownloadActive}" />
            <Button Classes="radiopick" Command="{Binding General.DownloadUpdateCommand}"
                    Content="{l:Tr Main_DownloadButton}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                    VerticalAlignment="Center" IsVisible="{Binding General.ShowDownloadButton}" />
            <Button Classes="radiopick" Command="{Binding General.CancelDownloadCommand}"
                    Content="{l:Tr Main_CancelButton}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                    VerticalAlignment="Center" IsVisible="{Binding General.DownloadActive}" />
            <Button Classes="radiopick" Command="{Binding General.ApplyUpdateCommand}"
                    Content="{l:Tr Main_InstallButton}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                    VerticalAlignment="Center" IsVisible="{Binding General.UpdateDownloaded}" />
          </StackPanel>
          <Button Grid.Column="3" Classes="radiopick" Command="{Binding General.DismissUpdateBannerCommand}"
                  Content="✕" Foreground="White" FontSize="12" Margin="6,0,0,0"
                  VerticalAlignment="Top" ToolTip.Tip="{l:Tr Main_CloseTooltip}" />
        </Grid>
      </Border>

    </StackPanel>

    <!-- Delete asked over the whole screen: the wide card's menu opens it, the narrow card keeps its own pair
         under the swipe. -->
    <Panel ZIndex="60" Background="#66000000" IsVisible="{Binding ShowDeleteAsk}">
      <Border Classes="dialogcard" Width="430" Padding="22,20"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="13">
          <Panel Width="46" Height="46" HorizontalAlignment="Left">
            <Ellipse Fill="{DynamicResource AgDownBrush}" Opacity="0.15" />
            <Path Data="{DynamicResource AgTrashGeometry}" Width="21" Height="21" Stretch="Uniform"
                  Stroke="{DynamicResource AgDownBrush}" StrokeThickness="1.7"
                  StrokeLineCap="Round" StrokeJoin="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>
          <TextBlock Text="{l:Tr Main_DeleteServerTitle}" FontSize="18" FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <!-- The runs stand tight against each other: a line break between them prints as a space. -->
          <TextBlock FontSize="13" TextWrapping="Wrap"
                     Foreground="{DynamicResource AgMutedBrush}"><Run Text="{Binding DeleteAskPrefix}" /><Run Text="{Binding DeleteAskName}" FontWeight="SemiBold" /><Run Text="{Binding DeleteAskSuffix}" /></TextBlock>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button x:Name="DeleteAskCancel" Classes="outline" Content="{l:Tr Main_CancelButton}"
                    Width="124" Padding="6,9" Command="{Binding CancelDeleteAskCommand}" />
            <Button Classes="dropfill" Content="{l:Tr Main_ConfirmDeleteButton}"
                    Width="124" Padding="6,9" Command="{Binding ConfirmDeleteAskCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

    <!-- Способы «Добавить» / «Экспорт» на телефоне: шторка снизу поверх всего экрана. На десктопе тот же набор
         выпадает из кнопки списком, и эта шторка не открывается. -->
    <Panel ZIndex="70" Background="#66000000" IsVisible="{Binding Sheet.IsOpen}"
           PointerPressed="OnSheetScrimPressed">
      <Border Classes="dialogcard" CornerRadius="20" Margin="10" Padding="16,8,16,18"
              MaxWidth="520" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
              DataContext="{Binding Sheet}" x:DataType="vm:ActionSheetViewModel">
        <StackPanel Spacing="10">
          <Border Width="38" Height="4" CornerRadius="2" HorizontalAlignment="Center"
                  Background="{DynamicResource AgBorder2Brush}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="icon" Command="{Binding CloseCommand}"
                    ToolTip.Tip="{l:Tr Main_CloseTooltip}">
              <PathIcon Data="{StaticResource AgCloseGeometry}" Width="13" Height="13" />
            </Button>
          </Grid>
          <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Margin="0,-6,0,2" />
          <ItemsControl x:Name="SheetOptions" ItemsSource="{Binding Options}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ActionOption">
                <Button Classes="sheetrow" Margin="0,3"
                        Command="{Binding $parent[ItemsControl].((vm:ActionSheetViewModel)DataContext).PickCommand}"
                        CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0" Data="{Binding Icon}" Width="16" Height="16"
                              Foreground="{DynamicResource AgAccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}" Margin="10,0" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <PathIcon Grid.Column="2" Data="{StaticResource AgChevronGeometry}" Width="12" Height="12"
                              Foreground="{DynamicResource AgMutedBrush}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Panel>

  </Grid>
</UserControl>
