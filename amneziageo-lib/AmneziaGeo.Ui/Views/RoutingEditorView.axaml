<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             x:Class="AmneziaGeo.Ui.Views.RoutingEditorView"
             x:CompileBindings="True"
             x:DataType="vm:RoutingViewModel">
  <!-- Shared rule + traffic editor, bound to RoutingEditor / RoutingSettings; used by both the Settings and
       Import sections. -->
  <StackPanel Spacing="14">

    <!-- Rules card: name + per-app tunneling + geo/domain/cidr entries. -->
    <Border BorderBrush="{DynamicResource AgBorderBrush}" BorderThickness="1"
            CornerRadius="12" Padding="16" Background="Transparent">
      <StackPanel Spacing="14" DataContext="{Binding RoutingEditor}" x:DataType="vm:RoutingListEditorViewModel">
        <!-- Card title. The global-proxy switch lives in the traffic card below as a full-width setting row. -->
        <TextBlock Text="{l:Tr Main_RoutingListCardTitle}" FontWeight="SemiBold" FontSize="15"
                   TextWrapping="Wrap" VerticalAlignment="Center" />

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLoading}">
          <PathIcon Classes.spin="{Binding IsLoading}" Data="{DynamicResource AgRefreshGeometry}"
                    Width="14" Height="14" Foreground="{DynamicResource AgMutedBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{l:Tr Main_RoutingLoading}" Classes="muted" FontSize="12.5" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Spacing="2">
          <TextBlock Classes="label" Text="{l:Tr Main_ListNameLabel}" />
          <TextBox Classes="field" Classes.invalid="{Binding IsNameMissing}"
                   Text="{Binding Name, Mode=TwoWay}" Watermark="{l:Tr Main_ListNameWatermark}" />
          <TextBlock Classes="fieldwarn" IsVisible="{Binding IsNameMissing}"
                     Text="{l:Tr Main_RequiredEmptyWarning}" />
        </StackPanel>

        <!-- Add an entry by address (geo / domain / cidr) or per-application. Content-width when wide,
             full-width in compact. -->
        <StackPanel Spacing="6">

          <controls:SegmentedSelector Label="{l:Tr Main_AddMethodLabel}"
              Command="{Binding SelectAddMethodCommand}"
              IsCompact="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact}"
              Item1Text="{l:Tr Main_AddByAddressTab}" Item1Param="address" Item1Active="{Binding IsAddressMethod}"
              Item2Text="{l:Tr Main_AddByAppTab}" Item2Param="app" Item2Active="{Binding IsAppMethod}" />

          <!-- Address entry: geo category / domain / cidr. -->
          <StackPanel Spacing="6" Margin="0,4,0,0" IsVisible="{Binding IsAddressMethod}">
            <TextBlock Classes="label" Text="{l:Tr Main_AddEntryLabel}" />
            <Grid ColumnDefinitions="*,Auto">
              <AutoCompleteBox Grid.Column="0" Classes="field" Margin="0,0,8,0"
                               Watermark="{l:Tr Main_AddEntryWatermark}"
                               Text="{Binding RuleInput, Mode=TwoWay}"
                               ItemsSource="{Binding GeoSuggestions}"
                               FilterMode="ContainsOrdinal" MaxDropDownHeight="220" />
              <Button Grid.Column="1" Classes="accent" Width="130" Command="{Binding AddRuleCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="+" />
                  <TextBlock Text="{l:Tr Main_AddButton}" />
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>

          <!-- Per-application entry. -->
          <StackPanel Spacing="8" Margin="0,4,0,0" IsVisible="{Binding IsAppMethod}">
            <TextBlock Classes="label" Text="{l:Tr Main_PerAppRoutingLabel}" />

            <!-- Wide: source picker, app input, and add button inline. -->
            <Grid ColumnDefinitions="Auto,*,Auto"
                  IsVisible="{Binding !$parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact}">
              <Button Grid.Column="0" Classes="softbtn" Width="130" Margin="0,0,8,0" Content="{l:Tr Main_SourceDropdown}">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="{l:Tr Main_AppSourceRunning}" Click="OnAppSourceRunning" />
                    <MenuItem Header="{l:Tr Main_AppSourceInstalled}" Click="OnAppSourceInstalled" />
                    <MenuItem Header="{l:Tr Main_AppSourceFolder}" Click="OnAppSourceFolder" />
                    <MenuItem Header="{l:Tr Main_AppSourceFile}" Click="OnAppSourceFile" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <AutoCompleteBox Grid.Column="1" Classes="field" Margin="0,0,8,0"
                               Watermark="{Binding AppWatermark}"
                               Text="{Binding AppInput, Mode=TwoWay}"
                               SelectedItem="{Binding AppSelected, Mode=TwoWay}"
                               ItemsSource="{Binding AppSuggestions}"
                               FilterMode="ContainsOrdinal" MaxDropDownHeight="220"
                               IsEnabled="{Binding IsAppPickerActive}" />
              <Button Grid.Column="2" Classes="accent" Width="130" Command="{Binding AddAppCommand}"
                      IsEnabled="{Binding IsAppPickerActive}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="+" />
                  <TextBlock Text="{l:Tr Main_AddButton}" />
                </StackPanel>
              </Button>
            </Grid>

            <!-- Compact: source picker and add button split the row evenly; app input drops to its own row. -->
            <StackPanel Spacing="8"
                        IsVisible="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact}">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Classes="softbtn" HorizontalAlignment="Stretch" Content="{l:Tr Main_SourceDropdown}">
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem Header="{l:Tr Main_AppSourceRunning}" Click="OnAppSourceRunning" />
                      <MenuItem Header="{l:Tr Main_AppSourceInstalled}" Click="OnAppSourceInstalled" />
                      <MenuItem Header="{l:Tr Main_AppSourceFolder}" Click="OnAppSourceFolder" />
                      <MenuItem Header="{l:Tr Main_AppSourceFile}" Click="OnAppSourceFile" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
                <Button Grid.Column="1" Classes="accent" HorizontalAlignment="Stretch" Command="{Binding AddAppCommand}"
                        IsEnabled="{Binding IsAppPickerActive}">
                  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="+" />
                    <TextBlock Text="{l:Tr Main_AddButton}" />
                  </StackPanel>
                </Button>
              </Grid>
              <AutoCompleteBox Classes="field"
                               Watermark="{Binding AppWatermark}"
                               Text="{Binding AppInput, Mode=TwoWay}"
                               SelectedItem="{Binding AppSelected, Mode=TwoWay}"
                               ItemsSource="{Binding AppSuggestions}"
                               FilterMode="ContainsOrdinal" MaxDropDownHeight="220"
                               IsEnabled="{Binding IsAppPickerActive}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <!-- Required-field validation, red; clears on any edit (#2/#3). -->
        <TextBlock Text="{Binding ValidationMessage}" Classes="fieldwarn" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Role segment [Прокси | Директ | Блок]: which bucket the add rows target and the list below shows. -->
        <StackPanel Spacing="6">
          <controls:SegmentedSelector Label="{l:Tr Main_RoleLabel}"
              Command="{Binding SelectRoleCommand}"
              IsCompact="{Binding $parent[UserControl].((vm:RoutingViewModel)DataContext).IsCompact}"
              Item1Text="{l:Tr Main_RoleProxy}" Item1Param="proxy" Item1Active="{Binding IsProxyRole}"
              Item2Text="{l:Tr Main_RoleDirect}" Item2Param="direct" Item2Active="{Binding IsDirectRole}"
              Item3Text="{l:Tr Main_RoleBlock}" Item3Param="block" Item3Active="{Binding IsBlockRole}" />
          <!-- Role hint left; a blue link (Direct only) fills the Direct bucket with the machine's local subnets. -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding RoleHint}" Classes="muted" FontSize="11.5"
                       TextWrapping="Wrap" VerticalAlignment="Top" />
            <Button Grid.Column="1" Classes="linkbtn" IsVisible="{Binding IsDirectRole}" Margin="12,0,0,0"
                    Command="{Binding AddLocalSubnetsCommand}" IsEnabled="{Binding !IsBusy}"
                    VerticalAlignment="Top" HorizontalAlignment="Right">
              <TextBlock Text="{l:Tr Main_AddLocalSubnetsButton}" FontSize="11.5" TextWrapping="Wrap" />
            </Button>
          </Grid>
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding Rules.Count}">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <TextBlock Grid.Column="0" Classes="label" Text="{l:Tr Main_EntriesLabel}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="icon" Content="⇅" FontSize="13" Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding SortRulesCommand}"
                    ToolTip.Tip="{l:Tr Main_SortRulesTooltip}" />
            <Button Grid.Column="3" Command="{Binding ClearRulesCommand}"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    Cursor="Hand" VerticalAlignment="Center" HorizontalAlignment="Right"
                    ToolTip.Tip="{l:Tr Main_ClearRulesTooltip}">
              <TextBlock Text="{l:Tr Main_ClearButton}" FontSize="11.5"
                         Foreground="{DynamicResource AgAccentBrush}" />
            </Button>
          </Grid>
          <Border BorderBrush="{DynamicResource AgBorderBrush}" BorderThickness="1"
                  Background="{DynamicResource AgPanelBrush}" CornerRadius="10">
            <ItemsControl ItemsSource="{Binding Rules}" Margin="8,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Background="{DynamicResource AgInsetBrush}"
                          BorderBrush="{DynamicResource AgBorderBrush}" BorderThickness="1"
                          CornerRadius="8" Padding="10,7" Margin="0,3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding}" Classes="mono" FontSize="12.5"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="1" Classes="icon" Content="✕"
                              Command="{Binding $parent[ItemsControl].((vm:RoutingListEditorViewModel)DataContext).RemoveRuleCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Per-routing traffic card: all-UDP + IPv6. -->
    <Border BorderBrush="{DynamicResource AgBorderBrush}" BorderThickness="1"
            CornerRadius="12" Padding="16" Background="Transparent"
            IsVisible="{Binding RoutingSettings, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="14" DataContext="{Binding RoutingSettings}" x:DataType="vm:RoutingSettingsViewModel">
        <TextBlock Text="{l:Tr Main_RoutingOptionsLabel}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />

        <controls:SettingSwitchRow Label="{l:Tr Main_GlobalProxyTitle}" Description="{l:Tr Main_GlobalProxyHint}"
                                   IsChecked="{Binding UseGlobalProxy, Mode=TwoWay}" />

        <controls:SettingSwitchRow Label="{l:Tr Main_AllUdpTitle}" Description="{l:Tr Main_AllUdpHint}"
                                   IsChecked="{Binding AllUdp, Mode=TwoWay}" />

        <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
