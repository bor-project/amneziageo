<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:views="clr-namespace:AmneziaGeo.Ui.Views"
             xmlns:svc="clr-namespace:AmneziaGeo.Ui.Services"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             x:Class="AmneziaGeo.Ui.Views.ProfileView"
             x:CompileBindings="True"
             x:DataType="vm:ProfileViewModel">
  <!-- Cards stretch the full pane width. -->
  <StackPanel Spacing="14">

    <!-- Section tabs + profile picker. HeaderReflow keeps them side by side while they fit and drops the picker
         to its own row when the pane is too narrow (or compact). The caption floats above the combo. -->
    <Grid x:Name="HeaderGrid" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" Margin="0,12,0,0">
      <!-- Section menu: Settings / Import / Export. -->
      <controls:SegmentedSelector x:Name="HeaderTabs" Grid.Row="0" Grid.Column="0"
                            Grid.ColumnSpan="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=span2}"
                            Command="{Binding SelectProfileSectionCommand}" IsCompact="{Binding IsCompact}"
                            Item1Text="{l:Tr Main_SettingsTab}" Item1Param="profile" Item1Active="{Binding SegProfileActive}"
                            Item2Text="{l:Tr Main_ImportTab}" Item2Param="import" Item2Active="{Binding SegImportActive}"
                            Item3Text="{l:Tr Main_ExportTab}" Item3Param="export" Item3Active="{Binding SegExportActive}" />

      <!-- Profile picker: combo to set up, centred against the tabs. The «Make active» link floats in the gap
           below via a render transform, so it never lifts the combo off-centre. Shown only on the Profile section. -->
      <Panel x:Name="PickerHost" Grid.Row="0" Grid.Column="1" ClipToBounds="False"
             VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="260"
             IsVisible="{Binding IsSectionProfile}">
        <Panel IsVisible="{Binding HasConfigs}">
          <!-- Floating caption above the combo (zero layout height) so the combo stays centred against the tabs. -->
          <TextBlock x:Name="PickerLabelFloat" Classes="muted" FontSize="11.5" Text="{l:Tr Main_ProfileLabel}"
                     VerticalAlignment="Top" HorizontalAlignment="Left">
            <TextBlock.RenderTransform>
              <TranslateTransform Y="-18" />
            </TextBlock.RenderTransform>
          </TextBlock>
          <StackPanel Spacing="6">
            <!-- Inline caption when the combo drops to its own row. -->
            <TextBlock x:Name="PickerLabelInline" Classes="muted" FontSize="11.5" Text="{l:Tr Main_ProfileLabel}" IsVisible="False" />
            <controls:AdaptiveComboBox x:Name="Picker" Classes="field" HorizontalAlignment="Stretch" Width="160"
                      ItemsSource="{Binding ProfileOptions}"
                      SelectedItem="{Binding OpenProfileChoice, Mode=TwoWay}">
              <controls:AdaptiveComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileChoice">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </controls:AdaptiveComboBox.ItemTemplate>
            </controls:AdaptiveComboBox>
          </StackPanel>
        </Panel>
        <!-- Make-active link (link style like «Add local networks»); pushed into the gap below the combo with a
             render transform so it consumes no layout height. The command disables it when already active. -->
        <Button Classes="linkbtn" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                IsVisible="{Binding HasConfigs}"
                Command="{Binding SetActiveProfileCommand}" Content="{l:Tr Main_SetActiveProfile}">
          <Button.RenderTransform>
            <TranslateTransform Y="20" />
          </Button.RenderTransform>
        </Button>
      </Panel>
    </Grid>

    <!-- Divider between the header (tabs + picker) and the content. Extra top gap clears the «Установить»
         link that floats below the combo. -->
    <Border Height="1" Background="{DynamicResource AgBorderBrush}" Margin="0,12,0,0" />

    <!-- PROFILE SECTION: catalogue + open-profile editor. -->
    <StackPanel IsVisible="{Binding IsSectionProfile}" Spacing="14">

      <!-- Нет конфигураций: профиль создать нельзя - CTA в конфигурации-импорт. -->
      <StackPanel IsVisible="{Binding !HasConfigs}" HorizontalAlignment="Center" Spacing="10"
                  Margin="0,24,0,8" MaxWidth="360">
        <Button Classes="accent" HorizontalAlignment="Center" Padding="20,7"
                Command="{Binding AddConfigurationCommand}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="+" />
            <TextBlock Text="{l:Tr Main_AddConfigButton}" />
          </StackPanel>
        </Button>
        <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center"
                   Text="{l:Tr Main_ProfileNeedsConfigHint}" />
      </StackPanel>

      <!-- Есть конфигурация, но профиль не выбран / отсутствует: CTA на создание профиля (тот же обработчик,
           что «Новый»), в том же месте и стиле, что и CTA добавления конфигурации. -->
      <StackPanel IsVisible="{Binding ShowAddProfileCta}" HorizontalAlignment="Center" Spacing="10"
                  Margin="0,24,0,8" MaxWidth="360">
        <Button Classes="accent" HorizontalAlignment="Center" Padding="20,7"
                Command="{Binding CreateProfileCommand}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="+" />
            <TextBlock Text="{l:Tr Main_AddProfileButton}" />
          </StackPanel>
        </Button>
        <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center"
                   Text="{l:Tr Main_NoProfileYetHint}" />
      </StackPanel>

      <!-- Open profile's editor. Rename / config / routing picks are committed together by the footer Save. -->
      <StackPanel IsVisible="{Binding IsProfileDetail}" Spacing="14">

        <!-- Settings card: name + config picker + routing picker. Committed with the footer Save (#28/#143). -->
        <Border BorderBrush="{DynamicResource AgBorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="16" Background="Transparent">
          <StackPanel Spacing="14">
            <TextBlock Text="{l:Tr Main_ProfileSettingsTitle}" FontWeight="SemiBold" FontSize="15" />

            <!-- Rename. -->
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="{l:Tr Main_NameLabel}" />
              <TextBlock Classes="muted" FontSize="11.5" TextWrapping="Wrap"
                         Text="{l:Tr Main_ProfileRenameHint}" />
              <TextBox Classes="field" Classes.invalid="{Binding ProfileNameMissing}"
                       Text="{Binding ProfileRename, Mode=TwoWay}" />
              <TextBlock Classes="fieldwarn" IsVisible="{Binding ProfileNameMissing}"
                         Text="{l:Tr Main_RequiredEmptyWarning}" />
              <TextBlock Text="{Binding ProfileRenameStatus}" Classes="fieldwarn" FontSize="11" TextWrapping="Wrap"
                         IsVisible="{Binding ProfileRenameStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <!-- Config + routing pickers for the open profile. -->
            <StackPanel DataContext="{Binding OpenProfile}" x:DataType="vm:ProfileItemViewModel" Spacing="14">

              <!-- Config picker: «- не выбрано -» then saved configs. -->
              <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="{l:Tr Main_ConfigLabel}" />
                <controls:AdaptiveComboBox Classes="field" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding ConfigOptions}"
                          SelectedItem="{Binding SelectedConfig, Mode=TwoWay}">
                  <!-- «- не выбрано -» недоступно: конфигурация у профиля обязательна. -->
                  <controls:AdaptiveComboBox.Styles>
                    <Style Selector="ComboBoxItem" x:DataType="vm:ConfigChoice">
                      <Setter Property="IsEnabled" Value="{Binding IsReal}" />
                    </Style>
                  </controls:AdaptiveComboBox.Styles>
                  <controls:AdaptiveComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConfigChoice">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </controls:AdaptiveComboBox.ItemTemplate>
                </controls:AdaptiveComboBox>
                <TextBlock IsVisible="{Binding !HasConfig}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="{l:Tr Main_ProfileNoConfigHint}" />
              </StackPanel>

              <!-- Routing picker: None means «Полный туннель». -->
              <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="{l:Tr Main_RoutingLabel}" />
                <controls:AdaptiveComboBox Classes="field" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding RoutingListOptions}"
                          SelectedItem="{Binding SelectedRoutingList, Mode=TwoWay}">
                  <controls:AdaptiveComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:RoutingListChoice">
                      <!-- Relabel the "none" sentinel as «Полный туннель». -->
                      <Panel>
                        <TextBlock Text="{l:Tr Main_FullTunnel}" IsVisible="{Binding IsNone}" />
                        <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsNone}" />
                      </Panel>
                    </DataTemplate>
                  </controls:AdaptiveComboBox.ItemTemplate>
                </controls:AdaptiveComboBox>
              </StackPanel>

              <!-- Agent rejection from the footer Save (config/routing commit), so it is not silently lost (#143). -->
              <TextBlock Text="{Binding EditStatus}" Classes="fieldwarn" FontSize="11" TextWrapping="Wrap"
                         IsVisible="{Binding EditStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Delete card: description left, delete trigger right. When armed, the trigger is replaced in place by
             the Confirm/Cancel pair sharing its footprint - one per column, each stretched (#4). -->
        <Border Background="Transparent"
                BorderBrush="{DynamicResource AgBorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="16">
          <StackPanel Spacing="10">
            <!-- Compact stacks the trigger under the description; wide keeps them side by side. -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
              <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0"
                          Grid.ColumnSpan="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=span2}">
                <TextBlock Text="{l:Tr Main_DeleteProfileTitle}" FontWeight="SemiBold" FontSize="13.5" />
                <TextBlock Text="{l:Tr Main_DeleteProfilePrompt}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="11.5" TextWrapping="Wrap" Text="{l:Tr Main_DeleteProfileHint}" />
              </StackPanel>
              <Grid VerticalAlignment="Center"
                    Grid.Row="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=row}"
                    Grid.Column="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=col}"
                    Width="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w180}"
                    ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.ColumnSpan="2" Classes="danger" HorizontalAlignment="Stretch"
                        Content="{l:Tr Main_DeleteProfileButton}"
                        IsVisible="{Binding !ProfileDeletePending}"
                        Command="{Binding RequestDeleteOpenProfileCommand}" />
                <Button Grid.Column="0" Classes="danger" HorizontalAlignment="Stretch"
                        Content="{l:Tr Main_ConfirmDeleteButton}"
                        IsVisible="{Binding ProfileDeletePending}"
                        Command="{Binding ConfirmDeleteOpenProfileCommand}" />
                <Button Grid.Column="1" Classes="softbtn" HorizontalAlignment="Stretch"
                        Content="{l:Tr Main_CancelButton}"
                        IsVisible="{Binding ProfileDeletePending}"
                        Command="{Binding CancelDeleteProfileCommand}" />
              </Grid>
            </Grid>
            <TextBlock Text="{Binding ProfileDeleteStatus}" Classes="fieldwarn" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding ProfileDeleteStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>

    <!-- IMPORT SECTION: reused bundle import, with «Новый» profile injected into its action row. -->
    <StackPanel IsVisible="{Binding IsSectionImport}" Spacing="14">
      <views:BundleImportView DataContext="{Binding BundleImport}">
        <!-- Создание пустого профиля: та же строка кнопок, что «Выбрать файл» / «Импортировать», равный размер.
             Команда живёт на ProfileViewModel, поэтому тянем её через предка. -->
        <views:BundleImportView.LeadingAction>
          <Button Classes="accent" Width="180" Margin="0,0,8,8" x:CompileBindings="False"
                  DataContext="{Binding $parent[views:ProfileView].DataContext}"
                  IsVisible="{Binding HasConfigs}" Command="{Binding CreateProfileCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="+" />
              <TextBlock Text="{l:Tr Main_ProfileAddButton}" />
            </StackPanel>
          </Button>
        </views:BundleImportView.LeadingAction>
      </views:BundleImportView>
    </StackPanel>

    <!-- EXPORT SECTION: reused bundle export. -->
    <StackPanel IsVisible="{Binding IsSectionExport}">
      <views:BundleExportView DataContext="{Binding BundleExport}" />
    </StackPanel>

  </StackPanel>
</UserControl>
