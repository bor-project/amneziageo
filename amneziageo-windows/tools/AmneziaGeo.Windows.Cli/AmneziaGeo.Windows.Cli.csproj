<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>amneziageo</AssemblyName>
    <RootNamespace>AmneziaGeo.Windows.Cli</RootNamespace>
    <!-- Named cultures resolve the ru resources the agent answers with. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\amneziageo-lib\AmneziaGeo.Cli\AmneziaGeo.Cli.csproj" />
    <ProjectReference Include="..\..\..\amneziageo-lib\AmneziaGeo.Decl\AmneziaGeo.Decl.csproj" />
    <ProjectReference Include="..\..\..\amneziageo-lib\AmneziaGeo.Ipc\AmneziaGeo.Ipc.csproj" />
    <ProjectReference Include="..\..\..\amneziageo-lib\AmneziaGeo.Localization\AmneziaGeo.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatform">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
