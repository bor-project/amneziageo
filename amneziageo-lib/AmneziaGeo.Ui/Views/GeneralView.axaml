<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AmneziaGeo.Ui.Controls"
             xmlns:vm="clr-namespace:AmneziaGeo.Ui.ViewModels"
             xmlns:views="clr-namespace:AmneziaGeo.Ui.Views"
             xmlns:svc="clr-namespace:AmneziaGeo.Ui.Services"
             xmlns:l="clr-namespace:AmneziaGeo.Ui.Localization"
             x:Class="AmneziaGeo.Ui.Views.GeneralView"
             x:CompileBindings="True"
             x:DataType="vm:GeneralViewModel">
   <UserControl.Resources>
     <StreamGeometry x:Key="AgBackGeometry">M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20z</StreamGeometry>
     <StreamGeometry x:Key="AgDownloadGeometry">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</StreamGeometry>
     <StreamGeometry x:Key="AgUploadGeometry">M9 16h6v-6h4l-7-7-7 7h4v6zm-4 2h14v2H5v-2z</StreamGeometry>
     <StreamGeometry x:Key="AgCopyGeometry">M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z</StreamGeometry>
     <StreamGeometry x:Key="AgEyeGeometry">M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z</StreamGeometry>
     <StreamGeometry x:Key="AgEyeOffGeometry">M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z</StreamGeometry>
     <StreamGeometry x:Key="AgCloseGeometry">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
   </UserControl.Resources>
   <Panel>

     <!-- MAIN general page. -->
     <StackPanel IsVisible="{Binding IsGeneralMain}" Spacing="14">
       <TextBlock Classes="section" Text="{l:Tr General_Section}" />

       <!-- One frame around the whole settings block; below the card width it goes and the hairlines carry the boundaries. -->
       <Border Classes="sect">
         <StackPanel Spacing="14">

           <!-- Appearance: theme + language (live switch). -->
           <StackPanel Spacing="12">
             <TextBlock Text="{l:Tr Main_AppearanceTitle}" FontWeight="SemiBold" FontSize="15" />

             <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="12">
               <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Tr General_Theme}" FontSize="13.5" VerticalAlignment="Center" />
               <controls:AdaptiveComboBox Grid.Row="0" Grid.Column="1" Classes="field" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                         ItemsSource="{Binding Themes}"
                         SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}" />
               <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Tr General_Language}" FontSize="13.5" VerticalAlignment="Center" />
               <controls:AdaptiveComboBox Grid.Row="1" Grid.Column="1" Classes="field" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                         ItemsSource="{Binding Languages}"
                         SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}" />
             </Grid>
           </StackPanel>

           <!-- About: versions + app self-update. -->
           <StackPanel Spacing="12">
             <!-- Narrow screen: a hairline carries the boundary the card frame used to. -->
             <Border Classes="hairline" />
             <TextBlock Text="{l:Tr About_Section}" FontWeight="SemiBold" FontSize="15" />

             <!-- Each value stands under its label, left-aligned. -->
             <StackPanel Spacing="2">
               <TextBlock Text="{l:Tr About_Version}" FontSize="13.5" />
               <TextBlock Text="{Binding AppVersion}" Classes="muted mono" FontSize="12.5"
                          HorizontalAlignment="Left" TextWrapping="Wrap" />
             </StackPanel>

             <StackPanel Spacing="2">
               <TextBlock Text="{l:Tr Main_AmneziaEngineVersion}" FontSize="13.5" />
               <TextBlock Text="{Binding AmneziaVersion}" Classes="muted mono" FontSize="12.5"
                          HorizontalAlignment="Left" TextWrapping="Wrap" />
             </StackPanel>

             <StackPanel Spacing="2" IsVisible="{Binding HasBuildType}">
               <TextBlock Text="{l:Tr About_BuildType}" FontSize="13.5" />
               <TextBlock Text="{Binding BuildType}" Classes="muted mono" FontSize="12.5"
                          HorizontalAlignment="Left" TextWrapping="Wrap" />
             </StackPanel>

             <StackPanel Spacing="2">
               <TextBlock Text="{l:Tr About_Source}" FontSize="13.5" />
               <!-- The link keeps the padding that carries the focus ring, and a margin of the same size puts
                    its text under the label. -->
               <Button Classes="linkbtn" FontSize="12.5" HorizontalAlignment="Left" Margin="-7,0,0,0"
                       Click="OnOpenProjectPage">
                 <TextBlock Text="{Binding ProjectUrl}" TextWrapping="Wrap" />
               </Button>
             </StackPanel>

             <!-- Update sub-block: found -> downloading -> downloaded; installing is an explicit second click (#154). -->
             <StackPanel Spacing="9" IsVisible="{Binding HasUpdateUrl}">
               <Border BorderBrush="{DynamicResource AgBorderBrush}" BorderThickness="0,1,0,0" Margin="0,2,0,0" />
               <TextBlock Text="{l:Tr Main_UpdateSection}" FontWeight="SemiBold" FontSize="13.5" />
               <!-- Тумблер стоит в строке подписи: отдельная строка под ней стоила экрана на телефоне. -->
               <controls:SettingSwitchRow Label="{l:Tr General_AllowPrerelease}"
                                          Description="{l:Tr General_AllowPrereleaseHint}"
                                          IsChecked="{Binding AllowPrerelease, Mode=TwoWay}" />
               <TextBlock Text="{Binding UpdateVersionBadgeText}" FontSize="13" FontWeight="SemiBold"
                          IsVisible="{Binding UpdateAvailable}" />
               <!-- The buttons stand under the status line. -->
               <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="8">
                 <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Spacing="2">
                   <TextBlock Text="{Binding UpdateStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                              IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                   <TextBlock Text="{Binding UpdateDescription}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                              IsVisible="{Binding UpdateAvailable}" />
                 </StackPanel>
                 <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8"
                             VerticalAlignment="Center">
                   <Button Classes="softbtn" Content="{l:Tr Main_CheckUpdatesButton}" Command="{Binding CheckUpdateCommand}"
                           IsVisible="{Binding ShowCheckUpdateButton}" />
                   <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding UpdateAvailable}">
                     <TextBlock Text="{Binding UpdateDownloadPercent, StringFormat='{}{0}%'}" Classes="muted"
                                FontSize="12" VerticalAlignment="Center" Width="36" TextAlignment="Right"
                                IsVisible="{Binding DownloadActive}" />
                     <Button Classes="accent" Content="{l:Tr Main_DownloadButton}" Command="{Binding DownloadUpdateCommand}"
                             IsVisible="{Binding ShowDownloadButton}" />
                     <Button Classes="softbtn" Content="{l:Tr Main_CancelButton}" Command="{Binding CancelDownloadCommand}"
                             IsVisible="{Binding DownloadActive}" />
                     <Button Classes="accent" Content="{l:Tr Main_InstallButton}" Command="{Binding ApplyUpdateCommand}"
                             IsVisible="{Binding UpdateDownloaded}" IsEnabled="{Binding !UpdateInstalling}" />
                   </StackPanel>
                 </StackPanel>
               </Grid>
             </StackPanel>
           </StackPanel>

           <!-- Narrow screen: a hairline carries the boundary the card frame used to. -->
           <Border Classes="hairline" />

           <!-- Local proxy: the port other applications and devices point at (#238). -->
           <StackPanel Spacing="12">
             <TextBlock Text="{l:Tr General_ProxySection}" FontWeight="SemiBold" FontSize="15" />

             <StackPanel Spacing="4">
               <controls:SettingSwitchRow Label="{l:Tr General_ProxyEnabled}" Description="{Binding ProxyEnabledHint}"
                                          IsChecked="{Binding ProxyEnabled, Mode=TwoWay}" />
               <TextBlock Text="{l:Tr General_ProxyTunnelHint}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"
                          IsVisible="{Binding ProxyNeedsTunnel}" />
             </StackPanel>

             <TextBlock Text="{Binding ProxyErrorText}" Classes="mono" FontSize="12.5" TextWrapping="Wrap"
                        Foreground="{DynamicResource AgWarnBrush}"
                        IsVisible="{Binding ProxyErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

             <StackPanel Spacing="12" IsVisible="{Binding ProxyEnabled}">
               <!-- Every address a client can be pointed at, each one copyable; the tunnel's own address is not
                    among them - a neighbour told to use it reaches nobody. -->
               <ItemsControl ItemsSource="{Binding ProxyEndpoints}">
                 <ItemsControl.ItemTemplate>
                   <DataTemplate x:DataType="vm:ProxyEndpointRow">
                     <Grid ColumnDefinitions="62,*,Auto" Margin="0,1">
                       <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="muted" FontSize="12"
                                  VerticalAlignment="Center" />
                       <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="12.5"
                                  VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                       <Button Grid.Column="2" Classes="icon" VerticalAlignment="Center"
                               Click="OnCopyProxyEndpoint" ToolTip.Tip="{l:Tr General_ProxyCopyTooltip}">
                         <PathIcon Data="{StaticResource AgCopyGeometry}" Width="13" Height="13" />
                       </Button>
                     </Grid>
                   </DataTemplate>
                 </ItemsControl.ItemTemplate>
               </ItemsControl>

               <!-- Each port box stands under its label, left-aligned. -->
               <StackPanel Spacing="6">
                 <TextBlock Text="{l:Tr General_ProxySocksPort}" FontSize="13.5" />
                 <TextBox Classes="field" Width="110" HorizontalAlignment="Left"
                          Text="{Binding ProxySocksPort, Mode=TwoWay}" />
               </StackPanel>

               <StackPanel Spacing="6">
                 <TextBlock Text="{l:Tr General_ProxyHttpPort}" FontSize="13.5" />
                 <TextBox Classes="field" Width="110" HorizontalAlignment="Left"
                          Text="{Binding ProxyHttpPort, Mode=TwoWay}" />
               </StackPanel>

               <!-- Clients: the count first, and who holds them under the arrow. -->
               <StackPanel Spacing="6">
                 <Grid ColumnDefinitions="Auto,Auto,*">
                   <TextBlock Grid.Column="0" Text="{l:Tr General_ProxyClients}" FontSize="13.5" VerticalAlignment="Center" />
                   <Border Grid.Column="1" Background="{DynamicResource AgInsetBrush}" CornerRadius="20"
                           Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center">
                     <TextBlock Text="{Binding ProxyClientCount}" FontSize="11" Classes="muted" FontWeight="SemiBold" />
                   </Border>
                   <Button Grid.Column="2" Classes="icon" HorizontalAlignment="Left" Margin="2,0,0,0"
                           VerticalAlignment="Center" IsVisible="{Binding HasProxyClients}"
                           Command="{Binding ToggleProxyClientsCommand}" ToolTip.Tip="{l:Tr General_ProxyClientsTooltip}">
                     <TextBlock Text="{Binding ProxyClientsGlyph}" RenderTransform="scale(1.5)" />
                   </Button>
                 </Grid>
                 <TextBlock Text="{l:Tr General_ProxyNoClients}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                            IsVisible="{Binding !HasProxyClients}" />
                 <Border IsVisible="{Binding IsProxyClientsExpanded}" Padding="10,7"
                         Background="{DynamicResource AgInsetBrush}" BorderBrush="{DynamicResource AgBorderBrush}"
                         BorderThickness="1" CornerRadius="8">
                   <ItemsControl ItemsSource="{Binding ProxyClients}">
                     <ItemsControl.ItemTemplate>
                       <DataTemplate x:DataType="vm:ProxyClientRow">
                         <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                           <TextBlock Grid.Column="0" Text="{Binding Address}" Classes="mono" FontSize="12.5"
                                      VerticalAlignment="Center" />
                           <TextBlock Grid.Column="1" Text="{Binding Detail}" Classes="muted" FontSize="12"
                                      Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                         </Grid>
                       </DataTemplate>
                     </ItemsControl.ItemTemplate>
                   </ItemsControl>
                 </Border>
               </StackPanel>

               <!-- Who is let in: the accounts below, and on top of them a client without one where it is allowed. -->
               <controls:SettingSwitchRow Label="{l:Tr General_ProxyAnonymous}"
                                          Description="{l:Tr General_ProxyAnonymousHint}"
                                          IsChecked="{Binding ProxyAnonymous, Mode=TwoWay}" />

               <TextBlock Text="{l:Tr General_ProxyOpenWarning}" FontSize="12" TextWrapping="Wrap"
                          Foreground="{DynamicResource AgWarnBrush}" IsVisible="{Binding ProxyAnonymous}" />
               <TextBlock Text="{l:Tr General_ProxyNoAccountWarning}" FontSize="12" TextWrapping="Wrap"
                          Foreground="{DynamicResource AgWarnBrush}" IsVisible="{Binding ProxyAdmitsNobody}" />

               <!-- Accounts: a client sends one of these pairs, and the password shows only when it is asked for. -->
               <StackPanel Spacing="6">
                 <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                   <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                     <TextBlock Text="{l:Tr General_ProxyAccounts}" FontSize="13.5" />
                     <TextBlock Text="{l:Tr General_ProxyAuthHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                   </StackPanel>
                   <Button Grid.Column="1" Classes="softbtn" VerticalAlignment="Center"
                           Command="{Binding AddProxyAccountCommand}">
                     <StackPanel Orientation="Horizontal" Spacing="4">
                       <TextBlock Text="+" />
                       <TextBlock Text="{l:Tr Main_AddButton}" />
                     </StackPanel>
                   </Button>
                 </Grid>
                 <ItemsControl ItemsSource="{Binding ProxyAccounts}">
                   <ItemsControl.ItemTemplate>
                     <DataTemplate x:DataType="vm:ProxyAccountViewModel">
                       <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="6" Margin="0,2">
                         <TextBox Grid.Column="0" Classes="field" Text="{Binding User, Mode=TwoWay}"
                                  Watermark="{l:Tr General_ProxyUser}" />
                         <TextBox Grid.Column="1" Classes="field" Text="{Binding Password, Mode=TwoWay}"
                                  PasswordChar="●" RevealPassword="{Binding IsRevealed}"
                                  Watermark="{l:Tr General_ProxyPassword}" />
                         <Button Grid.Column="2" Classes="icon" VerticalAlignment="Center"
                                 Command="{Binding ToggleRevealCommand}" ToolTip.Tip="{l:Tr General_ProxyRevealTooltip}">
                           <Panel>
                             <PathIcon Data="{StaticResource AgEyeGeometry}" Width="14" Height="14"
                                       IsVisible="{Binding !IsRevealed}" />
                             <PathIcon Data="{StaticResource AgEyeOffGeometry}" Width="14" Height="14"
                                       IsVisible="{Binding IsRevealed}" />
                           </Panel>
                         </Button>
                         <Button Grid.Column="3" Classes="icon" VerticalAlignment="Center"
                                 Command="{Binding $parent[ItemsControl].((vm:GeneralViewModel)DataContext).RemoveProxyAccountCommand}"
                                 CommandParameter="{Binding}">
                           <PathIcon Data="{StaticResource AgCloseGeometry}" Width="14" Height="14" />
                         </Button>
                       </Grid>
                     </DataTemplate>
                   </ItemsControl.ItemTemplate>
                 </ItemsControl>
               </StackPanel>
             </StackPanel>
           </StackPanel>

           <Border Height="1" Background="{DynamicResource AgBorderBrush}" IsVisible="{Binding ShowConnectionDivider}" />

           <!-- Connection resilience: survive reboot + periodic auto-reconnect (#196, #199). Windows only:
                the Android agent does not apply these settings. -->
           <StackPanel Spacing="12" IsVisible="{Binding CanConfigureConnection}">
             <TextBlock Text="{l:Tr General_ConnectionSection}" FontWeight="SemiBold" FontSize="15" />

             <controls:SettingSwitchRow Label="{l:Tr General_ShowNotifications}"
                                        Description="{l:Tr General_ShowNotificationsHint}"
                                        IsChecked="{Binding ShowNotifications, Mode=TwoWay}" />

             <controls:SettingSwitchRow Label="{l:Tr General_SurviveReboot}"
                                        Description="{l:Tr General_SurviveRebootHint}"
                                        IsChecked="{Binding SurviveReboot, Mode=TwoWay}" />

             <controls:SettingSwitchRow Label="{l:Tr General_PeriodicReconnect}"
                                        Description="{l:Tr General_PeriodicReconnectHint}"
                                        IsChecked="{Binding PeriodicReconnect, Mode=TwoWay}" />

             <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"
                   IsEnabled="{Binding PeriodicReconnectIntervalEnabled}">
               <TextBlock Grid.Column="0" Text="{l:Tr General_ReconnectInterval}" FontSize="13.5" VerticalAlignment="Center" />
               <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                 <TextBox Classes="field" Width="92" VerticalAlignment="Center"
                          controls:NumericInput.Minimum="1" controls:NumericInput.Maximum="86400"
                          Text="{Binding ReconnectIntervalSeconds, Mode=TwoWay}" />
                 <TextBlock Text="{l:Tr General_Seconds}" Classes="muted" FontSize="12.5" VerticalAlignment="Center" />
               </StackPanel>
             </Grid>
           </StackPanel>

           <Border Height="1" Background="{DynamicResource AgBorderBrush}" IsVisible="{Binding ShowRepairDivider}" />

           <!-- Network repair: elevated one-shot that clears a leftover DNS redirect so the internet works
                again after a failed connect or a removal stranded the resolver. Windows only. -->
           <!-- The button stands under the hint. -->
           <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10"
                 IsVisible="{Binding CanRepairNetwork}">
             <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6" VerticalAlignment="Center">
               <TextBlock Text="{l:Tr General_NetworkRepairSection}" FontWeight="SemiBold" FontSize="15" />
               <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" Text="{l:Tr General_NetworkRepairHint}" />
               <TextBlock Text="{Binding NetworkRepairStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                          IsVisible="{Binding NetworkRepairStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
             </StackPanel>
             <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                         HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
               <Button Classes="softbtn" Padding="16,7" HorizontalAlignment="Stretch"
                       Command="{Binding RepairNetworkCommand}" Content="{l:Tr General_NetworkRepairButton}" />
             </StackPanel>
           </Grid>

           <Border Classes="hairline" />

           <!-- Import / export (full width): hint left, actions right. Opens the bundle sub-views inline. -->
           <!-- The export / import buttons stand under the hint. -->
           <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10">
             <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6" VerticalAlignment="Center">
               <TextBlock Text="{l:Tr Main_ImportExportSection}" FontWeight="SemiBold" FontSize="15" />
               <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" Text="{l:Tr Main_BundleHint}" />
             </StackPanel>
             <!-- Compact splits export / import evenly across the row; wide keeps them at their own width. -->
             <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,*" ColumnSpacing="8" VerticalAlignment="Center"
                   HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
               <Button Grid.Column="0" Classes="softbtn" Padding="16,7" HorizontalAlignment="Stretch"
                       Width="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w130}"
                       Command="{Binding OpenBundleExportCommand}">
                 <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                   <PathIcon Data="{StaticResource AgDownloadGeometry}" Width="15" Height="15" />
                   <TextBlock Text="{l:Tr Main_ExportButton}" />
                 </StackPanel>
               </Button>
               <Button Grid.Column="1" Classes="softbtn" Padding="16,7" HorizontalAlignment="Stretch"
                       Width="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=w130}"
                       Command="{Binding OpenBundleImportCommand}">
                 <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                   <PathIcon Data="{StaticResource AgUploadGeometry}" Width="15" Height="15" />
                   <TextBlock Text="{l:Tr Main_ImportButton}" />
                 </StackPanel>
               </Button>
             </Grid>
           </Grid>

           <Border Classes="hairline" />

           <!-- Diagnostics archive: what support asks for. The agent builds the zip under its own account and
                names it here; the button then saves a copy where the user picks. -->
           <!-- The button stands under the hint. -->
           <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10">
             <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6" VerticalAlignment="Center">
               <TextBlock Text="{l:Tr General_DiagnosticsSection}" FontWeight="SemiBold" FontSize="15" />
               <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" Text="{l:Tr General_DiagnosticsHint}" />
               <TextBlock Text="{Binding DiagnosticsStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                          IsVisible="{Binding DiagnosticsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
             </StackPanel>
             <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                         HorizontalAlignment="{Binding IsCompact, Converter={x:Static svc:CompactConverter.Instance}, ConverterParameter=stretchL}">
               <Button Classes="softbtn" Padding="16,7" HorizontalAlignment="Stretch"
                       IsEnabled="{Binding !DiagnosticsRunning}" Click="OnCollectDiagnostics">
                 <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                   <PathIcon Data="{StaticResource AgDownloadGeometry}" Width="15" Height="15" />
                   <TextBlock Text="{l:Tr General_DiagnosticsButton}" />
                 </StackPanel>
               </Button>
             </StackPanel>
           </Grid>

         </StackPanel>
       </Border>
     </StackPanel>

     <!-- BUNDLE EXPORT sub-view. -->
     <StackPanel IsVisible="{Binding IsBundleExport}" Spacing="14">
       <StackPanel Orientation="Horizontal" Spacing="8">
         <Button Classes="icon" Padding="6,4" Command="{Binding CloseBundleCommand}">
           <PathIcon Data="{StaticResource AgBackGeometry}" Width="18" Height="18" Foreground="{DynamicResource AgMutedBrush}" />
         </Button>
         <TextBlock Classes="section" Text="{l:Tr BundleExport_WindowTitle}" VerticalAlignment="Center" />
       </StackPanel>
       <views:BundleExportView DataContext="{Binding BundleExport}" />
     </StackPanel>

     <!-- BUNDLE IMPORT sub-view. -->
     <StackPanel IsVisible="{Binding IsBundleImport}" Spacing="14">
       <StackPanel Orientation="Horizontal" Spacing="8">
         <Button Classes="icon" Padding="6,4" Command="{Binding CloseBundleCommand}">
           <PathIcon Data="{StaticResource AgBackGeometry}" Width="18" Height="18" Foreground="{DynamicResource AgMutedBrush}" />
         </Button>
         <TextBlock Classes="section" Text="{l:Tr BundleImport_WindowTitle}" VerticalAlignment="Center" />
       </StackPanel>
       <views:BundleImportView DataContext="{Binding BundleImport}" />
     </StackPanel>

   </Panel>
</UserControl>
